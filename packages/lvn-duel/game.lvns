scene duel-game

include "duel.lvns"

// ═══════════════════════════════════════════════════════════════════
// ТРОПА — маленькая игра вокруг дуэли
// ═══════════════════════════════════════════════════════════════════
// Бой сам по себе — не игра: в него не за чем возвращаться. Игру делает
// ПЕТЛЯ: утро, выбор дела, риск, добыча, покупка, снова утро. Здесь она
// умещается в один экран меню.
//
// ПЕТЛЯ РОГАЛИКА. День — это заход: тропа из нескольких врагов, здоровье
// между боями НЕ восстанавливается. Смерть возвращает в то же утро и
// забирает золото и здоровье, но НЕ забирает умения: владение навыками и
// аурами переживает смерть. Тело сгорает, руки помнят — на этом держится
// желание зайти ещё раз, потому что второй заход объективно легче первого.
//
// ЧТО ГДЕ ЖИВЁТ:
//   день, золото, хп        — сгорают со смертью (кроме дня, он растёт)
//   влад_*, влад_аур,
//   навык, аура_*_откр      — остаются навсегда: это и есть прогресс
//   знание                  — что ты видел в чужой песне, тоже остаётся
//
// СЕТЕВОЙ БОЙ стоит в том же меню и ничем не отличается для игрока: та же
// механика, тот же экран, только напротив живой человек. Умения в него
// переносятся — то, что купил у торговца, работает и там.

// ── что не сбрасывается никогда ─────────────────────────────────────
навык = ""
влад_оглушение = 0
влад_пробив = 0
пустая_таблица = {}
влад_аур = пустая_таблица
знание = пустая_таблица
аура_меч_откр = 0
аура_кровь_откр = 0
аура_призрак_откр = 0
аура_сила_откр = 0
аура_жизнь_откр = 0
аура_воля_откр = 0
аура_отчаяние_откр = 0
прозвище = ""
всего_побед = 0
сетевых_побед = 0
сетевых_поражений = 0

тест_режим = 0
день = 0
дуэль_сеть = 0
сеть_обмен = 0

// Песни врагов. Новый враг = новый список, и ничего больше.
песня_костяк = list("удар")
песня_щит = list("блок", "блок", "удар")
песня_лютый = list("удар", "удар", "блок")
песня_ярость = list("удар")

// Фон берём тот, что в пакете ЕСТЬ. Движок молча пропускает картинку,
// которой нет: экран просто остаётся чёрным, и понять причину по виду
// нельзя — поэтому путь сверен с содержимым пакета, а не написан по памяти.
bg sprite_url="/content/packages/lvn-duel/assets/ui/bg_yard.png"

-> новый_день

// ═══════════════════════════════════════════════════════════════════
//  УТРО — единственный перекрёсток игры
// ═══════════════════════════════════════════════════════════════════
:новый_день
день = день + 1
золото = 0
дуэль_хп = 6
дуэль_хп_макс = 6
шаг_тропы = 0
-> утро

:утро
дуэль_сеть = 0
Утро. День {день}.
Сердец {дуэль_хп} из {дуэль_хп_макс}. Золота {золото}.
- Выйти на тропу -> тропа
- Торговец -> лавка
- Сетевой бой -> сеть_меню
- Что я умею -> умения
- Отдохнуть до утра -> новый_день

:умения
Пробив: владение {влад_пробив}%. Оглушение: владение {влад_оглушение}%.
Побед всего: {всего_побед}. В сети: {сетевых_побед} — {сетевых_поражений}.
-> утро

// ═══════════════════════════════════════════════════════════════════
//  ТРОПА — три врага подряд, здоровье не восстанавливается
// ═══════════════════════════════════════════════════════════════════
// Порядок не «сложнее по очереди», а «каждый отнимает привычку»: Костяк
// учит азбуке, Щитоносец отнимает «просто бей», Лютый отнимает
// «отсидеться в блоке».
:тропа
if шаг_тропы == 0 -> враг_костяк
if шаг_тропы == 1 -> враг_щит
if шаг_тропы == 2 -> враг_лютый
Тропа кончилась. Дальше — туман, и туда ты пока не ходишь.
-> утро

:враг_костяк
враг_имя = "КОСТЯК"
враг_хп = 6
враг_хп_макс = 6
враг_паттерн = песня_костяк
враг_паттерн2 = песня_ярость
враг_окраска = ""
враг_аура_вид = ""
враг_даль = 0
враг_рост = 2.2
Ржавый доспех, ни щита, ни хитрости.
Костяк: Бью да закрываюсь. Ты и этого пока не умеешь.
duel()
-> итог_боя

:враг_щит
враг_имя = "ЩИТОНОСЕЦ"
враг_хп = 8
враг_хп_макс = 8
враг_паттерн = песня_щит
враг_паттерн2 = песня_ярость
враг_окраска = "щит"
враг_аура_вид = ""
враг_даль = 0
враг_рост = 2.2
Щитоносец: За щитом меня не достать. Бей сколько хочешь — только темп мне подаришь.
duel()
-> итог_боя

:враг_лютый
враг_имя = "ЛЮТЫЙ"
враг_хп = 9
враг_хп_макс = 9
враг_паттерн = песня_лютый
враг_паттерн2 = песня_ярость
враг_окраска = "лютый"
враг_аура_вид = ""
враг_даль = 0
враг_рост = 2.3
Лютый: Отсидеться не выйдет. На твоём блоке я только злее.
duel()
-> итог_боя

:итог_боя
if дуэль_исход == "пал" -> смерть
if дуэль_исход == "затянулась" -> утро
// Награда растёт по тропе: третий враг опаснее первого, и платить за него
// столько же значило бы предлагать игроку не рисковать.
всего_побед = всего_побед + 1
шаг_тропы = шаг_тропы + 1
добыча = 10 + шаг_тропы * 6
золото = золото + добыча
Он осыпался. В поясе нашлось {добыча} золота — всего {золото}.
-> утро

:смерть
Тропа забрала тебя. Золото осталось в траве.
Но руки помнят: всё, чему ты научился, при тебе.
-> новый_день

// ═══════════════════════════════════════════════════════════════════
//  ТОРГОВЕЦ — единственное место, где золото превращается в умение
// ═══════════════════════════════════════════════════════════════════
:лавка
Торговец: Золота у тебя {золото}. Показывай, чего не хватает.
- Подлечиться — 8 за сердце -> лечение
- Навыки -> навыки_лавка
- Ауры -> ауры_лавка
- Прозвище — 20 -> прозвище_лавка
- Уйти -> утро

:лечение
if золото < 8 -> нет_золота
if дуэль_хп >= дуэль_хп_макс -> целый
золото = золото - 8
дуэль_хп = дуэль_хп + 1
Стало легче. Сердец {дуэль_хп} из {дуэль_хп_макс}, золота {золото}.
-> лавка

:целый
Торговец: На тебе ни царапины. Побереги деньги.
-> лавка

:навыки_лавка
Торговец: Навык занимает такт очереди, как удар. Зато меняет правила.
- Пробив — 40 -> купить_пробив
- Оглушение — 40 -> купить_оглушение
- Поднять владение — 30 -> поднять_владение
- Назад -> лавка

:купить_пробив
if золото < 40 -> нет_золота
золото = золото - 40
навык = "пробив"
if влад_пробив < 25 { влад_пробив = 25 }
Торговец: Пробив проходит сквозь щит. Владение {влад_пробив}%.
-> лавка

:купить_оглушение
if золото < 40 -> нет_золота
золото = золото - 40
навык = "оглушение"
if влад_оглушение < 25 { влад_оглушение = 25 }
Торговец: Оглушённый пропускает такт. Владение {влад_оглушение}%.
-> лавка

:поднять_владение
if золото < 30 -> нет_золота
if навык == "" -> нет_навыка
золото = золото - 30
if навык == "пробив" { влад_пробив = min(влад_пробив + 25, 100) }
if навык == "оглушение" { влад_оглушение = min(влад_оглушение + 25, 100) }
Торговец: Рука твёрже. Ступень выросла.
-> лавка

:нет_навыка
Торговец: Сначала купи хоть что-нибудь, потом точи.
-> лавка

// Ауры — вторая линия действий: они не бьют, а копят свет и разряжаются.
// Каждая открывается отдельно, потому что открытая аура добавляет кнопку.
:ауры_лавка
Торговец: Ауры не бьют. Они копят свет и меняют, чем становится твой удар.
- Меч — 50 -> купить_меч
- Кровь — 50 -> купить_кровь
- Воля — 60 -> купить_воля
- Отчаяние — 70 -> купить_отчаяние
- Назад -> лавка

:купить_меч
if золото < 50 -> нет_золота
золото = золото - 50
аура_меч_откр = 1
Торговец: Меч запомнил свет.
-> лавка

:купить_кровь
if золото < 50 -> нет_золота
золото = золото - 50
аура_кровь_откр = 1
Торговец: Теперь чужая рана кормит тебя.
-> лавка

:купить_воля
if золото < 60 -> нет_золота
золото = золото - 60
аура_воля_откр = 1
Торговец: Воля держит, когда держаться нечем.
-> лавка

:купить_отчаяние
if золото < 70 -> нет_золота
золото = золото - 70
аура_отчаяние_откр = 1
Торговец: Отчаяние — плохой советчик и хорошее оружие.
-> лавка

// Прозвище ничего не даёт в бою — и в этом смысл. Единственное, что оно
// делает, ВИДНО ДРУГОМУ: в сетевом бою соперник читает его вместо
// безличного «СОПЕРНИК».
:прозвище_лавка
if золото < 20 -> нет_золота
золото = золото - 20
input var=прозвище prompt="Как тебя звать на тропе?" max=16
Торговец: Теперь тебя зовут {прозвище}. В драке не поможет, зато запомнят.
-> лавка

:нет_золота
Торговец: Столько у тебя нет. Тропа рядом.
-> лавка

// ═══════════════════════════════════════════════════════════════════
//  СЕТЕВОЙ БОЙ — тот же бой, только напротив живой
// ═══════════════════════════════════════════════════════════════════
// Умения переносятся: купленное у торговца работает и здесь. А вот
// здоровье берётся полное у обоих — сетевая партия не должна зависеть от
// того, кто сколько прошёл по своей тропе сегодня.
:сеть_меню
Напротив будет живой. Он тоже выбирает вслепую.
- Создать комнату -> сеть_создать
- Войти по коду -> сеть_войти
- Назад -> утро

:сеть_создать
ext net_open
if net_error != "" -> сеть_беда
Комната открыта. Код: {net_code}
Продиктуй его партнёру.
ext net_wait need=2
if net_error != "" -> сеть_беда
-> сеть_знакомство

:сеть_войти
input var=введённый_код prompt="Код комнаты" max=6
ext net_join code_var=введённый_код
if net_error != "" -> сеть_беда
-> сеть_знакомство

// Обмен прозвищами — заодно проверка связи до первого хода. reveal=now:
// имя соперника незачем скрывать, и увидеть его нужно сразу.
:сеть_знакомство
// ОБЩИЙ ПОТОК СЛУЧАЙНОСТИ — один раз на партию, до первого броска.
// Дальше rand() и chance() у обоих дают одни и те же числа в одном порядке,
// и случайность в правилах перестаёт разводить клиентов.
ext net_rng
if net_error != "" -> сеть_беда
моё_имя = прозвище
if моё_имя == "" { моё_имя = "БЕЗЫМЯННЫЙ" }
ext net_put key="имя" value_var=моё_имя reveal=now
ext net_get key="имя" into=чужое_имя one=1
имя_соперника = get(чужое_имя, 0, "СОПЕРНИК")
Напротив садится {имя_соперника}.
-> сеть_бой

:сеть_бой
дуэль_сеть = 1
сеть_обмен = 0
дуэль_хп = 6
дуэль_хп_макс = 6
враг_хп = 6
враг_хп_макс = 6
враг_имя = имя_соперника
// Песня не нужна — ходы приходят от человека, — но длину списка читают
// в других местах, и пустой дал бы деление на ноль.
враг_паттерн = песня_костяк
враг_паттерн2 = песня_ярость
враг_окраска = ""
враг_аура_вид = ""
враг_даль = 0
враг_рост = 2.2
duel()
ext net_leave
if дуэль_исход == "победа" -> сеть_взял
if дуэль_исход == "пал" -> сеть_пал
Ни один не дожал.
-> утро

:сеть_взял
сетевых_побед = сетевых_побед + 1
{имя_соперника} опустил руки первым. Счёт {сетевых_побед} — {сетевых_поражений}.
-> утро

:сеть_пал
сетевых_поражений = сетевых_поражений + 1
{имя_соперника} дочитал тебя раньше. Счёт {сетевых_побед} — {сетевых_поражений}.
-> утро

:сеть_беда
Не вышло: {net_error}.
-> сеть_меню

// Контракт пакета: кнопка «заново» внутри боя прыгает СЮДА. Пакет не знает,
// что для этой игры значит «заново», и знать не должен.
:дуэль_рестарт
ext net_leave
-> утро
