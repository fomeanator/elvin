// HUD владения навыком — рисуется один раз, проценты и ступень реактивны
// ═══════════════════════════════════════════════════════════════════
//  3b. АРСЕНАЛ СТОРОН — иконки под полосами
// ═══════════════════════════════════════════════════════════════════
// Игрок должен видеть, ЧЕМ противник вообще умеет драться, иначе первый бой
// с новым врагом — угадывание вслепую (тычок подсказывает лишь один такт).
// Слева — арсенал скелета, справа — твой; открытый навык добавляется в ряд
// и несёт СВОЙ процент владения прямо на иконке.

func arsenal_show() {
  // враг: чем он оперирует
  obj id=foe_ars1 sprite_url="/content/packages/lvn-duel/ui/icon_strike.png" x=0.155 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  obj id=foe_ars2 sprite_url="/content/packages/lvn-duel/ui/icon_block.png" x=0.225 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  // герой: база всегда, навык — по открытию
  obj id=hero_ars1 sprite_url="/content/packages/lvn-duel/ui/icon_strike.png" x=0.595 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  obj id=hero_ars2 sprite_url="/content/packages/lvn-duel/ui/icon_block.png" x=0.665 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  if навык == "оглушение" -> арс_огл
  if навык == "пробив" -> арс_проб
  obj id=hero_ars3 show=false
  text hero_ars3_pct hide
  -> арс_готово
  :арс_огл
  obj id=hero_ars3 sprite_url="/content/packages/lvn-duel/ui/icon_stun.png" x=0.735 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  // процент владения — НА иконке, а не отдельной строкой сбоку
  text hero_ars3_pct x=73.5 y=94.8 size=15 color=#ffffff anchor="0.5,0" «{влад_оглушение}%»
  -> арс_готово
  :арс_проб
  obj id=hero_ars3 sprite_url="/content/packages/lvn-duel/ui/icon_break.png" x=0.735 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  text hero_ars3_pct x=73.5 y=94.8 size=15 color=#ffffff anchor="0.5,0" «{влад_пробив}%»
  -> арс_готово
  :арс_готово
}

func arsenal_hide() {
  obj id=foe_ars1 show=false
  obj id=foe_ars2 show=false
  obj id=hero_ars1 show=false
  obj id=hero_ars2 show=false
  obj id=hero_ars3 show=false
  text hero_ars3_pct hide
}

func skill_hud() {
  // Плашка навыка сбоку убрана: процент владения живёт НА иконке в арсенале.
  arsenal_show()
}


// ═══════════════════════════════════════════════════════════════════
//  3a. ПОЛОСКИ ХП — два спрайта (подложка + заливка); ширина заливки
//      ветвится по хп, потому что числовые поля obj — только литералы.
//      Скелет: над головой. Герой: над диалоговым окном.
// ═══════════════════════════════════════════════════════════════════

func duel_hud_plate() {
  obj id=duel_hud_plate sprite_url="/content/packages/lvn-uikit/ui/hud_plate.png" x=50% y=88% width=0.99 height=0.19 anchor="0.5,0.5" z=25
}

func foe_bar() {
  obj id=foe_bar_bg sprite_url="/content/packages/lvn-uikit/ui/bar_track.png" x=0.265 y=0.875 width=0.38 height=0.025 anchor="0.5,0.5" z=30
  // ПРИЗРАК урона (приём из Dota): тот же спрайт, бледнее и ПОД основной
  // заливкой. Едет к той же доле, но втрое дольше — глаз успевает прочитать,
  // сколько именно отняли, даже когда удар прошёл за долю секунды.
  obj id=foe_bar_ghost sprite_url="/content/packages/lvn-uikit/ui/bar_fill_hp.png" x=0.075 y=0.875 width=0.380 height=0.025 anchor="0,0.5" z=30 opacity=0.4 fill_from=left
