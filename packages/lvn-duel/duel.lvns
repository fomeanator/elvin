  obj id=slot2 show=false
  obj id=slot3 show=false
  obj id=slot4 show=false
  obj id=slot5 show=false
}

// HUD владения навыком — рисуется один раз, проценты и ступень реактивны
// ═══════════════════════════════════════════════════════════════════
//  3b. АРСЕНАЛ СТОРОН — иконки под полосами
// ═══════════════════════════════════════════════════════════════════
// Игрок должен видеть, ЧЕМ противник вообще умеет драться, иначе первый бой
// с новым врагом — угадывание вслепую (тычок подсказывает лишь один такт).
// Слева — арсенал скелета, справа — твой; открытый навык добавляется в ряд
// и несёт СВОЙ процент владения прямо на иконке.

func arsenal_show() {
  // враг: чем он оперирует
  obj id=foe_ars1 sprite_url="/content/packages/lvn-duel/ui/icon_strike.png" x=0.155 y=0.232 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  obj id=foe_ars2 sprite_url="/content/packages/lvn-duel/ui/icon_block.png" x=0.225 y=0.232 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  // герой: база всегда, навык — по открытию
  obj id=hero_ars1 sprite_url="/content/packages/lvn-duel/ui/icon_strike.png" x=0.595 y=0.232 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  obj id=hero_ars2 sprite_url="/content/packages/lvn-duel/ui/icon_block.png" x=0.665 y=0.232 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  if навык == "оглушение" -> арс_огл
  if навык == "пробив" -> арс_проб
  obj id=hero_ars3 show=false
  text hero_ars3_pct hide
  -> арс_готово
  :арс_огл
  obj id=hero_ars3 sprite_url="/content/packages/lvn-duel/ui/icon_stun.png" x=0.735 y=0.232 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  // процент владения — НА иконке, а не отдельной строкой сбоку
  text hero_ars3_pct x=73.5 y=24.2 size=15 color=#ffffff anchor="0.5,0" «{влад_оглушение}%»
  -> арс_готово
  :арс_проб
  obj id=hero_ars3 sprite_url="/content/packages/lvn-duel/ui/icon_break.png" x=0.735 y=0.232 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  text hero_ars3_pct x=73.5 y=24.2 size=15 color=#ffffff anchor="0.5,0" «{влад_пробив}%»
  -> арс_готово
  :арс_готово
}

func arsenal_hide() {
  obj id=foe_ars1 show=false
  obj id=foe_ars2 show=false
  obj id=hero_ars1 show=false
  obj id=hero_ars2 show=false
  obj id=hero_ars3 show=false
  text hero_ars3_pct hide
}

func skill_hud() {
  // Плашка навыка сбоку убрана: процент владения живёт НА иконке в арсенале.
  arsenal_show()
}


// ═══════════════════════════════════════════════════════════════════
//  3a. ПОЛОСКИ ХП — два спрайта (подложка + заливка); ширина заливки
//      ветвится по хп, потому что числовые поля obj — только литералы.
//      Скелет: над головой. Герой: над диалоговым окном.
// ═══════════════════════════════════════════════════════════════════

func duel_hud_plate() {
  obj id=duel_hud_plate sprite_url="/content/packages/lvn-uikit/ui/hud_plate.png" x=0.5 y=0.175 width=0.94 height=0.19 anchor="0.5,0.5" z=25
}

func foe_bar() {
  obj id=foe_bar_bg sprite_url="/content/packages/lvn-uikit/ui/bar_track.png" x=0.26 y=0.170 width=0.34 height=0.025 anchor="0.5,0.5" z=30
  // ПРИЗРАК урона (приём из Dota): тот же спрайт, бледнее и ПОД основной
  // заливкой. Едет к той же доле, но втрое дольше — глаз успевает прочитать,
  // сколько именно отняли, даже когда удар прошёл за долю секунды.
  obj id=foe_bar_ghost sprite_url="/content/packages/lvn-uikit/ui/bar_fill_hp.png" x=0.09 y=0.170 width=0.340 height=0.025 anchor="0,0.5" z=30 opacity=0.4 fill_from=left
  obj id=foe_bar_fill sprite_url="/content/packages/lvn-uikit/ui/bar_fill_hp.png" x=0.09 y=0.170 width=0.340 height=0.025 anchor="0,0.5" z=31 fill_from=left
  anim id=foe_bar_fill prop=fill to="{max(враг_хп, 0) / max(враг_хп_макс, 1)}" dur=0.25 ease=outCubic
  anim id=foe_bar_ghost prop=fill to="{max(враг_хп, 0) / max(враг_хп_макс, 1)}" dur=0.9 ease=inOutSine
}

// Заливка врага во всю длину трека — режет её fill, а не ширина.

func hero_bar() {
  obj id=hero_bar_bg sprite_url="/content/packages/lvn-uikit/ui/bar_track.png" x=0.70 y=0.170 width=0.34 height=0.025 anchor="0.5,0.5" z=30
  obj id=hero_bar_ghost sprite_url="/content/packages/lvn-uikit/ui/bar_fill_resource.png" x=0.53 y=0.170 width=0.340 height=0.025 anchor="0,0.5" z=30 opacity=0.4 fill_from=left
  obj id=hero_bar_fill sprite_url="/content/packages/lvn-uikit/ui/bar_fill_resource.png" x=0.53 y=0.170 width=0.340 height=0.025 anchor="0,0.5" z=31 fill_from=left
  anim id=hero_bar_fill prop=fill to="{max(дуэль_хп, 0) / max(дуэль_хп_макс, 1)}" dur=0.25 ease=outCubic
  anim id=hero_bar_ghost prop=fill to="{max(дуэль_хп, 0) / max(дуэль_хп_макс, 1)}" dur=0.9 ease=inOutSine
}

// Заливка героя во всю длину трека — режет её fill.

func bars_hide() {
  obj id=duel_hud_plate show=false
  obj id=foe_bar_bg show=false
  obj id=foe_bar_fill show=false
  obj id=foe_bar_ghost show=false
  obj id=hero_bar_bg show=false
  obj id=hero_bar_fill show=false
  obj id=hero_bar_ghost show=false
}

// ═══════════════════════════════════════════════════════════════════
//  4. ТЫЧОК — подсказка ПЕРВОГО такта грядущего обмена
// ═══════════════════════════════════════════════════════════════════
// Остальные такты — только память игрока. Это и есть раскачка: тело
// сгорает с днём, а выученная песня паттерна остаётся в голове.

// Обмен ВСЕГДА длится 6 секунд: такт = 6с / кол-во тактов (решение
// владельца, 2026-07-31). Обмен 1 — один такт смакуется 6с, кап 5 — по 1.2с.
// wait ms= принимает только литерал, поэтому таблица ветками.

func tell_update() {
  if враг_стан >= 1 -> ты_стан
  if foe_now() == "удар" -> ты_удар
  тычок_текст = "Он вжимается за щит: первым тактом закроется."
  -> ты_готово
  :ты_стан
  тычок_текст = "Он ещё качается после оглушения — первый такт твой."
  -> ты_готово
  :ты_удар
  тычок_текст = "Костяные пальцы сжали рукоять: первым тактом — удар."
  -> ты_готово
  :ты_готово
}

// ═══════════════════════════════════════════════════════════════════
//  5. РАЗРЕШЕНИЕ ОДНОГО ТАКТА
// ═══════════════════════════════════════════════════════════════════
// Входы: мой_ход, его_ход, такт. Выходы: урон_мне, урон_ему, бит_суть,
// правки темпа/стана/владения. Приоритет смертей: враг падает первым
// (удар с темпом уже упорядочен внутри размена, а добить издыхающего —
// победа, не ничья).

func resolve_beat() {
  урон_мне = 0
  урон_ему = 0
  бит_суть = ""
  if его_ход == "стан" -> рт_стан
  if мой_ход == "удар" && его_ход == "удар" -> рт_уу
  if мой_ход == "удар" && его_ход == "блок" -> рт_уб
  if мой_ход == "блок" && его_ход == "удар" -> рт_бу
  if мой_ход == "блок" && его_ход == "блок" -> рт_бб
  if мой_ход == "оглушение" && его_ход == "удар" -> рт_оу
  if мой_ход == "оглушение" && его_ход == "блок" -> рт_об
  if мой_ход == "пробив" && его_ход == "блок" -> рт_пб
  -> рт_пу

  // ── враг оглушён: такт без его действия ──
  :рт_стан
  if мой_ход == "удар" -> рт_стан_удар
  if мой_ход == "пробив" -> рт_стан_пробив
  if мой_ход == "оглушение" -> рт_стан_огл
  бит_суть = "он плывёт — такт впустую."
  -> рт_применить
  :рт_стан_удар
  урон_ему = 2
  бит_суть = "по оглушённому: −2!"
  -> рт_применить
  :рт_стан_пробив
  урон_ему = 2
  влад_пробив = min(влад_пробив + 3, 100)
  hint text="🔨 Пробив +3 — урон по открытому" duration=2
  бит_суть = "пробив по открытому: −2!"
  -> рт_применить
  :рт_стан_огл
  влад_оглушение = min(влад_оглушение + 1, 100)
  hint text="💫 Оглушение +1 — в молоко (он и так оглушён)" duration=2
  бит_суть = "он и так оглушён — мимо."
  -> рт_применить

  // ── удар × удар: размен решает темп ──
  :рт_уу
  if темп_мой > темп_врага -> рт_уу_я
  if темп_врага > темп_мой -> рт_уу_он
  урон_мне = 1
  урон_ему = 1
  бит_суть = "размен: −1 обоим."
  -> рт_применить
  :рт_уу_я
  урон_ему = 2
  темп_мой = 0
  if враг_хп - 2 > 0 {
    урон_мне = 1
    бит_суть = "твой темп: −2 ему, −1 тебе."
  } else {
    бит_суть = "твой темп: добил!"
  }
  -> рт_применить
  :рт_уу_он
  урон_мне = 2
  темп_врага = 0
  if дуэль_хп - 2 > 0 {
    урон_ему = 1
    бит_суть = "его темп: −2 тебе, −1 ему."
  } else {
    бит_суть = "его темп: ты падаешь."
  }
  -> рт_применить

  // ── удар × блок и блок × удар: банк темпа ──
  :рт_уб
  темп_врага = темп_врага + 1
  бит_суть = "в щит: +1 темп ему."
  -> рт_применить
  :рт_бу
  темп_мой = темп_мой + 1
  бит_суть = "блок: +1 темп тебе."
  -> рт_применить
  :рт_бб
  бит_суть = "оба закрылись."
  -> рт_применить

  // ── 💫 оглушение ──
  :рт_оу
  огл_порог = 2
  if влад_оглушение >= 25 {
    огл_порог = 1
  } else {
  }
  if темп_мой >= огл_порог -> рт_оу_есть
  урон_мне = 1
  влад_оглушение = min(влад_оглушение + 1, 100)
  hint text="💫 Оглушение +1 — не хватило темпа" duration=2
  бит_суть = "без темпа: −1 тебе."
  -> рт_применить
  :рт_оу_есть
  темп_мой = темп_мой - огл_порог
  враг_стан = 1
  if влад_оглушение >= 50 {
    враг_стан = 2
  } else {
  }
  влад_оглушение = min(влад_оглушение + 3, 100)
  hint text="💫 Оглушение +3 — сработало!" duration=2
  бит_суть = "оглушил — он теряет такт!"
  -> рт_применить
  :рт_об
  влад_оглушение = min(влад_оглушение + 1, 100)
  hint text="💫 Оглушение +1 — он был за щитом" duration=2
  бит_суть = "в щит — мимо."
  -> рт_применить

  // ── 🔨 пробив ──
  :рт_пб
  урон_ему = 2
  if влад_пробив >= 50 {
    урон_ему = 3
  } else {
  }
  темп_мой = темп_мой + 1
  влад_пробив = min(влад_пробив + 6, 100)
  hint text="🔨 Пробив +6 — КРИТ сквозь щит!" duration=2
  бит_суть = "сквозь щит: −" + урон_ему + ", темп твой!"
  -> рт_применить
  :рт_пу
  урон_мне = 2
  if влад_пробив >= 25 {
    урон_мне = 1
  } else {
  }
  влад_пробив = min(влад_пробив + 1, 100)
  hint text="🔨 Пробив +1 — он не закрывался" duration=2
  бит_суть = "раскрылся: −" + урон_мне + " тебе."
  -> рт_применить

  // ── применение ──
  :рт_применить
  враг_хп = max(враг_хп - урон_ему, 0)
  дуэль_хп = max(дуэль_хп - урон_мне, 0)
  if враг_хп <= 0 {
    дуэль_исход = "победа"
  } else {
  }
  if дуэль_хп <= 0 && дуэль_исход == "" {
    дуэль_исход = "пал"
  } else {
  }
}

// ═══════════════════════════════════════════════════════════════════
//  6. САМА ДУЭЛЬ
// ═══════════════════════════════════════════════════════════════════

func duel() {
  дуэль_исход = ""
  обмен = 0
  темп_мой = 0
  темп_врага = 0
  враг_шаг = 0
  враг_фаза = 1
  враг_стан = 0
  враг_даль = 0
  враг_паттерн = паттерн_обычный
  план = []
  тычок_текст = ""

  duel_hud_plate()
  text dayline x=6 y=10.0 size=17 color=#b59a62 «День {день} · обмен {обмен}»
  // Имя — НАД полосой, цифры — БЕЛЫМ ПОВЕРХ неё (z выше заливки): взгляд
  // читает длину и число в одной точке, не прыгая по плашке.
  text foe_name x=26 y=13.3 size=19 color=#f0765e anchor="0.5,0" «СКЕЛЕТ»
  text hero_name x=70 y=13.3 size=19 color=#73b8ee anchor="0.5,0" «ТЫ»
  text foe_num x=26 y=16.0 size=20 color=#ffffff anchor="0.5,0" «{враг_хп}/{враг_хп_макс}  ⚡{темп_врага}»
  text hero_num x=70 y=16.0 size=20 color=#ffffff anchor="0.5,0" «{дуэль_хп}/{дуэль_хп_макс}  ⚡{темп_мой}»
  text tellline x=50 y=27 size=25 color=#c9b98a anchor="0.5,0" «{тычок_текст}»
  skill_hud()
  arsenal_show()
  foe_bar()
  hero_bar()
  foe_sprite("idle")
  hands("idle")
  -> дт_обмен

  // ── цикл обменов ──
  :дт_обмен
  обмен = обмен + 1
  if обмен > 8 -> дт_ничья
  тактов = min(обмен, 5)
  план = []
  tell_update()
  -> дп_план

  // ── планирование: экран-пауза с кнопками (модель point-and-click) ──
  :дп_план
  slots_draw()
  if len(план) >= тактов -> дп_готово
  buttons_show()
  План: такт {len(план) + 1} из {тактов}.
  -> дп_план

  :дп_удар
  план = push(план, "удар")
  -> дп_план
  :дп_блок
  план = push(план, "блок")
  -> дп_план
  :дп_оглушение
  план = push(план, "оглушение")
  -> дп_план
  :дп_пробив
  план = push(план, "пробив")
  -> дп_план
  :дп_сброс
  план = []
  -> дп_план

  // ── прокрутка очереди ──
  :дп_готово
  buttons_hide()
  тычок_текст = ""
  такт = 0
  while такт < len(план) && дуэль_исход == "" {
    мой_ход = get(план, такт, "блок")
    if враг_стан >= 1 {
      его_ход = "стан"
      враг_стан = враг_стан - 1
    } else {
      его_ход = foe_now()
      враг_шаг = враг_шаг + 1
    }
    resolve_beat()
    foe_bar()
    hero_bar()
    // позы такта: раненый перекрывает атакующего
    поза_врага = "idle"
    if его_ход == "удар" {
      поза_врага = "attack"
    } else {
    }
    if урон_ему > 0 {
      поза_врага = "hurt"
    } else {
    }
    foe_sprite(поза_врага)
    поза_рук = "idle"
    if мой_ход == "блок" {
      поза_рук = "block"
    } else {
      поза_рук = "attack"
    }
    hands(поза_рук)
    if урон_ему > 0 {
      flash color="white" duration=0.25
    } else {
    }
    if урон_мне > 0 {
      camera action=shake amplitude=0.02 duration=0.35
    } else {
    }
    // Строка такта — обычная реплика в диалоговом окне, а не лейбл посреди
    // экрана: у боя и без того плотный кадр, а диалог для текста и сделан.
    // Тап игрока задаёт темп прокрутки, поэтому таймер такта здесь не нужен.
    Такт {такт + 1} · {get(икона, мой_ход, "?")} × {get(икона, его_ход, "?")} — {бит_суть}
    такт = такт + 1
  }
  slots_hide()
  foe_sprite("idle")
  hands("idle")
  if дуэль_исход != "" -> дт_итог

  // ── ярость: вторая строфа паттерна ──
  if враг_фаза == 1 && враг_хп * 2 <= враг_хп_макс -> дт_ярость
  -> дт_сводка
  :дт_ярость
  враг_фаза = 2
  враг_паттерн = паттерн_ярость
  враг_шаг = 0
  foe_sprite("attack")
  flash color="red" duration=0.4
  Скелет ЗВЕРЕЕТ — песня меняется!
  foe_sprite("idle")
  -> дт_сводка

  :дт_сводка
  if обмен == 2 && навык_выбран == 0 -> дт_озарение
  -> дт_обмен

  // ── озарение: развилка навыка (всегда ДВА пути — дерево владельца) ──
  :дт_озарение
  Озарение. Тело удержит только одно движение.
  - 💫 Оглушение: против его удара, за темп {
    навык = "оглушение"
    влад_оглушение = 1
  }
  - 🔨 Пробив: сквозь его блок, риск при промахе {
    навык = "пробив"
    влад_пробив = 1
  }
  навык_выбран = 1
  skill_hud()
  Владение растёт от дела: промах +1, эффект +3, крит +6.
  -> дт_обмен

  // ── затянувшийся бой ──
  :дт_ничья
  дуэль_исход = "затянулась"
  Силы кончились раньше жизней. Вы расходитесь.
  -> дт_итог

  // ── занавес ──
  :дт_итог
  тычок_текст = ""
  text dayline hide
  text foe_num hide
  text hero_num hide
  text tellline hide
  bars_hide()
  arsenal_hide()
  buttons_hide()
  slots_hide()
  if дуэль_исход == "победа" -> ди_жив
  obj id=duel_enemy show=false
  -> ди_готово
  :ди_жив
  // кости остаются лежать до смены сцены — как в EC
  foe_sprite("hurt")
  -> ди_готово
  :ди_готово
  obj id=duel_hands show=false
}
