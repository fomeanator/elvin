  obj id=btn_reset sprite_url="/content/packages/lvn-duel/ui/icon_reset.png" x=0.87 y=57% width=0.075 height=0.045 anchor="0.5,0.5" z=40 on_click="plan_reset"
  // Ауры — ВТОРЫМ рядом: они не заменяют базу, а стоят рядом с ней. База
  // (удар и щит) не отменяется никогда, аура лишь занимает такты очереди —
  // те самые, в которых ты иначе бил бы или закрывался.
  aura_buttons()
}

