  obj id=hero_bar_ghost sprite_url="/content/packages/lvn-uikit/ui/bar_fill_resource.png" x=0.545 y=0.875 width=0.380 height=0.025 anchor="0,0.5" z=30 opacity=0.4 fill_from=left
  obj id=hero_bar_fill sprite_url="/content/packages/lvn-uikit/ui/bar_fill_resource.png" x=0.545 y=0.875 width=0.380 height=0.025 anchor="0,0.5" z=31 fill_from=left
  anim id=hero_bar_fill prop=fill to="{max(duel_hp, 0) / max(duel_hp_max, 1)}" dur=0.25 ease=outCubic
