// ═══════════════════════════════════════════════════════════════════
//  4. ТЫЧОК — подсказка ПЕРВОГО такта грядущего обмена
// ═══════════════════════════════════════════════════════════════════
// Остальные такты — только память игрока. Это и есть раскачка: тело
// сгорает с днём, а выученная песня паттерна остаётся в голове.

// Обмен ВСЕГДА длится 6 секунд: такт = 6с / кол-во тактов (решение
// владельца, 2026-07-31). Обмен 1 — один такт смакуется 6с, кап 5 — по 1.2с.
// wait ms= принимает только литерал, поэтому таблица ветками.

func tell_update() {
  // Если ближайший такт уже открыт в ряду — молчим: подсказка нужна там, где
  // игрок ещё не знает песню, а не поверх собственной же иконки.
  if get(знание, враг_имя + "#" + pat_idx(враг_шаг, len(враг_паттерн)), 0) == 1 -> ты_молчим
  if враг_стан >= 1 -> ты_стан
  if foe_now() == "пробив" -> ты_пробив
  if foe_now() == "удар" -> ты_удар
  тычок_текст = "Он вжимается за щит: первым тактом закроется."
  -> ты_готово
  :ты_стан
  тычок_текст = "Он ещё качается после оглушения — первый такт твой."
  -> ты_готово
  :ты_пробив
  тычок_текст = "Он заносит клинок остриём вниз: первым тактом — ПРОБИВ. Щит не спасёт."
  -> ты_готово
  :ты_удар
  тычок_текст = "Костяные пальцы сжали рукоять: первым тактом — удар."
  -> ты_готово
  :ты_молчим
  тычок_текст = ""
  -> ты_готово
  :ты_готово
}

// ═══════════════════════════════════════════════════════════════════
//  5. РАЗРЕШЕНИЕ ОДНОГО ТАКТА
// ═══════════════════════════════════════════════════════════════════
// Входы: мой_ход, его_ход, такт. Выходы: урон_мне, урон_ему, бит_суть,
// правки темпа/стана/владения. Приоритет смертей: враг падает первым
// (удар с темпом уже упорядочен внутри размена, а добить издыхающего —
// победа, не ничья).

func resolve_beat() {
  урон_мне = 0
  урон_ему = 0
  бит_суть = ""
  if мой_ход == "з_меч" -> рт_заряд
  if мой_ход == "з_кровь" -> рт_заряд
  if мой_ход == "з_призрак" -> рт_заряд
  if мой_ход == "з_сила" -> рт_заряд
  if мой_ход == "з_жизнь" -> рт_заряд
  if мой_ход == "з_воля" -> рт_заряд
  if мой_ход == "з_отчаяние" -> рт_заряд
  if его_ход == "стан" -> рт_стан
  if мой_ход == "удар" && его_ход == "удар" -> рт_уу
  if мой_ход == "удар" && его_ход == "блок" -> рт_уб
  if мой_ход == "блок" && его_ход == "удар" -> рт_бу
  if мой_ход == "блок" && его_ход == "блок" -> рт_бб
  if мой_ход == "оглушение" && его_ход == "удар" -> рт_оу
  if мой_ход == "оглушение" && его_ход == "блок" -> рт_об
  if мой_ход == "пробив" && его_ход == "блок" -> рт_пб
  if его_ход == "пробив" -> рт_егопробив
  -> рт_пу

  // ── ЕГО пробив: то же движение, что и твоё, с той же ценой ──────
  :рт_егопробив
  if мой_ход == "блок" -> рт_ег_блок
  if мой_ход == "оглушение" -> рт_ег_огл
  if мой_ход == "пробив" -> рт_ег_оба
  // против твоего удара он раскрыт — пробив бьёт по щиту, а не по клинку
  урон_ему = 2
  бит_суть = "он раскрылся под пробив: −2 ему."
  -> рт_применить
  :рт_ег_блок
  урон_мне = 2
  бит_суть = "пробил твой щит: −2 тебе!"
  -> рт_применить
  :рт_ег_огл
  if темп_мой >= 1 -> рт_ег_огл_есть
  урон_мне = 2
  влад_оглушение = min(влад_оглушение + 1, 100)
  hint text="Оглушение +1 — не хватило темпа" duration=2
  бит_суть = "темпа нет — пробив прошёл: −2 тебе."
  -> рт_применить
  :рт_ег_огл_есть
  темп_мой = темп_мой - 1
  враг_стан = враг_стан + 1
  влад_оглушение = min(влад_оглушение + 3, 100)
  hint text="Оглушение +3 — сбил пробив!" duration=2
  бит_суть = "сбил его пробив на замахе!"
  -> рт_применить
  :рт_ег_оба
  урон_мне = 2
  урон_ему = 2
  влад_пробив = min(влад_пробив + 3, 100)
  hint text="Пробив +3 — встречный размен" duration=2
  бит_суть = "два пробива в упор: −2 обоим."
  -> рт_применить

  // ── враг оглушён: такт без его действия ──
  :рт_стан
  if мой_ход == "удар" -> рт_стан_удар
  if мой_ход == "пробив" -> рт_стан_пробив
  if мой_ход == "оглушение" -> рт_стан_огл
  бит_суть = "он плывёт — такт впустую."
  -> рт_применить
  :рт_стан_удар
  урон_ему = 2
  бит_суть = "по оглушённому: −2!"
  -> рт_применить
  :рт_стан_пробив
  урон_ему = 2
  влад_пробив = min(влад_пробив + 3, 100)
  hint text="Пробив +3 — урон по открытому" duration=2
  бит_суть = "пробив по открытому: −2!"
  -> рт_применить
  :рт_стан_огл
  влад_оглушение = min(влад_оглушение + 1, 100)
  hint text="Оглушение +1 — в молоко (он и так оглушён)" duration=2
  бит_суть = "он и так оглушён — мимо."
  -> рт_применить

  // ── удар × удар: размен решает темп ──
  :рт_уу
  if темп_мой > темп_врага -> рт_уу_я
  if темп_врага > темп_мой -> рт_уу_он
  урон_мне = 1
  урон_ему = 1
  бит_суть = "размен: −1 обоим."
  -> рт_применить
  :рт_уу_я
  урон_ему = 2
  темп_мой = 0
  if враг_хп - 2 > 0 {
    урон_мне = 1
    бит_суть = "твой темп: −2 ему, −1 тебе."
  } else {
    бит_суть = "твой темп: добил!"
  }
  -> рт_применить
  :рт_уу_он
  урон_мне = 2
  темп_врага = 0
  if дуэль_хп - 2 > 0 {
    урон_ему = 1
    бит_суть = "его темп: −2 тебе, −1 ему."
  } else {
    бит_суть = "его темп: ты падаешь."
  }
  -> рт_применить

  // ── удар × блок и блок × удар: банк темпа ──
  :рт_уб
  темп_врага = темп_врага + 1
  бит_суть = "в щит: +1 темп ему."
  -> рт_применить
  :рт_бу
  темп_мой = темп_мой + 1
  бит_суть = "блок: +1 темп тебе."
  -> рт_применить
  :рт_бб
  бит_суть = "оба закрылись."
  -> рт_применить

  // ── 💫 оглушение ──
  :рт_оу
  огл_порог = 2
  if влад_оглушение >= 25 {
    огл_порог = 1
  } else {
  }
  if темп_мой >= огл_порог -> рт_оу_есть
  урон_мне = 1
  влад_оглушение = min(влад_оглушение + 1, 100)
  hint text="Оглушение +1 — не хватило темпа" duration=2
  бит_суть = "без темпа: −1 тебе."
  -> рт_применить
  :рт_оу_есть
  темп_мой = темп_мой - огл_порог
  враг_стан = 1
  if влад_оглушение >= 50 {
    враг_стан = 2
  } else {
  }
  влад_оглушение = min(влад_оглушение + 3, 100)
  hint text="Оглушение +3 — сработало!" duration=2
  бит_суть = "оглушил — он теряет такт!"
  -> рт_применить
  :рт_об
  влад_оглушение = min(влад_оглушение + 1, 100)
  hint text="Оглушение +1 — он был за щитом" duration=2
  бит_суть = "в щит — мимо."
  -> рт_применить

  // ── 🔨 пробив ──
  :рт_пб
  урон_ему = 2
  if влад_пробив >= 50 {
    урон_ему = 3
  } else {
  }
  темп_мой = темп_мой + 1
  влад_пробив = min(влад_пробив + 6, 100)
  hint text="Пробив +6 — КРИТ сквозь щит!" duration=2
  бит_суть = "сквозь щит: −" + урон_ему + ", темп твой!"
  -> рт_применить
  :рт_пу
  урон_мне = 2
  if влад_пробив >= 25 {
    урон_мне = 1
  } else {
  }
  влад_пробив = min(влад_пробив + 1, 100)
  hint text="Пробив +1 — он не закрывался" duration=2
  бит_суть = "раскрылся: −" + урон_мне + " тебе."
  -> рт_применить

  // ── ЗАРЯДКА АУРЫ: такт, в котором ты СТОИШЬ ОТКРЫТЫМ ───────────
  // Цена честная и в этом весь смысл: пока копишь свет, ты не бьёшь и не
  // закрываешься. Три такта на старте — почти вся очередь раннего боя, и
  // решиться на них можно только зная его песню. С владением цена падает,
  // а на сотне аура горит с первого кадра — но к тому времени и противники
  // выходят со своими.
  :рт_заряд
  if аура_зар_вид != мой_ход -> рз_смена
  -> рз_копим
  :рз_смена
  // Переключился на другую ауру — прежний прогресс сгорел: свет не смешивается.
  аура_зар_вид = мой_ход
  аура_заряд = 0
  -> рз_копим
  :рз_копим
  аура_заряд = аура_заряд + 1
  // Копление — не пустой такт: свет уже собирается на руках, но и виньетка
  // сжимается, напоминая, что защиты сейчас нет.
  sfx id=duel_hands glow=0.5 glow_color=#ffe6a8 rim=0.4 rim_color=#fff0c0 dur=0.8
  fx vignette=0.4 bloom=0.25 dur=0.3
  if аура_заряд >= аура_цена(мой_ход) -> рз_вспышка
  бит_суть = "копишь свет — " + аура_заряд + " из " + аура_цена(мой_ход) + ", ты открыт."
  -> рз_урон
  :рз_вспышка
  аура_вид = мой_ход
  аура_заряд = 0
  аура_рост(мой_ход, 8)
  аура_вспышка()
  -> рз_урон
  // Открыт — значит его удар проходит как по стоячему, а щит его не нужен.
  :рз_урон
  if его_ход == "удар" -> рз_бьёт
  if его_ход == "пробив" -> рз_бьёт
  -> рт_применить
  :рз_бьёт
  урон_мне = 2
  бит_суть = бит_суть + " Он бьёт в открытого: −2."
  -> рт_применить

  // ── АУРА ПРОТИВНИКА ──────────────────────────────────────────────
  // Считается ДО твоих аур: воля защиты должна гасить уже посчитанный чужой
  // свет, а не отменять его задним числом.
  :рт_применить
  // (сила раны считается ниже, после применения урона)
  if враг_аура_вид == "" -> вр_нет
  if аура_вид == "з_воля" -> вр_нет
  if враг_аура_вид == "сила" -> вр_сила
  if враг_аура_вид == "клинок" -> вр_клинок
  if враг_аура_вид == "тень" -> вр_тень
  if враг_аура_вид == "жажда" -> вр_жажда
  if враг_аура_вид == "жизнь" -> вр_жизнь
  if враг_аура_вид == "отчаяние" -> вр_отчаяние
  -> вр_нет
  :вр_сила
  if урон_мне > 0 {
    урон_мне = урон_мне + 2
    бит_суть = бит_суть + " Его сила: +2."
  } else {
  }
  -> вр_нет
  :вр_клинок
  if мой_ход == "блок" {
    урон_мне = max(урон_мне, 1) * 2
    бит_суть = бит_суть + " Его клинок прошёл сквозь щит!"
  } else {
  }
  -> вр_нет
  :вр_тень
  if урон_ему > 0 {
    if враг_тень_зарядов > 0 {
      урон_ему = 0
      враг_тень_зарядов = враг_тень_зарядов - 1
      бит_суть = бит_суть + " Он ушёл в тень (" + враг_тень_зарядов + ")."
    } else {
    }
  } else {
  }
  -> вр_нет
  :вр_жажда
  if урон_мне > 0 {
    враг_хп = min(враг_хп + 1, враг_хп_макс)
    бит_суть = бит_суть + " Твоя кровь легла на него."
  } else {
  }
  -> вр_нет
  :вр_жизнь
  враг_хп = min(враг_хп + 1, враг_хп_макс)
  -> вр_нет
  :вр_отчаяние
  if урон_мне > 0 {
    урон_мне = урон_мне + min(враг_хп_макс - враг_хп, 4)
    бит_суть = бит_суть + " Он тем злее, чем ближе к концу."
  } else {
  }
  -> вр_нет
  :вр_нет
  // ── АУРЫ ─────────────────────────────────────────────────────────
  // Две категории, и это главное решение баланса. ПОСТОЯННЫЕ (сила,
  // живучесть, воля) горят до конца боя, но дают немного — они меняют
  // арифметику, а не исход. РАЗРЯДНЫЕ (клинок, тень, жажда) бьют
  // категориально и гаснут: свет уходит в удар, тень тратится на уклонение.
  // Без этого «клинок» был кнопкой «победить» и обесценивал остальные пять.
  if аура_вид == "з_меч" -> ра_меч
  -> ра_сила
  :ра_меч
  if мой_ход == "удар" -> ра_меч_бьёт
  if мой_ход == "пробив" -> ра_меч_бьёт
  -> ра_сила
  :ра_меч_бьёт
  // УДВОЕНИЕ, а не «+100 урона»: плоская сотня при восьми жизнях означала бы
  // «нажми и выиграй», и остальные пять аур можно было бы выбросить. Процент
  // же растёт вместе с боем — и остаётся значимым, когда цифры вырастут.
  // Сквозь щит проходит даже нулевой урон: аура не бьёт мимо защиты, она её
  // не замечает.
  if урон_ему <= 0 {
    урон_ему = 1
  } else {
  }
  урон_ему = урон_ему * 2
  // Удвоенный удар сквозь защиту — золотой разрез по кадру.
  camera action=zoom factor=1.07 duration=0.1
  sfx id=duel_enemy outline=0.9 outline_color=#ffe6a8 shake=1 dur=1.0
  // Аура клинка не замечает защиты — щит светится чужим светом насквозь.
  fx rays=0.5 speedlines=0.4 bloom=0.35 dur=0.3
  camera action=zoom factor=1 duration=0.35
  аура_рост("з_меч", 3)
  бит_суть = "аура прошла СКВОЗЬ ЩИТ — вдвое."
  -> ра_призрак_чек

  :ра_сила
  if аура_вид == "з_сила" -> ра_сила_есть
  -> ра_отчаяние_чек
  :ра_сила_есть
  if урон_ему > 0 -> ра_сила_плюс
  -> ра_призрак_чек
  :ра_сила_плюс
  camera action=shake amplitude=0.026 duration=0.3
  sfx id=duel_enemy shake=0.9 dur=0.8
  fx bloom=0.4 tint=0.3 dur=0.25
  урон_ему = урон_ему + 2
  аура_рост("з_сила", 2)
  -> ра_призрак_чек

  // Тень уклоняется от ЧЕГО УГОДНО, включая чужую ауру, но заряды кончаются.
  // ОТЧАЯНИЕ — единственная аура, которая СИЛЬНЕЕ у проигрывающего: каждое
  // потерянное сердце добавляет урон. Она не спасает и не защищает — она
  // делает загнанного опасным, и потому её выгодно держать именно тогда,
  // когда всё уже плохо. Потолок в 4 не даёт ей превратиться в «нажми и
  // выиграй» на одном оставшемся сердце.
  //
  // Звено цепочки, а не висящий кусок: сюда приходит промах «силы». Без этой
  // метки проверка стояла сразу за блоком силы, который уходит переходом, —
  // и отчаяние не срабатывало НИ РАЗУ (нашёл `lvnconv walk`).
  :ра_отчаяние_чек
  if аура_вид == "з_отчаяние" -> ра_отчаяние
  -> ра_призрак_чек
  :ра_отчаяние
  if урон_ему > 0 -> ра_отч_бьёт
  -> ра_призрак_чек
  :ра_отч_бьёт
  отч_бонус = min(дуэль_хп_макс - дуэль_хп, 4)
  урон_ему = урон_ему + отч_бонус
  аура_рост("з_отчаяние", 2)
  camera action=shake amplitude=0.022 duration=0.3
  sfx id=duel_enemy shake=1 dur=0.6
  бит_суть = бит_суть + " Отчаяние: +" + отч_бонус + "."
  -> ра_призрак_чек

  :ра_призрак_чек
  if аура_вид == "з_призрак" -> ра_призрак
  -> ра_воля_чек
  :ра_призрак
  if урон_мне > 0 -> ра_призрак_ушёл
  -> ра_воля_чек
  :ра_призрак_ушёл
  // Удар прошёл насквозь: руки на миг теряют плотность, кадр «двоится».
  sfx id=duel_hands ghost=0.85 hologram=0.5 hologram_color=#9fe8ff dur=0.9
  fx distort=0.45 chromatic=0.35 dur=0.3
  урон_мне = 0
  призрак_зарядов = призрак_зарядов - 1
  аура_рост("з_призрак", 3)
  бит_суть = бит_суть + " Ты прошёл сквозь удар (" + призрак_зарядов + ")."
  if призрак_зарядов <= 0 {
    аура_вид = ""
    бит_суть = бит_суть + " Тень истаяла."
  } else {
  }
  -> ра_кровь_чек

  // Воля защиты — единственный ответ на ЧУЖУЮ ауру: она её просто не
  // пропускает. Против обычного удара помогает мало (−1), и в этом смысл:
  // база остаётся базой.
  :ра_воля_чек
  if аура_вид == "з_воля" -> ра_воля
  -> ра_кровь_чек
  :ра_воля
  if урон_мне > 0 -> ра_воля_есть
  -> ра_кровь_чек
  :ра_воля_есть
  if враг_аура == 1 -> ра_воля_гасит
  урон_мне = max(урон_мне - 1, 0)
  аура_рост("з_воля", 2)
  -> ра_кровь_чек
  :ра_воля_гасит
  // Чернь съела чужой свет: короткая инверсия кадра и глухой удар — это
  // должно читаться как ЛУЧШЕЕ, что случилось за бой.
  camera action=shake amplitude=0.02 duration=0.3
  sfx id=duel_hands outline=1 outline_color=#ffffff shake=0.6 dur=0.8
  sfx id=duel_enemy dark=0.6 shake=0.5 dur=0.7
  fx shockwave=0.45 shock_x=0.5 shock_y=0.62 dur=0.4
  урон_мне = 0
  аура_рост("з_воля", 4)
  бит_суть = бит_суть + " Чернь удержала его свет."
  -> ра_кровь_чек

  :ра_кровь_чек
  if аура_вид == "з_кровь" -> ра_кровь
  -> ра_жизнь_чек
  :ра_кровь
  if урон_ему > 0 -> ра_кровь_пьёт
  -> ра_жизнь_чек
  :ра_кровь_пьёт
  // Кровь уходит от него к тебе: у врага гаснет цвет, у тебя разгорается.
  sfx id=duel_enemy dark=0.45 dur=0.7
  sfx id=duel_hands glow=0.7 glow_color=#ff5a72 rim=0.5 rim_color=#ff9aa8 dur=0.9
  fx blood=0.3 vignette=0.4 dur=0.35
  дуэль_хп = min(дуэль_хп + min(урон_ему, 2), дуэль_хп_макс)
  аура_рост("з_кровь", 3)
  кровь_тактов = кровь_тактов - 1
  бит_суть = бит_суть + " Рана легла на тебя — и затянулась."
  if кровь_тактов <= 0 {
    аура_вид = ""
  } else {
  }
  -> ра_жизнь_чек

  // Живучесть регенерирует КАЖДЫЙ такт, независимо от исхода — она про
  // выносливость в долгом бою, а не про размен.
  :ра_жизнь_чек
  if аура_вид == "з_жизнь" -> ра_жизнь
  -> ра_готово
  :ра_жизнь
  sfx id=duel_hands glow=0.35 glow_color=#7fe6a0 dur=0.7
  дуэль_хп = min(дуэль_хп + 1, дуэль_хп_макс)
  аура_рост("з_жизнь", 1)
  -> ра_готово
  :ра_готово
  враг_хп = max(враг_хп - урон_ему, 0)
  дуэль_хп = max(дуэль_хп - урон_мне, 0)
  // Чем меньше осталось, тем гуще кровь по краям: от 0.07 при полном теле до
  // 0.45 на нуле. Считаем переменной, а не выражением в команде — так число
  // видно в отладке и не зависит от разбора {…} в поле.
  кровь_сила = 0.07 + 0.38 * (1 - дуэль_хп / max(дуэль_хп_макс, 1))
  if враг_хп <= 0 {
    дуэль_исход = "победа"
  } else {
  }
  if дуэль_хп <= 0 && дуэль_исход == "" {
    дуэль_исход = "пал"
  } else {
  }
}

// ═══════════════════════════════════════════════════════════════════
//  5b. ОТДАЧА ТАКТА — свой эффект на каждый исход
// ═══════════════════════════════════════════════════════════════════

// Урок темпа — ровно в тот такт, где темп впервые начислен, и уже ПОСЛЕ
// анимации: сначала игрок видит, что произошло, потом читает, как это
// называется. Обратный порядок тестеры и назвали «непонятно что происходит».
func урок_темпа() {
  if учил_темп == 1 -> ут_нет
  if мой_ход == "блок" && его_ход == "удар" -> ут_мне
  if мой_ход == "удар" && его_ход == "блок" -> ут_ему
  -> ут_нет
  :ут_мне
  учил_темп = 1
  «Ты закрылся от его удара — и взял ТЕМП. В следующем размене ударишь первым и вдвое. Потратишь — сгорит.»
  -> ут_нет
  :ут_ему
  учил_темп = 1
  «Ты ударил в щит — ТЕМП забрал он. У кого темп, тот в размене бьёт первым и вдвое сильнее. Темп сгорает сразу после.»
  -> ут_нет
  :ут_нет
}

func beat_feedback() {
  // Каждому исходу — СВОЙ полнокадровый эффект из галереи движка. Порядок
  // проверок = приоритет: редкие и «говорящие» разбираются раньше рядовых.
  if его_ход == "стан" -> оо_стан
  if мой_ход == "оглушение" && враг_стан >= 1 -> оо_оглушил
  if мой_ход == "пробив" && его_ход == "блок" -> оо_пробил
  if мой_ход == "блок" && его_ход == "удар" -> оо_блок
  if урон_ему > 0 && урон_мне > 0 -> оо_размен
  if урон_ему > 0 -> оо_бью
  if урон_мне > 0 -> оо_бьют
  -> оо_готово

  // ТВОЙ УДАР — РЫВОК: радиальные линии скорости, кадр бросается вперёд.
  :оо_бью
  // Попал — его тряхнуло. Всё. Никакой засветки: удар в дуэли случается
  // каждый второй такт, и подсвечивать его как событие значит обесценить
  // подсветку вообще.
  camera action=zoom factor=1.03 duration=0.1
  sfx id=duel_enemy shake=0.9 dur=0.5
  fx speedlines=0.28 dur=0.18
  camera action=zoom factor=1 duration=0.3
  -> оо_готово

  // ПОПАЛИ ПО ТЕБЕ — РАНЕНИЕ: красная пульсация по краям, враг остаётся виден.
  :оо_бьют
  camera action=shake amplitude=0.022 duration=0.35
  // Камера клюёт носом: удар пришёл в тебя, и кадр складывается вниз — это
  // читается телом раньше, чем игрок успевает посмотреть на полосу hp.
  // Возврат стоит НЕ здесь: команды идут подряд, и «выпрямиться» сразу после
  // «согнуться» отменило бы наклон в том же кадре. Он в конце стадии.
  bg3d pitch={кам_боль} dur=0
  // Прилетело тебе — трясёт кадр и руки, а по краям выступает кровь. Её
  // густота — это ОСТАТОК здоровья, а не сила удара: полное тело даёт
  // тонкую кромку, последнее сердце заливает края почти наполовину. Так
  // состояние читается кадром, не цифрой в углу.
  sfx id=duel_hands shake=1 dur=0.5
  fx blood={кровь_сила} dur=0.25
  -> оо_готово

  // РАЗМЕН — досталось обоим: рывок и ранение вместе, каждый в своём цвете.
  :оо_размен
  camera action=shake amplitude=0.02 duration=0.32
  // В размене прилетело обоим — гнёт слабее, чем от чистого пропущенного удара.
  bg3d pitch={кам_полуболь} dur=0
  sfx id=duel_enemy shake=0.85 dur=0.5
  sfx id=duel_hands shake=0.85 dur=0.5
  fx blood={кровь_сила} dur=0.25
  -> оо_готово

  // БЛОК ДЕРЖИТ — звон: холодная кромка по клинку, иней, БЕЗ тряски.
  :оо_блок
  // Щит держит — коротко звенит кромка, обоих качает. Свечение убрано: блок
  // случается постоянно и светиться не должен.
  sfx id=duel_hands rim=0.45 rim_color=#cfe8ff shake=0.4 dur=0.6
  sfx id=duel_enemy shake=0.4 dur=0.5
  // Удар пришёл В ЩИТ — звенит именно он: холодная кромка и отдача.
  fx frost=0.1 dur=0.14
  -> оо_готово

  // ПРОБИВ СКВОЗЬ ЩИТ — самое дорогое попадание боя: веки, кровь, аберрация
  // и потеря периферии разом. Кадр «схлопывается» на миг, как от чужого
  // удара по своей же защите.
  :оо_пробил
  camera action=zoom factor=1.08 duration=0.1
  sfx id=duel_hands lightning=0.7 lightning_color=#bfe3ff dur=0.9
  sfx id=duel_enemy outline=0.7 outline_color=#bfe3ff shake=1 dur=0.9
  // Пробив — по щиту, а не мимо него: он вспыхивает и идёт трещиной.
  fx chromatic=0.35 vignette=0.58 dur=0.28
  camera action=zoom factor=1 duration=0.3
  -> оо_готово

  // ОГЛУШЕНИЕ ПРОШЛО — УДАРНАЯ ВОЛНА из точки попадания.
  // ОГЛУШЕНИЕ ПРОШЛО — ударная волна из точки попадания. Сила снята вдвое:
  // на полной громкости волна, руны, вспышка и тряска шли разом и забивали
  // сам момент — эффектов было видно больше, чем события. Руны остаются
  // главным знаком (это они читаются как «оглушён»), остальное — фон под них.
  :оо_оглушил
  camera action=shake amplitude=0.012 duration=0.25
  sfx id=duel_enemy runes=0.7 runes_color=#ffe08a shake=0.5 dur=1.1
  sfx id=duel_hands rim=0.4 rim_color=#ffe08a dur=0.9
  fx shockwave=0.5 shock_x=0.5 shock_y=0.46 dur=0.5
  -> оо_готово

  // ОН ОГЛУШЁН И ХОДИТ ВПУСТУЮ — марево: воздух дрожит, враг «плывёт».
  :оо_стан
  sfx id=duel_enemy hologram=0.45 hologram_color=#9fe8ff dur=1.1
  fx distort=0.8 dur=0.4
  -> оо_готово

  :оо_готово
}

// ═══════════════════════════════════════════════════════════════════
//  6. САМА ДУЭЛЬ
// ═══════════════════════════════════════════════════════════════════

func duel() {
  дуэль_исход = ""
  обмен = 0
  темп_мой = 0
  темп_врага = 0
  враг_шаг = 0
  враг_фаза = 1
  враг_стан = 0
  // Кто перед тобой — решает ГЛАВА, до вызова боя: враг_имя, враг_паттерн,
  // враг_паттерн2 (песня ярости), враг_тон, враг_даль, враг_высота, hp.
  // Пакет умеет драться, а не знать бестиарий, поэтому здесь их не трогаем.
  // Наклон камеры: покой и «согнуло от боли». Числа держим переменными —
  // глава ставит свой ракурс, и пакет не должен знать его в лицо.
  кам_наклон = -6
  кам_боль = 15
  кам_полуболь = 10
  план = []
  планфайлы = []
  вскрыто = []
  итоги = []
  тычок_текст = ""
  // Пустая строка ДО первого такта: иначе лейбл показывает сам плейсхолдер,
  // и игрок видит «{бит_текст}» вместо разбора.
  бит_текст = ""
  // Бой начинается с ЧИСТОГО кадра: ни вуали, ни остатков прошлой сцены.
  dim alpha=0 duration=0
  аура_вид = ""
  аура_зар_вид = ""
  аура_заряд = 0
  призрак_зарядов = 0
  кровь_тактов = 0
  // Аура ПРОТИВНИКА. Он — мастер своей силы: копить ему нечего, она горит с
  // первого кадра. Ровно та же аура, которую ты у него и заберёшь, победив, —
  // поэтому её сначала ВИДНО в чужих руках, а уже потом она твоя.
  враг_аура = 0
  if враг_аура_вид != "" {
    враг_аура = 1
  } else {
  }
  враг_тень_зарядов = 3
  // Сотня владения = аура горит с первого кадра: копить больше нечего.
  if аура_цена("з_меч") == 0 -> ду_а1
  -> ду_а2
  :ду_а1
  аура_вид = "з_меч"
  -> ду_а2
  :ду_а2
  if аура_цена("з_кровь") == 0 -> ду_а3
  -> ду_а4
  :ду_а3
  аура_вид = "з_кровь"
  -> ду_а4
  :ду_а4
  if аура_цена("з_призрак") == 0 -> ду_а5
  -> ду_а6
  :ду_а5
  аура_вид = "з_призрак"
  -> ду_а6
  :ду_а6
  duel_hud_plate()
  text dayline x=6 y=10.0 size=17 color=#b59a62 «День {день} · обмен {обмен}»
  // Имя — НАД полосой, цифры — БЕЛЫМ ПОВЕРХ неё (z выше заливки): взгляд
  // читает длину и число в одной точке, не прыгая по плашке.
  text foe_name x=26 y=83.0 size=19 color=#f0765e anchor="0.5,0" «{враг_имя}»
  text hero_name x=70 y=83.0 size=19 color=#73b8ee anchor="0.5,0" «ТЫ»
  text foe_num x=26 y=86.2 size=20 color=#ffffff anchor="0.5,0" «{враг_хп}/{враг_хп_макс}  темп {темп_врага}»
  text hero_num x=70 y=86.2 size=20 color=#ffffff anchor="0.5,0" «{дуэль_хп}/{дуэль_хп_макс}  темп {темп_мой}»
  text tellline x=50 y=27 size=25 color=#c9b98a anchor="0.5,0" «{тычок_текст}»
  // Бой начинается с ЧИСТОГО кадра. Постоянная виньетка «для настроения»
  // висела поверх сцены всегда и читалась как мгла — особенно на 3D-наборе,
  // у которого своя атмосфера и свой туман.
  fx off=1
  skill_hud()
  arsenal_show()
  foe_bar()
  hero_bar()
  // Чистим врага ПЕРЕД первым показом: прошлый бой мог закончиться его
  // растворением, а движок помнит последний эффект спрайта, чтобы тот не
  // слетал при смене позы. Без этого новый противник выходит невидимым.
  sfx id=duel_enemy off
  foe_sprite("idle")
  hands("idle")
  -> дт_обмен

  // ── цикл обменов ──
  :дт_обмен
  обмен = обмен + 1
  if обмен > 8 -> дт_ничья
  тактов = min(обмен, 6)
  // Новый обмен — чистые ряды: твой план пуст, его ходы снова закрыты,
  // заливки исходов сброшены.
  план = []
  планфайлы = []
  вскрыто = []
  итоги = []
  tell_update()
  if учил_план == 0 -> ур_план
  if обмен == 2 && учил_очередь == 0 -> ур_очередь
  -> дп_план

  // ── уроки: каждый ровно один раз, в свой момент ──────────────────
  :ур_план
  учил_план = 1
  Он ждёт. Оба выбираете ход ВСЛЕПУЮ — и потом смотрите, что вышло.
  «Удар бьёт. Блок держит удар. Удар в удар — размен, оба теряете кровь.»
  -> дп_план

  :ур_очередь
  учил_очередь = 1
  «Очередь выросла — теперь загадываешь ДВА хода вперёд. Дальше — больше. Он тоже.»
  -> дп_план

  // ── планирование: экран-пауза с кнопками (модель point-and-click) ──
  :дп_план
  врагплан()
  slots_draw()
  if len(план) >= тактов -> дп_готово
  buttons_show()
  // Сколько ещё выбирать — числом, а не подсчётом в уме. «Такт 5 из 5» само
  // по себе не отвечает на вопрос «сколько мне ещё тыкать»: игрок считает
  // разницу вместо того, чтобы думать о бое. Склонение ветками — в языке нет
  // ни тернарника, ни падежей.
  осталось = тактов - len(план)
  словоход = "ходов"
  if осталось == 1 {
    словоход = "ход"
  } else {
  }
  if осталось >= 2 && осталось <= 4 {
    словоход = "хода"
  } else {
  }
  План: такт {len(план) + 1} из {тактов} — выбери ещё {осталось} {словоход}.
  -> дп_план

  :дп_удар
  план = push(план, "удар")
  планфайлы = push(планфайлы, "icon_strike")
  -> дп_план
  :дп_блок
  план = push(план, "блок")
  планфайлы = push(планфайлы, "icon_block")
  -> дп_план
  :дп_оглушение
  план = push(план, "оглушение")
  планфайлы = push(планфайлы, "icon_stun")
  -> дп_план
  :дп_пробив
  план = push(план, "пробив")
  планфайлы = push(планфайлы, "icon_break")
  -> дп_план
  :дп_замеч
  план = push(план, "з_меч")
  планфайлы = push(планфайлы, "icon_aura")
  -> дп_план
  :дп_закровь
  план = push(план, "з_кровь")
  планфайлы = push(планфайлы, "icon_vampire")
  -> дп_план
  :дп_запризрак
  план = push(план, "з_призрак")
  планфайлы = push(планфайлы, "icon_ghost")
  -> дп_план
  :дп_засила
  план = push(план, "з_сила")
  планфайлы = push(планфайлы, "icon_might")
  -> дп_план
  :дп_зажизнь
  план = push(план, "з_жизнь")
  планфайлы = push(планфайлы, "icon_vitality")
  -> дп_план
  :дп_заволя
  план = push(план, "з_воля")
  планфайлы = push(планфайлы, "icon_will")
  -> дп_план
  // ── СВОДКА ПУТИ: что открыто, на каком владении, за сколько тактов ──
  // Числа владения жили только в голове игрока и в подписи под иконкой
  // навыка. Аура же вспыхивает за 3, 2 или 1 такт — и это самое важное
  // число в планировании: от него зависит, влезет ли она в очередь вообще.
  :дп_дерево
  buttons_hide()
  slots_hide()
  // Экран поверх боя обязан быть НЕПРОЗРАЧНЫМ: сквозь затемнение читались
  // ячейки ходов, подсказка и разбор такта, и сводка тонула в этой каше.
  text tellline hide
  text dayline hide
  text beatline hide
  // ⚠ ЗДЕСЬ ДОЛЖНА ПРЯТАТЬСЯ РАМКА ДИАЛОГА, и её нечем спрятать: у опа
  // clear полей нет ни в валидаторе, ни в рантайме, так что «clear
  // dialogue=off» был тихим отказом — код обещал то, чего не делал.
  // Из-за этого окно перекрывает нижнюю шестую часть сцены весь обмен.
  // Нужен оп сокрытия окна; до него честнее пустая строка, чем ложь.
  // Значения считаем ЗАРАНЕЕ, отдельными переменными: внутри {…} нельзя
  // писать строковый литерал в кавычках — атрибут команды закончится на
  // первой же кавычке.
  вл_меч = get(влад_аур, "з_меч", 0)
  вл_кровь = get(влад_аур, "з_кровь", 0)
  вл_тень = get(влад_аур, "з_призрак", 0)
  вл_сила = get(влад_аур, "з_сила", 0)
  вл_жизнь = get(влад_аур, "з_жизнь", 0)
  вл_воля = get(влад_аур, "з_воля", 0)
  ц_меч = аура_цена("з_меч")
  ц_кровь = аура_цена("з_кровь")
  ц_тень = аура_цена("з_призрак")
  ц_сила = аура_цена("з_сила")
  ц_жизнь = аура_цена("з_жизнь")
  ц_воля = аура_цена("з_воля")
  вл_отчаяние = get(влад_аур, "з_отчаяние", 0)
  ц_отчаяние = аура_цена("з_отчаяние")
  obj id=tr_bg sprite_url="/content/packages/lvn-duel/ui/panel_dark.png" x=50% y=45% width=0.94 height=0.82 anchor="0.5,0.5" z=55
  text tr_h x=50 y=8 size=27 color=#e8dfc8 anchor="0.5,0" «ТВОЙ ПУТЬ · день {день}»
  text tr_s x=50 y=12.5 size=17 color=#c2c8d6 anchor="0.5,0" «Аура занимает такты очереди. Пока копишь — ты открыт и не бьёшь.»
  text tr_s2 x=50 y=15.8 size=16 color=#8f96a8 anchor="0.5,0" «Цвет = редкость: серая → синяя → тёмно-синяя → фиолетовая → малиновая → золотая → алая.»

  // Строка ауры = иконка + полоса владения + подпись. Закрытые не прячем, а
  // ГАСИМ прозрачностью: игрок должен видеть, что ещё бывает на этом пути,
  // иначе ряд выглядит поломанным, а не пустым.
  obj id=tri1 sprite_url="/content/packages/lvn-duel/ui/icon_aura.png" x=0.115 y=23% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + аура_меч_откр * 0.74}"
  obj id=trb1 sprite_url="/content/packages/lvn-duel/ui/bar_back.png" x=0.19 y=24.6% width=0.40 height=0.014 anchor="0,0.5" z=56
  obj id=trf1 sprite_url="/content/packages/lvn-duel/ui/bar_hero.png" x=0.19 y=24.6% width=0.40 height=0.014 anchor="0,0.5" z=57 fill_from=left fill="{вл_меч / 100}"
  text trt1 x=19 y=20.4 size=18 color=#b28a33 «КЛИНОК · бессмертная · {вл_меч}% · за {ц_меч} · урон ×2 сквозь щит»

  obj id=tri2 sprite_url="/content/packages/lvn-duel/ui/icon_vampire.png" x=0.115 y=31% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + аура_кровь_откр * 0.74}"
