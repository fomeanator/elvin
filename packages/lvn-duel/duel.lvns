  obj id=tri5 sprite_url="/content/packages/lvn-duel/ui/icon_vitality.png" x=0.115 y=55% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + аура_жизнь_откр * 0.74}"
