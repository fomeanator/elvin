// ═══════════════════════════════════════════════════════════════════
//  4. ТЫЧОК — подсказка ПЕРВОГО такта грядущего обмена
// ═══════════════════════════════════════════════════════════════════
// Остальные такты — только память игрока. Это и есть раскачка: тело
// сгорает с днём, а выученная песня паттерна остаётся в голове.

// Обмен ВСЕГДА длится 6 секунд: такт = 6с / кол-во тактов (решение
// владельца, 2026-07-31). Обмен 1 — один такт смакуется 6с, кап 5 — по 1.2с.
// wait ms= принимает только литерал, поэтому таблица ветками.

func tell_update() {
  // ПРОТИВ ЖИВОГО ПОДСКАЗЫВАТЬ НЕЧЕГО. Тычок читает песню врага — таблицу
  // его будущих ходов. У человека такой таблицы нет, и «Костяные пальцы
  // сжали рукоять» превращается в прямую ложь: подсказка говорит о ходе,
  // которого никто не загадывал.
  if duel_net == 1 -> tell_silent
  // Если ближайший такт уже открыт в ряду — молчим: подсказка нужна там, где
  // игрок ещё не знает песню, а не поверх собственной же иконки.
  if get(learned, foe_name + "#" + pat_idx(foe_step, len(foe_song)), 0) == 1 -> tell_silent
  if foe_stun >= 1 -> tell_stunned
  if foe_now() == "break" -> tell_break
  if foe_now() == "strike" -> tell_strike
  tell_line = "Он вжимается за щит: первым тактом закроется."
  -> tell_done
  :tell_stunned
  tell_line = "Он ещё качается после оглушения — первый такт твой."
  -> tell_done
  :tell_break
  tell_line = "Он заносит клинок остриём вниз: первым тактом — ПРОБИВ. Щит не спасёт."
  -> tell_done
  :tell_strike
  tell_line = "Костяные пальцы сжали рукоять: первым тактом — удар."
  -> tell_done
  :tell_silent
  tell_line = ""
  -> tell_done
  :tell_done
}

// ═══════════════════════════════════════════════════════════════════
//  5. РАЗРЕШЕНИЕ ОДНОГО ТАКТА
// ═══════════════════════════════════════════════════════════════════
// Входы: my_move, foe_move, такт. Выходы: dmg_me, dmg_foe, beat_note,
// правки темпа/стана/владения. Приоритет смертей: враг падает первым
// (удар с темпом уже упорядочен внутри размена, а добить издыхающего —
// победа, не ничья).

func resolve_beat() {
  dmg_me = 0
  dmg_foe = 0
  beat_note = ""
  if my_move == "a_blade" -> beat_charge
  if my_move == "a_thirst" -> beat_charge
  if my_move == "a_shade" -> beat_charge
  if my_move == "a_might" -> beat_charge
  if my_move == "a_vigor" -> beat_charge
  if my_move == "a_will" -> beat_charge
  if my_move == "a_despair" -> beat_charge
  if foe_move == "stunned" -> beat_stunned
  if my_move == "strike" && foe_move == "strike" -> beat_ss
  if my_move == "strike" && foe_move == "block" -> beat_sb
  if my_move == "block" && foe_move == "strike" -> beat_bs
  if my_move == "block" && foe_move == "block" -> beat_bb
  if my_move == "stun" && foe_move == "strike" -> beat_ns
  if my_move == "stun" && foe_move == "block" -> beat_nb
  if my_move == "break" && foe_move == "block" -> beat_kb
  if foe_move == "break" -> beat_foebreak
  -> beat_ks

  // ── ЕГО пробив: то же движение, что и твоё, с той же ценой ──────
  :beat_foebreak
  if my_move == "block" -> beat_foebreak_block
  if my_move == "stun" -> beat_foebreak_stun
  if my_move == "break" -> beat_foebreak_both
  // против твоего удара он раскрыт — пробив бьёт по щиту, а не по клинку
  dmg_foe = 2
  beat_note = "он раскрылся под пробив: −2 ему."
  -> beat_apply
  :beat_foebreak_block
  dmg_me = 2
  beat_note = "пробил твой щит: −2 тебе!"
  -> beat_apply
  :beat_foebreak_stun
  if tempo_mine >= 1 -> beat_foebreak_stun_ok
  dmg_me = 2
  stun_lvl = min(stun_lvl + 1, 100)
  hint text="Оглушение +1 — не хватило темпа" duration=2
  beat_note = "темпа нет — пробив прошёл: −2 тебе."
  -> beat_apply
  :beat_foebreak_stun_ok
  tempo_mine = tempo_mine - 1
  foe_stun = foe_stun + 1
  stun_lvl = min(stun_lvl + 3, 100)
  hint text="Оглушение +3 — сбил пробив!" duration=2
  beat_note = "сбил его пробив на замахе!"
  -> beat_apply
  :beat_foebreak_both
  dmg_me = 2
  dmg_foe = 2
  break_lvl = min(break_lvl + 3, 100)
  hint text="Пробив +3 — встречный размен" duration=2
  beat_note = "два пробива в упор: −2 обоим."
  -> beat_apply

  // ── враг оглушён: такт без его действия ──
  :beat_stunned
  if my_move == "strike" -> beat_stunned_strike
  if my_move == "break" -> beat_stunned_break
  if my_move == "stun" -> beat_stunned_stun
  beat_note = "он плывёт — такт впустую."
  -> beat_apply
  :beat_stunned_strike
  dmg_foe = 2
  beat_note = "по оглушённому: −2!"
  -> beat_apply
  :beat_stunned_break
  dmg_foe = 2
  break_lvl = min(break_lvl + 3, 100)
  hint text="Пробив +3 — урон по открытому" duration=2
  beat_note = "пробив по открытому: −2!"
  -> beat_apply
  :beat_stunned_stun
  stun_lvl = min(stun_lvl + 1, 100)
  hint text="Оглушение +1 — в молоко (он и так оглушён)" duration=2
  beat_note = "он и так оглушён — мимо."
  -> beat_apply

  // ── удар × удар: размен решает темп ──
  :beat_ss
  if tempo_mine > tempo_foe -> beat_ss_mine
  if tempo_foe > tempo_mine -> beat_ss_his
  dmg_me = 1
  dmg_foe = 1
  beat_note = "размен: −1 обоим."
  -> beat_apply
  :beat_ss_mine
  dmg_foe = 2
  tempo_mine = 0
  if foe_hp - 2 > 0 {
    dmg_me = 1
    beat_note = "твой темп: −2 ему, −1 тебе."
  } else {
    beat_note = "твой темп: добил!"
  }
  -> beat_apply
  :beat_ss_his
  dmg_me = 2
  tempo_foe = 0
  if duel_hp - 2 > 0 {
    dmg_foe = 1
    beat_note = "его темп: −2 тебе, −1 ему."
  } else {
    beat_note = "его темп: ты падаешь."
  }
  -> beat_apply

  // ── удар × блок и блок × удар: банк темпа ──
  :beat_sb
  tempo_foe = tempo_foe + 1
  beat_note = "в щит: +1 темп ему."
  -> beat_apply
  :beat_bs
  tempo_mine = tempo_mine + 1
  beat_note = "блок: +1 темп тебе."
  -> beat_apply
  :beat_bb
  beat_note = "оба закрылись."
  -> beat_apply

  // ── 💫 оглушение ──
  :beat_ns
  stun_cost = 2
  if stun_lvl >= 25 {
    stun_cost = 1
  } else {
  }
  if tempo_mine >= stun_cost -> beat_ns_ok
  dmg_me = 1
  stun_lvl = min(stun_lvl + 1, 100)
  hint text="Оглушение +1 — не хватило темпа" duration=2
  beat_note = "без темпа: −1 тебе."
  -> beat_apply
  :beat_ns_ok
  tempo_mine = tempo_mine - stun_cost
  foe_stun = 1
  if stun_lvl >= 50 {
    foe_stun = 2
  } else {
  }
  stun_lvl = min(stun_lvl + 3, 100)
  hint text="Оглушение +3 — сработало!" duration=2
  beat_note = "оглушил — он теряет такт!"
  -> beat_apply
  :beat_nb
  stun_lvl = min(stun_lvl + 1, 100)
  hint text="Оглушение +1 — он был за щитом" duration=2
  beat_note = "в щит — мимо."
  -> beat_apply

  // ── 🔨 пробив ──
  :beat_kb
  dmg_foe = 2
  if break_lvl >= 50 {
    dmg_foe = 3
  } else {
  }
  tempo_mine = tempo_mine + 1
  break_lvl = min(break_lvl + 6, 100)
  hint text="Пробив +6 — КРИТ сквозь щит!" duration=2
  beat_note = "сквозь щит: −" + dmg_foe + ", темп твой!"
  -> beat_apply
  :beat_ks
  dmg_me = 2
  if break_lvl >= 25 {
    dmg_me = 1
  } else {
  }
  break_lvl = min(break_lvl + 1, 100)
  hint text="Пробив +1 — он не закрывался" duration=2
  beat_note = "раскрылся: −" + dmg_me + " тебе."
  -> beat_apply

  // ── ЗАРЯДКА АУРЫ: такт, в котором ты СТОИШЬ ОТКРЫТЫМ ───────────
  // Цена честная и в этом весь смысл: пока копишь свет, ты не бьёшь и не
  // закрываешься. Три такта на старте — почти вся очередь раннего боя, и
  // решиться на них можно только зная его песню. С владением цена падает,
  // а на сотне аура горит с первого кадра — но к тому времени и противники
  // выходят со своими.
  :beat_charge
  if aura_charge_kind != my_move -> charge_switch
  -> charge_hold
  :charge_switch
  // Переключился на другую ауру — прежний прогресс сгорел: свет не смешивается.
  aura_charge_kind = my_move
  aura_charge = 0
  -> charge_hold
  :charge_hold
  aura_charge = aura_charge + 1
  // Копление — не пустой такт: свет уже собирается на руках, но и виньетка
  // сжимается, напоминая, что защиты сейчас нет.
  sfx id=duel_hands glow=0.5 glow_color=#ffe6a8 rim=0.4 rim_color=#fff0c0 dur=0.8
  fx vignette=0.4 bloom=0.25 dur=0.3
  if aura_charge >= aura_cost(my_move) -> charge_flash
  beat_note = "копишь свет — " + aura_charge + " из " + aura_cost(my_move) + ", ты открыт."
  -> charge_hurt
  :charge_flash
  aura_kind = my_move
  aura_charge = 0
  aura_grow(my_move, 8)
  aura_flash()
  -> charge_hurt
  // Открыт — значит его удар проходит как по стоячему, а щит его не нужен.
  :charge_hurt
  if foe_move == "strike" -> charge_hit
  if foe_move == "break" -> charge_hit
  -> beat_apply
  :charge_hit
  dmg_me = 2
  beat_note = beat_note + " Он бьёт в открытого: −2."
  -> beat_apply

  // ── АУРА ПРОТИВНИКА ──────────────────────────────────────────────
  // Считается ДО твоих аур: воля защиты должна гасить уже посчитанный чужой
  // свет, а не отменять его задним числом.
  :beat_apply
  // (сила раны считается ниже, после применения урона)
  if foe_aura_kind == "" -> foeaura_none
  if aura_kind == "a_will" -> foeaura_none
  if foe_aura_kind == "might" -> foeaura_might
  if foe_aura_kind == "blade" -> foeaura_blade
  if foe_aura_kind == "shade" -> foeaura_shade
  if foe_aura_kind == "thirst" -> foeaura_thirst
  if foe_aura_kind == "vigor" -> foeaura_vigor
  if foe_aura_kind == "despair" -> foeaura_despair
  -> foeaura_none
  :foeaura_might
  if dmg_me > 0 {
    dmg_me = dmg_me + 2
    beat_note = beat_note + " Его сила: +2."
  } else {
  }
  -> foeaura_none
  :foeaura_blade
  if my_move == "block" {
    dmg_me = max(dmg_me, 1) * 2
    beat_note = beat_note + " Его клинок прошёл сквозь щит!"
  } else {
  }
  -> foeaura_none
  :foeaura_shade
  if dmg_foe > 0 {
    if foe_shade_charges > 0 {
      dmg_foe = 0
      foe_shade_charges = foe_shade_charges - 1
      beat_note = beat_note + " Он ушёл в тень (" + foe_shade_charges + ")."
    } else {
    }
  } else {
  }
  -> foeaura_none
  :foeaura_thirst
  if dmg_me > 0 {
    foe_hp = min(foe_hp + 1, foe_hp_max)
    beat_note = beat_note + " Твоя кровь легла на него."
  } else {
  }
  -> foeaura_none
  :foeaura_vigor
  foe_hp = min(foe_hp + 1, foe_hp_max)
  -> foeaura_none
  :foeaura_despair
  if dmg_me > 0 {
    dmg_me = dmg_me + min(foe_hp_max - foe_hp, 4)
    beat_note = beat_note + " Он тем злее, чем ближе к концу."
  } else {
  }
  -> foeaura_none
  :foeaura_none
  // ── АУРЫ ─────────────────────────────────────────────────────────
  // Две категории, и это главное решение баланса. ПОСТОЯННЫЕ (сила,
  // живучесть, воля) горят до конца боя, но дают немного — они меняют
  // арифметику, а не исход. РАЗРЯДНЫЕ (клинок, тень, жажда) бьют
  // категориально и гаснут: свет уходит в удар, тень тратится на уклонение.
  // Без этого «клинок» был кнопкой «победить» и обесценивал остальные пять.
  if aura_kind == "a_blade" -> aura_blade
  -> aura_might
  :aura_blade
  if my_move == "strike" -> aura_blade_hits
  if my_move == "break" -> aura_blade_hits
  -> aura_might
  :aura_blade_hits
  // УДВОЕНИЕ, а не «+100 урона»: плоская сотня при восьми жизнях означала бы
  // «нажми и выиграй», и остальные пять аур можно было бы выбросить. Процент
  // же растёт вместе с боем — и остаётся значимым, когда цифры вырастут.
  // Сквозь щит проходит даже нулевой урон: аура не бьёт мимо защиты, она её
  // не замечает.
  if dmg_foe <= 0 {
    dmg_foe = 1
  } else {
  }
  dmg_foe = dmg_foe * 2
  // Удвоенный удар сквозь защиту — золотой разрез по кадру.
  camera action=zoom factor=1.07 duration=0.1
  sfx id=duel_enemy outline=0.9 outline_color=#ffe6a8 shake=1 dur=1.0
  // Аура клинка не замечает защиты — щит светится чужим светом насквозь.
  fx rays=0.5 speedlines=0.4 bloom=0.35 dur=0.3
  camera action=zoom factor=1 duration=0.35
  aura_grow("a_blade", 3)
  beat_note = "аура прошла СКВОЗЬ ЩИТ — вдвое."
  -> aura_shade_test

  :aura_might
  if aura_kind == "a_might" -> aura_might_ok
  -> aura_despair_test
  :aura_might_ok
  if dmg_foe > 0 -> aura_might_add
  -> aura_shade_test
  :aura_might_add
  camera action=shake amplitude=0.026 duration=0.3
  sfx id=duel_enemy shake=0.9 dur=0.8
  fx bloom=0.4 tint=0.3 dur=0.25
  dmg_foe = dmg_foe + 2
  aura_grow("a_might", 2)
  -> aura_shade_test

  // Тень уклоняется от ЧЕГО УГОДНО, включая чужую ауру, но заряды кончаются.
  // ОТЧАЯНИЕ — единственная аура, которая СИЛЬНЕЕ у проигрывающего: каждое
  // потерянное сердце добавляет урон. Она не спасает и не защищает — она
  // делает загнанного опасным, и потому её выгодно держать именно тогда,
  // когда всё уже плохо. Потолок в 4 не даёт ей превратиться в «нажми и
  // выиграй» на одном оставшемся сердце.
  //
  // Звено цепочки, а не висящий кусок: сюда приходит промах «силы». Без этой
  // метки проверка стояла сразу за блоком силы, который уходит переходом, —
  // и отчаяние не срабатывало НИ РАЗУ (нашёл `lvnconv walk`).
  :aura_despair_test
  if aura_kind == "a_despair" -> aura_despair
  -> aura_shade_test
  :aura_despair
  if dmg_foe > 0 -> aura_despair_hits
  -> aura_shade_test
  :aura_despair_hits
  despair_bonus = min(duel_hp_max - duel_hp, 4)
  dmg_foe = dmg_foe + despair_bonus
  aura_grow("a_despair", 2)
  camera action=shake amplitude=0.022 duration=0.3
  sfx id=duel_enemy shake=1 dur=0.6
  beat_note = beat_note + " Отчаяние: +" + despair_bonus + "."
  -> aura_shade_test

  :aura_shade_test
  if aura_kind == "a_shade" -> aura_shade
  -> aura_will_test
  :aura_shade
  if dmg_me > 0 -> aura_shade_gone
  -> aura_will_test
  :aura_shade_gone
  // Удар прошёл насквозь: руки на миг теряют плотность, кадр «двоится».
  sfx id=duel_hands ghost=0.85 hologram=0.5 hologram_color=#9fe8ff dur=0.9
  fx distort=0.45 chromatic=0.35 dur=0.3
  dmg_me = 0
  shade_charges = shade_charges - 1
  aura_grow("a_shade", 3)
  beat_note = beat_note + " Ты прошёл сквозь удар (" + shade_charges + ")."
  if shade_charges <= 0 {
    aura_kind = ""
    beat_note = beat_note + " Тень истаяла."
  } else {
  }
  -> aura_thirst_test

  // Воля защиты — единственный ответ на ЧУЖУЮ ауру: она её просто не
  // пропускает. Против обычного удара помогает мало (−1), и в этом смысл:
  // база остаётся базой.
  :aura_will_test
  if aura_kind == "a_will" -> aura_will
  -> aura_thirst_test
  :aura_will
  if dmg_me > 0 -> aura_will_ok
  -> aura_thirst_test
  :aura_will_ok
  if foe_aura == 1 -> aura_will_soaks
  dmg_me = max(dmg_me - 1, 0)
  aura_grow("a_will", 2)
  -> aura_thirst_test
  :aura_will_soaks
  // Чернь съела чужой свет: короткая инверсия кадра и глухой удар — это
  // должно читаться как ЛУЧШЕЕ, что случилось за бой.
  camera action=shake amplitude=0.02 duration=0.3
  sfx id=duel_hands outline=1 outline_color=#ffffff shake=0.6 dur=0.8
  sfx id=duel_enemy dark=0.6 shake=0.5 dur=0.7
  fx shockwave=0.45 shock_x=0.5 shock_y=0.62 dur=0.4
  dmg_me = 0
  aura_grow("a_will", 4)
  beat_note = beat_note + " Чернь удержала его свет."
  -> aura_thirst_test

  :aura_thirst_test
  if aura_kind == "a_thirst" -> aura_thirst
  -> aura_vigor_test
  :aura_thirst
  if dmg_foe > 0 -> aura_thirst_drinks
  -> aura_vigor_test
  :aura_thirst_drinks
  // Кровь уходит от него к тебе: у врага гаснет цвет, у тебя разгорается.
  sfx id=duel_enemy dark=0.45 dur=0.7
  sfx id=duel_hands glow=0.7 glow_color=#ff5a72 rim=0.5 rim_color=#ff9aa8 dur=0.9
  fx blood=0.3 vignette=0.4 dur=0.35
  duel_hp = min(duel_hp + min(dmg_foe, 2), duel_hp_max)
  aura_grow("a_thirst", 3)
  thirst_beats = thirst_beats - 1
  beat_note = beat_note + " Рана легла на тебя — и затянулась."
  if thirst_beats <= 0 {
    aura_kind = ""
  } else {
  }
  -> aura_vigor_test

  // Живучесть регенерирует КАЖДЫЙ такт, независимо от исхода — она про
  // выносливость в долгом бою, а не про размен.
  :aura_vigor_test
  if aura_kind == "a_vigor" -> aura_vigor
  -> aura_done
  :aura_vigor
  sfx id=duel_hands glow=0.35 glow_color=#7fe6a0 dur=0.7
  duel_hp = min(duel_hp + 1, duel_hp_max)
  aura_grow("a_vigor", 1)
  -> aura_done
  :aura_done
  foe_hp = max(foe_hp - dmg_foe, 0)
  duel_hp = max(duel_hp - dmg_me, 0)
  // Чем меньше осталось, тем гуще кровь по краям: от 0.07 при полном теле до
  // 0.45 на нуле. Считаем переменной, а не выражением в команде — так число
  // видно в отладке и не зависит от разбора {…} в поле.
  thirst_power = 0.07 + 0.38 * (1 - duel_hp / max(duel_hp_max, 1))
  if foe_hp <= 0 {
    duel_outcome = "win"
  } else {
  }
  if duel_hp <= 0 && duel_outcome == "" {
    duel_outcome = "lost"
  } else {
  }
}

// ═══════════════════════════════════════════════════════════════════
//  5b. ОТДАЧА ТАКТА — свой эффект на каждый исход
// ═══════════════════════════════════════════════════════════════════

// Урок темпа — ровно в тот такт, где темп впервые начислен, и уже ПОСЛЕ
// анимации: сначала игрок видит, что произошло, потом читает, как это
// называется. Обратный порядок тестеры и назвали «непонятно что происходит».
func tempo_lesson() {
  if taught_tempo == 1 -> tempo_no_lesson
  if my_move == "block" && foe_move == "strike" -> tempo_mine_lesson
  if my_move == "strike" && foe_move == "block" -> tempo_foe_lesson
  -> tempo_no_lesson
  :tempo_mine_lesson
  taught_tempo = 1
  «Ты закрылся от его удара — и взял ТЕМП. В следующем размене ударишь первым и вдвое. Потратишь — сгорит.»
  -> tempo_no_lesson
  :tempo_foe_lesson
  taught_tempo = 1
  «Ты ударил в щит — ТЕМП забрал он. У кого темп, тот в размене бьёт первым и вдвое сильнее. Темп сгорает сразу после.»
  -> tempo_no_lesson
  :tempo_no_lesson
}

func beat_feedback() {
  // Каждому исходу — СВОЙ полнокадровый эффект из галереи движка. Порядок
  // проверок = приоритет: редкие и «говорящие» разбираются раньше рядовых.
  if foe_move == "stunned" -> recap_stunned
  if my_move == "stun" && foe_stun >= 1 -> recap_stun
  if my_move == "break" && foe_move == "block" -> recap_break
  if my_move == "block" && foe_move == "strike" -> recap_block
  if dmg_foe > 0 && dmg_me > 0 -> recap_trade
  if dmg_foe > 0 -> recap_hit
  if dmg_me > 0 -> recap_hurt
  -> recap_done

  // ТВОЙ УДАР — РЫВОК: радиальные линии скорости, кадр бросается вперёд.
  :recap_hit
  // Попал — его тряхнуло. Всё. Никакой засветки: удар в дуэли случается
  // каждый второй такт, и подсвечивать его как событие значит обесценить
  // подсветку вообще.
  camera action=zoom factor=1.03 duration=0.1
  sfx id=duel_enemy shake=0.9 dur=0.5
  fx speedlines=0.28 dur=0.18
  camera action=zoom factor=1 duration=0.3
  -> recap_done

  // ПОПАЛИ ПО ТЕБЕ — РАНЕНИЕ: красная пульсация по краям, враг остаётся виден.
  :recap_hurt
  camera action=shake amplitude=0.022 duration=0.35
  // Камера клюёт носом: удар пришёл в тебя, и кадр складывается вниз — это
  // читается телом раньше, чем игрок успевает посмотреть на полосу hp.
  // Возврат стоит НЕ здесь: команды идут подряд, и «выпрямиться» сразу после
  // «согнуться» отменило бы наклон в том же кадре. Он в конце стадии.
  bg3d pitch={cam_hurt} dur=0
  // Прилетело тебе — трясёт кадр и руки, а по краям выступает кровь. Её
  // густота — это ОСТАТОК здоровья, а не сила удара: полное тело даёт
  // тонкую кромку, последнее сердце заливает края почти наполовину. Так
  // состояние читается кадром, не цифрой в углу.
  sfx id=duel_hands shake=1 dur=0.5
  fx blood={thirst_power} dur=0.25
  -> recap_done

  // РАЗМЕН — досталось обоим: рывок и ранение вместе, каждый в своём цвете.
  :recap_trade
  camera action=shake amplitude=0.02 duration=0.32
  // В размене прилетело обоим — гнёт слабее, чем от чистого пропущенного удара.
  bg3d pitch={cam_half_hurt} dur=0
  sfx id=duel_enemy shake=0.85 dur=0.5
  sfx id=duel_hands shake=0.85 dur=0.5
  fx blood={thirst_power} dur=0.25
  -> recap_done

  // БЛОК ДЕРЖИТ — звон: холодная кромка по клинку, иней, БЕЗ тряски.
  :recap_block
  // Щит держит — коротко звенит кромка, обоих качает. Свечение убрано: блок
  // случается постоянно и светиться не должен.
  sfx id=duel_hands rim=0.45 rim_color=#cfe8ff shake=0.4 dur=0.6
  sfx id=duel_enemy shake=0.4 dur=0.5
  // Удар пришёл В ЩИТ — звенит именно он: холодная кромка и отдача.
  fx frost=0.1 dur=0.14
  -> recap_done

  // ПРОБИВ СКВОЗЬ ЩИТ — самое дорогое попадание боя: веки, кровь, аберрация
  // и потеря периферии разом. Кадр «схлопывается» на миг, как от чужого
  // удара по своей же защите.
  :recap_break
  camera action=zoom factor=1.08 duration=0.1
  sfx id=duel_hands lightning=0.7 lightning_color=#bfe3ff dur=0.9
  sfx id=duel_enemy outline=0.7 outline_color=#bfe3ff shake=1 dur=0.9
  // Пробив — по щиту, а не мимо него: он вспыхивает и идёт трещиной.
  fx chromatic=0.35 vignette=0.58 dur=0.28
  camera action=zoom factor=1 duration=0.3
  -> recap_done

  // ОГЛУШЕНИЕ ПРОШЛО — УДАРНАЯ ВОЛНА из точки попадания.
  // ОГЛУШЕНИЕ ПРОШЛО — ударная волна из точки попадания. Сила снята вдвое:
  // на полной громкости волна, руны, вспышка и тряска шли разом и забивали
  // сам момент — эффектов было видно больше, чем события. Руны остаются
  // главным знаком (это они читаются как «оглушён»), остальное — фон под них.
  :recap_stun
  camera action=shake amplitude=0.012 duration=0.25
  sfx id=duel_enemy runes=0.7 runes_color=#ffe08a shake=0.5 dur=1.1
  sfx id=duel_hands rim=0.4 rim_color=#ffe08a dur=0.9
  fx shockwave=0.5 shock_x=0.5 shock_y=0.46 dur=0.5
  -> recap_done

  // ОН ОГЛУШЁН И ХОДИТ ВПУСТУЮ — марево: воздух дрожит, враг «плывёт».
  :recap_stunned
  sfx id=duel_enemy hologram=0.45 hologram_color=#9fe8ff dur=1.1
  fx distort=0.8 dur=0.4
  -> recap_done

  :recap_done
}

// ═══════════════════════════════════════════════════════════════════
//  6. САМА ДУЭЛЬ
// ═══════════════════════════════════════════════════════════════════

func duel() {
  duel_outcome = ""
  exchange = 0
  tempo_mine = 0
  tempo_foe = 0
  foe_step = 0
  foe_phase = 1
  foe_stun = 0
  // Кто перед тобой — решает ГЛАВА, до вызова боя: foe_name, foe_song,
  // foe_song_rage (песня ярости), враг_тон, foe_range, враг_высота, hp.
  // Пакет умеет драться, а не знать бестиарий, поэтому здесь их не трогаем.
  // Наклон камеры: покой и «согнуло от боли». Числа держим переменными —
  // глава ставит свой ракурс, и пакет не должен знать его в лицо.
  cam_tilt = -6
  cam_hurt = 15
  cam_half_hurt = 10
  plan = []
  plan_icons = []
  revealed = []
  outcomes = []
  tell_line = ""
  // Пустая строка ДО первого такта: иначе лейбл показывает сам плейсхолдер,
  // и игрок видит «{beat_line}» вместо разбора.
  beat_line = ""
  // Бой начинается с ЧИСТОГО кадра: ни вуали, ни остатков прошлой сцены.
  dim alpha=0 duration=0
  aura_kind = ""
  aura_charge_kind = ""
  aura_charge = 0
  shade_charges = 0
  thirst_beats = 0
  // Аура ПРОТИВНИКА. Он — мастер своей силы: копить ему нечего, она горит с
  // первого кадра. Ровно та же аура, которую ты у него и заберёшь, победив, —
  // поэтому её сначала ВИДНО в чужих руках, а уже потом она твоя.
  foe_aura = 0
  if foe_aura_kind != "" {
    foe_aura = 1
  } else {
  }
  foe_shade_charges = 3
  // Сотня владения = аура горит с первого кадра: копить больше нечего.
  if aura_cost("a_blade") == 0 -> snd_a1
  -> snd_a2
  :snd_a1
  aura_kind = "a_blade"
  -> snd_a2
  :snd_a2
  if aura_cost("a_thirst") == 0 -> snd_a3
  -> snd_a4
  :snd_a3
  aura_kind = "a_thirst"
  -> snd_a4
  :snd_a4
  if aura_cost("a_shade") == 0 -> snd_a5
  -> snd_a6
  :snd_a5
  aura_kind = "a_shade"
  -> snd_a6
  :snd_a6
  duel_hud_plate()
  text dayline x=6 y=10.0 size=17 color=#b59a62 «День {day} · обмен {exchange}»
  // Имя — НАД полосой, цифры — БЕЛЫМ ПОВЕРХ неё (z выше заливки): взгляд
  // читает длину и число в одной точке, не прыгая по плашке.
  text foe_name x=26 y=83.0 size=19 color=#f0765e anchor="0.5,0" «{foe_name}»
  text hero_name x=70 y=83.0 size=19 color=#73b8ee anchor="0.5,0" «ТЫ»
  text foe_num x=26 y=86.2 size=20 color=#ffffff anchor="0.5,0" «{foe_hp}/{foe_hp_max}  темп {tempo_foe}»
  text hero_num x=70 y=86.2 size=20 color=#ffffff anchor="0.5,0" «{duel_hp}/{duel_hp_max}  темп {tempo_mine}»
  text tellline x=50 y=27 size=25 color=#c9b98a anchor="0.5,0" «{tell_line}»
  // Бой начинается с ЧИСТОГО кадра. Постоянная виньетка «для настроения»
  // висела поверх сцены всегда и читалась как мгла — особенно на 3D-наборе,
  // у которого своя атмосфера и свой туман.
  fx off=1
  skill_hud()
  arsenal_show()
  foe_bar()
  hero_bar()
  // Чистим врага ПЕРЕД первым показом: прошлый бой мог закончиться его
  // растворением, а движок помнит последний эффект спрайта, чтобы тот не
  // слетал при смене позы. Без этого новый противник выходит невидимым.
  sfx id=duel_enemy off
  foe_sprite("idle")
  hands("idle")
  -> duel_exchange

  // ── цикл обменов ──
  :duel_exchange
  exchange = exchange + 1
  if exchange > 8 -> duel_draw
  beats = min(exchange, 6)
  // Новый обмен — чистые ряды: твой план пуст, его ходы снова закрыты,
  // заливки исходов сброшены.
  plan = []
  plan_icons = []
  revealed = []
  outcomes = []
  tell_update()
  if taught_plan == 0 -> lesson_plan
  if exchange == 2 && taught_queue == 0 -> lesson_queue
  -> plan_screen

  // ── уроки: каждый ровно один раз, в свой момент ──────────────────
  :lesson_plan
  taught_plan = 1
  Он ждёт. Оба выбираете ход ВСЛЕПУЮ — и потом смотрите, что вышло.
  «Удар бьёт. Блок держит удар. Удар в удар — размен, оба теряете кровь.»
  -> plan_screen

  :lesson_queue
  taught_queue = 1
  «Очередь выросла — теперь загадываешь ДВА хода вперёд. Дальше — больше. Он тоже.»
  -> plan_screen

  // ── планирование: экран-пауза с кнопками (модель point-and-click) ──
  :plan_screen
  foe_plan_build()
  slots_draw()
  if len(plan) >= beats -> plan_done
  buttons_show()
  // Сколько ещё выбирать — числом, а не подсчётом в уме. «Такт 5 из 5» само
  // по себе не отвечает на вопрос «сколько мне ещё тыкать»: игрок считает
  // разницу вместо того, чтобы думать о бое. Склонение ветками — в языке нет
  // ни тернарника, ни падежей.
  left = beats - len(plan)
  move_word = "ходов"
  if left == 1 {
    move_word = "move"
  } else {
  }
  if left >= 2 && left <= 4 {
    move_word = "хода"
  } else {
  }
  План: такт {len(plan) + 1} из {beats} — выбери ещё {left} {move_word}.
  -> plan_screen

  :plan_strike
  plan = push(plan, "strike")
  plan_icons = push(plan_icons, "icon_strike")
  -> plan_screen
  :plan_block
  plan = push(plan, "block")
  plan_icons = push(plan_icons, "icon_block")
  -> plan_screen
  :plan_stun
  plan = push(plan, "stun")
  plan_icons = push(plan_icons, "icon_stun")
  -> plan_screen
  :plan_break
  plan = push(plan, "break")
  plan_icons = push(plan_icons, "icon_break")
  -> plan_screen
  :plan_a_blade
  plan = push(plan, "a_blade")
  plan_icons = push(plan_icons, "icon_aura")
  -> plan_screen
  :plan_a_thirst
  plan = push(plan, "a_thirst")
  plan_icons = push(plan_icons, "icon_vampire")
  -> plan_screen
  :plan_a_shade
  plan = push(plan, "a_shade")
  plan_icons = push(plan_icons, "icon_ghost")
  -> plan_screen
  :plan_a_might
  plan = push(plan, "a_might")
  plan_icons = push(plan_icons, "icon_might")
  -> plan_screen
  :plan_a_vigor
  plan = push(plan, "a_vigor")
  plan_icons = push(plan_icons, "icon_vitality")
  -> plan_screen
  :plan_a_will
  plan = push(plan, "a_will")
  plan_icons = push(plan_icons, "icon_will")
  -> plan_screen
  // ── СВОДКА ПУТИ: что открыто, на каком владении, за сколько тактов ──
  // Числа владения жили только в голове игрока и в подписи под иконкой
  // навыка. Аура же вспыхивает за 3, 2 или 1 такт — и это самое важное
  // число в планировании: от него зависит, влезет ли она в очередь вообще.
  :plan_tree
  buttons_hide()
  slots_hide()
  // Экран поверх боя обязан быть НЕПРОЗРАЧНЫМ: сквозь затемнение читались
  // ячейки ходов, подсказка и разбор такта, и сводка тонула в этой каше.
  text tellline hide
  text dayline hide
  text beatline hide
  // ⚠ ЗДЕСЬ ДОЛЖНА ПРЯТАТЬСЯ РАМКА ДИАЛОГА, и её нечем спрятать: у опа
  // clear полей нет ни в валидаторе, ни в рантайме, так что «clear
  // dialogue=off» был тихим отказом — код обещал то, чего не делал.
  // Из-за этого окно перекрывает нижнюю шестую часть сцены весь обмен.
  // Нужен оп сокрытия окна; до него честнее пустая строка, чем ложь.
  // Значения считаем ЗАРАНЕЕ, отдельными переменными: внутри {…} нельзя
  // писать строковый литерал в кавычках — атрибут команды закончится на
  // первой же кавычке.
  lvl_blade = get(aura_lvl, "a_blade", 0)
  lvl_thirst = get(aura_lvl, "a_thirst", 0)
  lvl_shade = get(aura_lvl, "a_shade", 0)
  lvl_might = get(aura_lvl, "a_might", 0)
  lvl_vigor = get(aura_lvl, "a_vigor", 0)
  lvl_will = get(aura_lvl, "a_will", 0)
  cost_blade = aura_cost("a_blade")
  cost_thirst = aura_cost("a_thirst")
  cost_shade = aura_cost("a_shade")
  cost_might = aura_cost("a_might")
  cost_vigor = aura_cost("a_vigor")
  cost_will = aura_cost("a_will")
  lvl_despair = get(aura_lvl, "a_despair", 0)
  cost_despair = aura_cost("a_despair")
  obj id=tr_bg sprite_url="/content/packages/lvn-duel/ui/panel_dark.png" x=50% y=45% width=0.94 height=0.82 anchor="0.5,0.5" z=55
  text tr_h x=50 y=8 size=27 color=#e8dfc8 anchor="0.5,0" «ТВОЙ ПУТЬ · день {day}»
  text tr_s x=50 y=12.5 size=17 color=#c2c8d6 anchor="0.5,0" «Аура занимает такты очереди. Пока копишь — ты открыт и не бьёшь.»
  text tr_s2 x=50 y=15.8 size=16 color=#8f96a8 anchor="0.5,0" «Цвет = редкость: серая → синяя → тёмно-синяя → фиолетовая → малиновая → золотая → алая.»

  // Строка ауры = иконка + полоса владения + подпись. Закрытые не прячем, а
  // ГАСИМ прозрачностью: игрок должен видеть, что ещё бывает на этом пути,
  // иначе ряд выглядит поломанным, а не пустым.
  obj id=tri1 sprite_url="/content/packages/lvn-duel/ui/icon_aura.png" x=0.115 y=23% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + aura_blade_owned * 0.74}"
  obj id=trb1 sprite_url="/content/packages/lvn-duel/ui/bar_back.png" x=0.19 y=24.6% width=0.40 height=0.014 anchor="0,0.5" z=56
  obj id=trf1 sprite_url="/content/packages/lvn-duel/ui/bar_hero.png" x=0.19 y=24.6% width=0.40 height=0.014 anchor="0,0.5" z=57 fill_from=left fill="{lvl_blade / 100}"
  text trt1 x=19 y=20.4 size=18 color=#b28a33 «КЛИНОК · бессмертная · {lvl_blade}% · за {cost_blade} · урон ×2 сквозь щит»

  obj id=tri2 sprite_url="/content/packages/lvn-duel/ui/icon_vampire.png" x=0.115 y=31% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + aura_thirst_owned * 0.74}"
  obj id=trb2 sprite_url="/content/packages/lvn-duel/ui/bar_back.png" x=0.19 y=32.6% width=0.40 height=0.014 anchor="0,0.5" z=56
  obj id=trf2 sprite_url="/content/packages/lvn-duel/ui/bar_foe.png" x=0.19 y=32.6% width=0.40 height=0.014 anchor="0,0.5" z=57 fill_from=left fill="{lvl_thirst / 100}"
  text trt2 x=19 y=28.4 size=18 color=#4b69ff «ЖАЖДА · редкая · {lvl_thirst}% · за {cost_thirst} · 4 такта чужая кровь лечит»

  obj id=tri3 sprite_url="/content/packages/lvn-duel/ui/icon_ghost.png" x=0.115 y=39% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + aura_shade_owned * 0.74}"
  obj id=trb3 sprite_url="/content/packages/lvn-duel/ui/bar_back.png" x=0.19 y=40.6% width=0.40 height=0.014 anchor="0,0.5" z=56
  obj id=trf3 sprite_url="/content/packages/lvn-duel/ui/bar_hero.png" x=0.19 y=40.6% width=0.40 height=0.014 anchor="0,0.5" z=57 fill_from=left fill="{lvl_shade / 100}"
  text trt3 x=19 y=36.4 size=18 color=#8847ff «ТЕНЬ · мистическая · {lvl_shade}% · за {cost_shade} · 3 удара сквозь тебя»

  obj id=tri4 sprite_url="/content/packages/lvn-duel/ui/icon_might.png" x=0.115 y=47% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + aura_might_owned * 0.74}"
  obj id=trb4 sprite_url="/content/packages/lvn-duel/ui/bar_back.png" x=0.19 y=48.6% width=0.40 height=0.014 anchor="0,0.5" z=56
  obj id=trf4 sprite_url="/content/packages/lvn-duel/ui/bar_foe.png" x=0.19 y=48.6% width=0.40 height=0.014 anchor="0,0.5" z=57 fill_from=left fill="{lvl_might / 100}"
  text trt4 x=19 y=44.4 size=18 color=#b0c3d9 «СИЛА · обычная · {lvl_might}% · за {cost_might} · +2 к урону, до конца боя»

  obj id=tri5 sprite_url="/content/packages/lvn-duel/ui/icon_vitality.png" x=0.115 y=55% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + aura_vigor_owned * 0.74}"
  obj id=trb5 sprite_url="/content/packages/lvn-duel/ui/bar_back.png" x=0.19 y=56.6% width=0.40 height=0.014 anchor="0,0.5" z=56
  obj id=trf5 sprite_url="/content/packages/lvn-duel/ui/bar_hero.png" x=0.19 y=56.6% width=0.40 height=0.014 anchor="0,0.5" z=57 fill_from=left fill="{lvl_vigor / 100}"
  text trt5 x=19 y=52.4 size=18 color=#5e98d9 «ЖИЗНЬ · необычная · {lvl_vigor}% · за {cost_vigor} · +3 тела и +1 такт»

  obj id=tri6 sprite_url="/content/packages/lvn-duel/ui/icon_will.png" x=0.115 y=63% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + aura_will_owned * 0.74}"
  obj id=trb6 sprite_url="/content/packages/lvn-duel/ui/bar_back.png" x=0.19 y=64.6% width=0.40 height=0.014 anchor="0,0.5" z=56
  obj id=trf6 sprite_url="/content/packages/lvn-duel/ui/bar_foe.png" x=0.19 y=64.6% width=0.40 height=0.014 anchor="0,0.5" z=57 fill_from=left fill="{lvl_will / 100}"
  text trt6 x=19 y=60.4 size=18 color=#e33b2e «ВОЛЯ · тайная · {lvl_will}% · за {cost_will} · чужая аура не берёт»

  text tr_c1 x=19 y=24.6 size=15 color=#8f96a8 «{cond_blade}»
  text tr_c2 x=19 y=32.6 size=15 color=#8f96a8 «{cond_thirst}»
  text tr_c3 x=19 y=40.6 size=15 color=#8f96a8 «{cond_shade}»
  text tr_c4 x=19 y=48.6 size=15 color=#8f96a8 «{cond_might}»
  text tr_c5 x=19 y=56.6 size=15 color=#8f96a8 «{cond_vigor}»
  text tr_c6 x=19 y=64.6 size=15 color=#8f96a8 «{cond_will}»
  obj id=tri7 sprite_url="/content/packages/lvn-duel/ui/icon_despair.png" x=0.115 y=71% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + aura_despair_owned * 0.74}"
  obj id=trb7 sprite_url="/content/packages/lvn-duel/ui/bar_back.png" x=0.19 y=72.6% width=0.40 height=0.014 anchor="0,0.5" z=56
  obj id=trf7 sprite_url="/content/packages/lvn-duel/ui/bar_foe.png" x=0.19 y=72.6% width=0.40 height=0.014 anchor="0,0.5" z=57 fill_from=left fill="{lvl_despair / 100}"
  text trt7 x=19 y=68.4 size=18 color=#d32ce6 «ОТЧАЯНИЕ · легендарная · {lvl_despair}% · за {cost_despair} · +1 за потерянное сердце»
  text tr_c7 x=19 y=72.6 size=15 color=#8f96a8 «{cond_despair}»
  text tr_7 x=19 y=78 size=18 color=#c9b98a «Навык: {skill} — пробив {break_lvl}%, оглушение {stun_lvl}%»
  obj id=btn_close sprite_url="/content/packages/lvn-duel/ui/icon_close.png" x=50% y=84% width=0.13 height=0.075 anchor="0.5,0.5" z=60 on_click="plan_tree_close"
  -> plan_tree_wait
  :plan_tree_wait
  wait ms=400
  -> plan_tree_wait

  :plan_tree_close
  // ⚠ «clear dialogue=on» — тихий отказ: у clear нет полей.
  obj id=tr_bg show=false
  obj id=btn_close show=false
  obj id=tri1 show=false
  obj id=trb1 show=false
  obj id=trf1 show=false
  obj id=tri2 show=false
  obj id=trb2 show=false
  obj id=trf2 show=false
  obj id=tri3 show=false
  obj id=trb3 show=false
  obj id=trf3 show=false
  obj id=tri4 show=false
  obj id=trb4 show=false
  obj id=trf4 show=false
  obj id=tri5 show=false
  obj id=trb5 show=false
  obj id=trf5 show=false
  obj id=tri6 show=false
  obj id=trb6 show=false
  obj id=trf6 show=false
  text tr_h hide
  text tr_s hide
  text tr_s2 hide
  text tr_c1 hide
  text tr_c2 hide
  text tr_c3 hide
  text tr_c4 hide
  text tr_c5 hide
  text tr_c6 hide
  text tr_c7 hide
  text trt7 hide
  obj id=tri7 show=false
  obj id=trb7 show=false
  obj id=trf7 show=false
  text trt1 hide
  text trt2 hide
  text trt3 hide
  text trt4 hide
  text trt5 hide
  text trt6 hide
  text tr_7 hide
  text tellline x=50 y=27 size=25 color=#c9b98a anchor="0.5,0" «{tell_line}»
  text dayline x=6 y=10.0 size=17 color=#b59a62 «День {day} · обмен {exchange}»
  text beatline x=50 y=23.5 size=26 color=#e8e1d3 anchor="0.5,0" «{beat_line}»
  -> plan_screen

  :plan_autowin
  foe_hp = 0
  duel_outcome = "win"
  buttons_hide()
  slots_hide()
  -> duel_end
  :plan_a_despair
  plan = push(plan, "a_despair")
  plan_icons = push(plan_icons, "icon_despair")
  -> plan_screen
  :plan_reset
  plan = []
  plan_icons = []
  -> plan_screen

  // ── прокрутка очереди ──
  :plan_done
  buttons_hide()
  // ── СЕТЕВОЙ БОЙ ────────────────────────────────────────────────────
  // Против живого игрока «песня врага» не нужна: его ходы приходят с той
  // стороны. Обмен планами идёт ЗДЕСЬ — после того как очередь набрана и
  // до того, как хоть один такт проигран. Раньше нельзя (нечего слать),
  // позже нельзя (первый же такт спросит чужой ход).
  //
  // Оп держит скрипт, пока партнёр думает. Это не задержка, а само
  // правило: одновременный выбор тем и держится, что чужой ход не виден
  // раньше времени, а значит кто-то обязан ждать.
  if duel_net == 1 {
    net_exchange = net_exchange + 1
    net_cell = "обмен:" + net_exchange
    // reveal=all — ящик не откроется, пока не положат ОБА. Это и есть
    // одновременный выбор: механизм общий, а дуэлью его делает только
    // выбранное правило раскрытия.
    ext net_put key_var=net_cell value_var=plan reveal=all
    ext net_get key_var=net_cell into=foe_plan one=1
    // СВЕРКА КАРТИН МИРА перед тем, как проигрывать обмен.
    //
    // Отпечаток нарочно ЗЕРКАЛЬНО-СИММЕТРИЧНЫЙ: моё «duel_hp» — это его
    // «foe_hp», и сравнивать их напрямую бессмысленно, они обязаны быть
    // разными. А вот пара «меньшее и большее» у обоих одна и та же, если
    // картины совпадают. Сам оп добавит к этому зерно и число сделанных
    // бросков — то есть разъехавшуюся случайность поймает тоже.
    net_check_key = "сверка:" + net_exchange
    net_fingerprint = min(duel_hp, foe_hp) + "/" + max(duel_hp, foe_hp) + "|" + min(tempo_mine, tempo_foe) + "/" + max(tempo_mine, tempo_foe)
    ext net_check key_var=net_check_key value_var=net_fingerprint
    if net_desync == 1 {
      Картины боя разошлись — дальше вы играете в разные игры.
      duel_outcome = "затянулась"
      -> duel_end
    }
    if net_error != "" {
      Связь оборвалась: {net_error}.
      duel_outcome = "затянулась"
      -> duel_end
    }
  }
  // Обмен доигрывается сам, репликами не пользуется — рамка последней фразы
  // здесь только мешает: она перекрывает ноги бойца и держит на экране текст,
  // который уже неактуален. Вернётся сама на следующей реплике.
  // ⚠ ЗДЕСЬ ДОЛЖНА ПРЯТАТЬСЯ РАМКА ДИАЛОГА, и её нечем спрятать: у опа
  // clear полей нет ни в валидаторе, ни в рантайме, так что «clear
  // dialogue=off» был тихим отказом — код обещал то, чего не делал.
  // Из-за этого окно перекрывает нижнюю шестую часть сцены весь обмен.
  // Нужен оп сокрытия окна; до него честнее пустая строка, чем ложь.
  tell_line = ""
  beat = 0
  while beat < len(plan) && duel_outcome == "" {
    my_move = get(plan, beat, "block")
    beat_pos = pat_idx(foe_step, len(foe_song))
    // ВЛОЖЕННО, А НЕ «} else if {»: такой формы в языке нет, и строка
    // «} else if foe_stun >= 1 {» молча превратилась бы в РЕПЛИКУ — игрок
    // услышал бы кусок исходника, а ветка стана исчезла бы. Компилятор это
    // не ошибка, а предупреждение о несбалансированной скобке в тексте.
    if duel_net == 1 {
      // Живой соперник: его такт — из присланной очереди. Не хватило
      // длины (он набрал короче) — стоит в блоке, а не бьёт: недобор не
      // должен наказывать того, кто просто спланировал меньше.
      foe_move = get(foe_plan, beat, "block")
    } else {
      if foe_stun >= 1 {
        foe_move = "stunned"
        foe_stun = foe_stun - 1
      } else {
        foe_move = foe_now()
        beat_pos = pat_idx(foe_step, len(foe_song))
        foe_step = foe_step + 1
      }
    }
    resolve_beat()

    // ─── ТАКТ ИГРАЕТСЯ В ТРИ СТАДИИ ───────────────────────────────────
    // Раньше поза, урон, эффекты и текст выставлялись ОДНОЙ пачкой команд:
    // всё происходило в одном кадре, и удар «проскакивал» — эффект успевал
    // мигнуть на долю секунды, а прочитать обмен было невозможно. Теперь у
    // такта есть замах, попадание и отдача, разделённые паузами.

    beat_line = ""
    // Рана прошлого такта отсчитала своё — снимаем плавно, чтобы кадр не
    // моргал на стыке.
    fx blood=0 dur=0.6

    // Стадия 1 — ЗАМАХ: видно, кто что делает, до того как посчитан урон.
    hands_pose = "idle"
    if my_move == "block" {
      hands_pose = "block"
    } else {
      hands_pose = "attack"
    }
    hands(hands_pose)
    // Камера участвует в замахе. Удар — медленный увод влево-вниз: корпус
    // разворачивается, клинок уходит за спину. Блок — короткий отвод вправо,
    // как будто закрываешься плечом. Это не украшение: между «выбрал» и
    // «случилось» раньше не происходило ничего, и такт читался как склейка.
    // Камера уводит КОРПУС, поворот спрайта — КИСТИ. Вместе это читается как
    // одно движение тела, а не как сдвиг картинки: клинок заваливается в ту
    // же сторону, куда уходит взгляд.
    if my_move == "block" {
      bg3d yaw=7 pitch={cam_swing_block} dur=0.3
      obj id=duel_hands rotation=12
    } else {
    }
    if my_move == "strike" {
      bg3d yaw=-10 pitch={cam_swing_strike} dur=0.42
      obj id=duel_hands rotation=-15
    } else {
    }
    if my_move == "break" {
      bg3d yaw=-12 pitch={cam_swing_break} dur=0.42
      obj id=duel_hands rotation=-18
    } else {
    }
    if my_move == "stun" {
      bg3d yaw=-9 pitch={cam_swing_stun} dur=0.42
      obj id=duel_hands rotation=-13
    } else {
    }
    foe_pose_now = "idle"
    if foe_move == "stunned" {
      foe_pose_now = "stun"
    } else {
    }
    if foe_move == "strike" {
      foe_pose_now = "attack"
    } else {
    }
    if foe_move == "block" {
      foe_pose_now = "block"
    } else {
    }
    foe_sprite(foe_pose_now)
    wait ms=260

    // Стадия 2 — ПОПАДАНИЕ: поза раненого ПЕРВОЙ, эффекты после неё.
    // Порядок принципиален: смена картинки пересоздаёт слои спрайта, и
    // шейдер, наложенный до неё, слетает вместе со старыми слоями — на
    // скелете эффект просто не появлялся.
    // «Раненый» — ТОЛЬКО когда досталось ему одному. В размене оба попали,
    // и он остаётся в замахе: поза должна отвечать на вопрос «что он делал»,
    // а не «сколько потерял» — потери и так видны полосой.
    // Возврат РЕЗКИЙ и без перехода: замах копил, удар разряжает. Именно на
    // этом кадре меняется поза и бьют эффекты — совпадение обязательно,
    // иначе движение читается отдельно от удара.
    bg3d yaw=0 pitch={cam_tilt} dur=0
    obj id=duel_hands rotation=0
    if dmg_foe > 0 && dmg_me == 0 {
      foe_sprite("hurt")
    } else {
      // Он бил — показываем ВТОРОЙ кадр удара: замах уже отыгран в стадии 1,
      // здесь клинок доходит. Два кадра подряд читаются как одно движение,
      // один — как поза, в которой он завис.
      if foe_move == "strike" {
        foe_sprite("strike")
      } else {
      }
      if foe_move == "break" {
        foe_sprite("strike")
      } else {
      }
      if foe_move == "block" {
        foe_sprite("block2")
      } else {
      }
    }
    // Пауза после смены позы — не эстетика, а необходимость: новый арт
    // грузится асинхронно, слои пересоздаются, и эффект, наложенный в тот же
    // кадр, слетает вместе со старыми слоями.
    wait ms=140
    beat_feedback()
    foe_bar()
    hero_bar()
    wait ms=420
    // Камера выпрямляется. Команда безусловная: если такт не гнул её, она
    // просто подтверждает покой — дешевле, чем помнить, гнули или нет.
    bg3d pitch={cam_tilt} dur=0.55

    // Стадия 3 — ИТОГ ТАКТА: ячейки залиты цветом.
    // Зелёный — такт твой, красный — его, жёлтый — размен или пустой обмен.
    //
    // Ряд его ходов уже построен ПРЕДПОКАЗОМ, дописывать в него нельзя: старый
    // `вскрыть_ход()` делал push и удлинял список на каждом такте — оттого
    // ячейки и съезжали. Здесь только две правки: запомнить увиденную позицию
    // песни навсегда и, если он оглушён, показать это вместо задуманного хода.
    learned = put(learned, foe_name + "#" + beat_pos, 1)
    if foe_move == "stunned" {
      revealed = put(revealed, beat, "icon_stun")
    } else {
    }
    if dmg_foe > 0 && dmg_me == 0 {
      outcomes = push(outcomes, "cell_win")
    } else {
      if dmg_me > 0 && dmg_foe == 0 {
        outcomes = push(outcomes, "cell_lose")
      } else {
        outcomes = push(outcomes, "cell_draw")
      }
    }
    beat_line = "Такт " + (beat + 1) + " · " + get(icon, my_move, "?") + " × " + get(icon, foe_move, "?") + " — " + beat_note
    slots_draw()
    // Обмен доигрывается САМ: план на то и план, чтобы смотреть его целиком,
    // а не перелистывать по такту. 1.7 с — время прочитать оба ряда и увидеть,
    // где угадал, а где подставился.
    wait ms=1200

    // Стадия 4 — ОСТЫВАНИЕ. Такт гасит СВОИ эффекты сам, а не сваливает
    // уборку на следующий: если ударом кончился весь план (или бой), гасить
    // было уже некому — скелет так и оставался белым до конца сцены. Позы
    // тоже возвращаются к базовым: иначе следующая засветка не читается как
    // новое событие. Аура ярости не трогается — это состояние боя, не такт.
    sfx id=duel_enemy flash=0 outline=0 shake=0 hologram=0 runes=0 dur=0.12
    sfx id=duel_hands flash=0 outline=0 shake=0 tint=0 rim=0 glow=0 lightning=0 dur=0.12
    // Виньетка возвращается к базовой, а не в ноль: это постоянная оптика боя.
    // Гасим всё, что зажёг такт, — КРОМЕ раны: она живёт дольше такта и
    // снимается уже в следующем, отсчитав свои три секунды.
    fx speedlines=0 shockwave=0 distort=0 chromatic=0 blink=0 frost=0 vignette=0 bloom=0 rays=0 invert=0 tint=0 dur=0.15
    foe_sprite("idle")
    hands("idle")
    wait ms=500
    tempo_lesson()
    beat = beat + 1
  }
  slots_hide()
  foe_sprite("idle")
  hands("idle")
  if duel_outcome != "" -> duel_end

  // ── ярость: вторая строфа паттерна ──
  if foe_phase == 1 && foe_hp * 2 <= foe_hp_max -> duel_rage
  -> duel_recap
  :duel_rage
  foe_phase = 2
  foe_song = foe_song_rage
  foe_step = 0
  foe_sprite("attack")
  // Ярость меняет НАСТРОЙКУ кадра, а не мигает поверх него: виньетка
  // сжимается, свет уходит в холод, зерно грубеет — и остаётся так до конца
  // боя, потому что это новое состояние, а не событие на полсекунды.
  fx vignette=0.35 dur=0.5
  // Аура остаётся на нём до конца боя: смена состояния читается по САМОЙ
  // фигуре, а не только по тону кадра.
  sfx id=duel_enemy aura=0.9 aura_style=shadow aura_color=#7a2b4d aura_size=1.2 dur=0.6
  camera action=shake amplitude=0.03 duration=0.5
  Скелет ЗВЕРЕЕТ — песня меняется!
  foe_sprite("idle")
  -> duel_recap

  :duel_recap
  -> duel_exchange

  // ── затянувшийся бой ──
  :duel_draw
  duel_outcome = "затянулась"
  Силы кончились раньше жизней. Вы расходитесь.
  -> duel_end

  // ── занавес ──
  :duel_end
  tell_line = ""
  // Граница сцены: от боя не должно остаться ничего. Одна команда вместо
  // двух десятков «спрячь по имени» — забыть тут нечего.
  // ⚠ То же самое: «clear all=1» ничего не чистил — у clear нет полей.
  text dayline hide
  text foe_num hide
  text hero_num hide
  text tellline hide
  bars_hide()
  arsenal_hide()
  fx vignette=0 dur=0.5
  sfx id=duel_enemy off
  sfx id=duel_hands off
  buttons_hide()
  slots_hide()
  if duel_outcome == "win" -> end_alive
  obj id=duel_enemy show=false
  -> end_done
  :end_alive
  // кости остаются лежать до смены сцены — как в EC
  foe_sprite("hurt")
  -> end_done
  :end_done
  obj id=duel_hands show=false
}
