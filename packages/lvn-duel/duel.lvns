  // Подписи рядов: без них два одинаковых ряда читаются как один блок.
  text rowfoe x=4 y=8.6 size=13 color=#f0765e anchor="0,0" «ОН»
  text rowme x=4 y=16.6 size=13 color=#73b8ee anchor="0,0" «ТЫ»
  // Разбор такта — реактивным лейблом, а не репликой: реплика ждала бы тапа и
  // снова разбила бы обмен на перелистывание. Текст держится ровно паузу такта.
  text beatline x=50 y=23.5 size=26 color=#e8e1d3 anchor="0.5,0" «{beat_line}»
  obj id=fs1 sprite_url="/content/packages/lvn-duel/ui/{outcome_icon(0)}.png" x="{cell_x(0)}" y=9% width=0.085 height=0.05 anchor="0.5,0.5" z=39
  obj id=fi1 sprite_url="/content/packages/lvn-duel/ui/{their_icon(0)}.png" x="{cell_x(0)}" y=9% width=0.07 height=0.04 anchor="0.5,0.5" z=41
