  // ПРИЗРАК урона (приём из Dota): тот же спрайт, бледнее и ПОД основной
  // заливкой. Едет к той же доле, но втрое дольше — глаз успевает прочитать,
  // сколько именно отняли, даже когда удар прошёл за долю секунды.
  obj id=foe_bar_ghost sprite_url="/content/packages/lvn-uikit/ui/bar_fill_hp.png" x=0.075 y=0.875 width=0.380 height=0.025 anchor="0,0.5" z=30 opacity=0.4 fill_from=left
  obj id=foe_bar_fill sprite_url="/content/packages/lvn-uikit/ui/bar_fill_hp.png" x=0.075 y=0.875 width=0.380 height=0.025 anchor="0,0.5" z=31 fill_from=left
  anim id=foe_bar_fill prop=fill to="{max(foe_hp, 0) / max(foe_hp_max, 1)}" dur=0.25 ease=outCubic
  anim id=foe_bar_ghost prop=fill to="{max(foe_hp, 0) / max(foe_hp_max, 1)}" dur=0.9 ease=inOutSine
}

