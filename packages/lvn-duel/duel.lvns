  } else {
  }
  if аура_сила_откр == 1 {
    obj id=btn_a4 sprite_url="/content/packages/lvn-duel/ui/icon_might.png" x=0.475 y=65% width=0.082 height=0.05 anchor="0.5,0.5" z=40 on_click="дп_засила"
  } else {
