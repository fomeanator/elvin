  obj id=trb7 sprite_url="/content/packages/lvn-duel/ui/bar_back.png" x=0.19 y=72.6% width=0.40 height=0.014 anchor="0,0.5" z=56
  obj id=trf7 sprite_url="/content/packages/lvn-duel/ui/bar_foe.png" x=0.19 y=72.6% width=0.40 height=0.014 anchor="0,0.5" z=57 fill_from=left fill="{вл_отчаяние / 100}"
  text trt7 x=19 y=68.4 size=18 color=#d32ce6 «ОТЧАЯНИЕ · легендарная · {вл_отчаяние}% · за {ц_отчаяние} · +1 за потерянное сердце»
  text tr_c7 x=19 y=72.6 size=15 color=#8f96a8 «{усл_отчаяние}»
  text tr_7 x=19 y=78 size=18 color=#c9b98a «Навык: {навык} — пробив {влад_пробив}%, оглушение {влад_оглушение}%»
  obj id=btn_close sprite_url="/content/packages/lvn-duel/ui/icon_close.png" x=50% y=84% width=0.13 height=0.075 anchor="0.5,0.5" z=60 on_click="дп_дерево_закрыть"
  -> дп_дерево_ждём
  :дп_дерево_ждём
  wait ms=400
  -> дп_дерево_ждём

  :дп_дерево_закрыть
  // ⚠ «clear dialogue=on» — тихий отказ: у clear нет полей.
  obj id=tr_bg show=false
  obj id=btn_close show=false
  obj id=tri1 show=false
  obj id=trb1 show=false
  obj id=trf1 show=false
  obj id=tri2 show=false
  obj id=trb2 show=false
  obj id=trf2 show=false
  obj id=tri3 show=false
  obj id=trb3 show=false
  obj id=trf3 show=false
  obj id=tri4 show=false
  obj id=trb4 show=false
  obj id=trf4 show=false
  obj id=tri5 show=false
  obj id=trb5 show=false
  obj id=trf5 show=false
  obj id=tri6 show=false
  obj id=trb6 show=false
  obj id=trf6 show=false
  text tr_h hide
  text tr_s hide
  text tr_s2 hide
  text tr_c1 hide
  text tr_c2 hide
  text tr_c3 hide
  text tr_c4 hide
  text tr_c5 hide
  text tr_c6 hide
  text tr_c7 hide
  text trt7 hide
  obj id=tri7 show=false
  obj id=trb7 show=false
  obj id=trf7 show=false
  text trt1 hide
  text trt2 hide
  text trt3 hide
  text trt4 hide
  text trt5 hide
  text trt6 hide
  text tr_7 hide
  text tellline x=50 y=27 size=25 color=#c9b98a anchor="0.5,0" «{тычок_текст}»
  text dayline x=6 y=10.0 size=17 color=#b59a62 «День {день} · обмен {обмен}»
  text beatline x=50 y=23.5 size=26 color=#e8e1d3 anchor="0.5,0" «{бит_текст}»
  -> дп_план

  :дп_автопобеда
  враг_хп = 0
  дуэль_исход = "победа"
  buttons_hide()
  slots_hide()
  -> дт_итог
  :дп_заотчаяние
  план = push(план, "з_отчаяние")
  планфайлы = push(планфайлы, "icon_despair")
  -> дп_план
  :дп_сброс
  план = []
  планфайлы = []
  -> дп_план

  // ── прокрутка очереди ──
  :дп_готово
  buttons_hide()
  // ── СЕТЕВОЙ БОЙ ────────────────────────────────────────────────────
  // Против живого игрока «песня врага» не нужна: его ходы приходят с той
  // стороны. Обмен планами идёт ЗДЕСЬ — после того как очередь набрана и
  // до того, как хоть один такт проигран. Раньше нельзя (нечего слать),
  // позже нельзя (первый же такт спросит чужой ход).
  //
  // Оп держит скрипт, пока партнёр думает. Это не задержка, а само
  // правило: одновременный выбор тем и держится, что чужой ход не виден
  // раньше времени, а значит кто-то обязан ждать.
  if дуэль_сеть == 1 {
    сеть_обмен = сеть_обмен + 1
    сеть_ящик = "обмен:" + сеть_обмен
    // reveal=all — ящик не откроется, пока не положат ОБА. Это и есть
    // одновременный выбор: механизм общий, а дуэлью его делает только
    // выбранное правило раскрытия.
    ext net_put key_var=сеть_ящик value_var=план reveal=all
    ext net_get key_var=сеть_ящик into=враг_план one=1
    // СВЕРКА КАРТИН МИРА перед тем, как проигрывать обмен.
    //
    // Отпечаток нарочно ЗЕРКАЛЬНО-СИММЕТРИЧНЫЙ: моё «дуэль_хп» — это его
    // «враг_хп», и сравнивать их напрямую бессмысленно, они обязаны быть
    // разными. А вот пара «меньшее и большее» у обоих одна и та же, если
    // картины совпадают. Сам оп добавит к этому зерно и число сделанных
    // бросков — то есть разъехавшуюся случайность поймает тоже.
    сеть_сверка = "сверка:" + сеть_обмен
    сеть_отпечаток = min(дуэль_хп, враг_хп) + "/" + max(дуэль_хп, враг_хп) + "|" + min(темп_мой, темп_врага) + "/" + max(темп_мой, темп_врага)
    ext net_check key_var=сеть_сверка value_var=сеть_отпечаток
    if net_desync == 1 {
      Картины боя разошлись — дальше вы играете в разные игры.
      дуэль_исход = "затянулась"
      -> дт_итог
    }
    if net_error != "" {
      Связь оборвалась: {net_error}.
      дуэль_исход = "затянулась"
      -> дт_итог
    }
  }
  // Обмен доигрывается сам, репликами не пользуется — рамка последней фразы
  // здесь только мешает: она перекрывает ноги бойца и держит на экране текст,
  // который уже неактуален. Вернётся сама на следующей реплике.
  // ⚠ ЗДЕСЬ ДОЛЖНА ПРЯТАТЬСЯ РАМКА ДИАЛОГА, и её нечем спрятать: у опа
  // clear полей нет ни в валидаторе, ни в рантайме, так что «clear
  // dialogue=off» был тихим отказом — код обещал то, чего не делал.
  // Из-за этого окно перекрывает нижнюю шестую часть сцены весь обмен.
  // Нужен оп сокрытия окна; до него честнее пустая строка, чем ложь.
  тычок_текст = ""
  такт = 0
  while такт < len(план) && дуэль_исход == "" {
    мой_ход = get(план, такт, "блок")
    такт_поз = pat_idx(враг_шаг, len(враг_паттерн))
    // ВЛОЖЕННО, А НЕ «} else if {»: такой формы в языке нет, и строка
    // «} else if враг_стан >= 1 {» молча превратилась бы в РЕПЛИКУ — игрок
    // услышал бы кусок исходника, а ветка стана исчезла бы. Компилятор это
    // не ошибка, а предупреждение о несбалансированной скобке в тексте.
    if дуэль_сеть == 1 {
      // Живой соперник: его такт — из присланной очереди. Не хватило
      // длины (он набрал короче) — стоит в блоке, а не бьёт: недобор не
      // должен наказывать того, кто просто спланировал меньше.
      его_ход = get(враг_план, такт, "блок")
    } else {
      if враг_стан >= 1 {
        его_ход = "стан"
        враг_стан = враг_стан - 1
      } else {
        его_ход = foe_now()
        такт_поз = pat_idx(враг_шаг, len(враг_паттерн))
        враг_шаг = враг_шаг + 1
      }
    }
    resolve_beat()

    // ─── ТАКТ ИГРАЕТСЯ В ТРИ СТАДИИ ───────────────────────────────────
    // Раньше поза, урон, эффекты и текст выставлялись ОДНОЙ пачкой команд:
    // всё происходило в одном кадре, и удар «проскакивал» — эффект успевал
    // мигнуть на долю секунды, а прочитать обмен было невозможно. Теперь у
    // такта есть замах, попадание и отдача, разделённые паузами.

    бит_текст = ""
    // Рана прошлого такта отсчитала своё — снимаем плавно, чтобы кадр не
    // моргал на стыке.
    fx blood=0 dur=0.6

    // Стадия 1 — ЗАМАХ: видно, кто что делает, до того как посчитан урон.
    поза_рук = "idle"
    if мой_ход == "блок" {
      поза_рук = "block"
    } else {
      поза_рук = "attack"
    }
    hands(поза_рук)
    // Камера участвует в замахе. Удар — медленный увод влево-вниз: корпус
    // разворачивается, клинок уходит за спину. Блок — короткий отвод вправо,
    // как будто закрываешься плечом. Это не украшение: между «выбрал» и
    // «случилось» раньше не происходило ничего, и такт читался как склейка.
    // Камера уводит КОРПУС, поворот спрайта — КИСТИ. Вместе это читается как
    // одно движение тела, а не как сдвиг картинки: клинок заваливается в ту
    // же сторону, куда уходит взгляд.
    if мой_ход == "блок" {
      bg3d yaw=7 pitch={кам_замах_блок} dur=0.3
      obj id=duel_hands rotation=12
    } else {
    }
    if мой_ход == "удар" {
      bg3d yaw=-10 pitch={кам_замах_удар} dur=0.42
      obj id=duel_hands rotation=-15
    } else {
    }
    if мой_ход == "пробив" {
      bg3d yaw=-12 pitch={кам_замах_пробив} dur=0.42
      obj id=duel_hands rotation=-18
    } else {
    }
    if мой_ход == "оглушение" {
      bg3d yaw=-9 pitch={кам_замах_оглуш} dur=0.42
      obj id=duel_hands rotation=-13
    } else {
    }
    поза_врага = "idle"
    if его_ход == "стан" {
      поза_врага = "stun"
    } else {
    }
    if его_ход == "удар" {
      поза_врага = "attack"
    } else {
    }
    if его_ход == "блок" {
      поза_врага = "block"
    } else {
    }
    foe_sprite(поза_врага)
    wait ms=260

    // Стадия 2 — ПОПАДАНИЕ: поза раненого ПЕРВОЙ, эффекты после неё.
    // Порядок принципиален: смена картинки пересоздаёт слои спрайта, и
    // шейдер, наложенный до неё, слетает вместе со старыми слоями — на
    // скелете эффект просто не появлялся.
    // «Раненый» — ТОЛЬКО когда досталось ему одному. В размене оба попали,
    // и он остаётся в замахе: поза должна отвечать на вопрос «что он делал»,
    // а не «сколько потерял» — потери и так видны полосой.
    // Возврат РЕЗКИЙ и без перехода: замах копил, удар разряжает. Именно на
    // этом кадре меняется поза и бьют эффекты — совпадение обязательно,
    // иначе движение читается отдельно от удара.
    bg3d yaw=0 pitch={кам_наклон} dur=0
    obj id=duel_hands rotation=0
    if урон_ему > 0 && урон_мне == 0 {
      foe_sprite("hurt")
    } else {
      // Он бил — показываем ВТОРОЙ кадр удара: замах уже отыгран в стадии 1,
      // здесь клинок доходит. Два кадра подряд читаются как одно движение,
      // один — как поза, в которой он завис.
      if его_ход == "удар" {
        foe_sprite("strike")
      } else {
      }
      if его_ход == "пробив" {
        foe_sprite("strike")
      } else {
      }
      if его_ход == "блок" {
        foe_sprite("block2")
      } else {
      }
    }
    // Пауза после смены позы — не эстетика, а необходимость: новый арт
    // грузится асинхронно, слои пересоздаются, и эффект, наложенный в тот же
    // кадр, слетает вместе со старыми слоями.
    wait ms=140
    beat_feedback()
    foe_bar()
    hero_bar()
    wait ms=420
    // Камера выпрямляется. Команда безусловная: если такт не гнул её, она
    // просто подтверждает покой — дешевле, чем помнить, гнули или нет.
    bg3d pitch={кам_наклон} dur=0.55

    // Стадия 3 — ИТОГ ТАКТА: ячейки залиты цветом.
    // Зелёный — такт твой, красный — его, жёлтый — размен или пустой обмен.
    //
    // Ряд его ходов уже построен ПРЕДПОКАЗОМ, дописывать в него нельзя: старый
    // `вскрыть_ход()` делал push и удлинял список на каждом такте — оттого
    // ячейки и съезжали. Здесь только две правки: запомнить увиденную позицию
    // песни навсегда и, если он оглушён, показать это вместо задуманного хода.
    знание = put(знание, враг_имя + "#" + такт_поз, 1)
    if его_ход == "стан" {
      вскрыто = put(вскрыто, такт, "icon_stun")
    } else {
    }
    if урон_ему > 0 && урон_мне == 0 {
      итоги = push(итоги, "cell_win")
    } else {
      if урон_мне > 0 && урон_ему == 0 {
        итоги = push(итоги, "cell_lose")
      } else {
        итоги = push(итоги, "cell_draw")
      }
    }
    бит_текст = "Такт " + (такт + 1) + " · " + get(икона, мой_ход, "?") + " × " + get(икона, его_ход, "?") + " — " + бит_суть
    slots_draw()
    // Обмен доигрывается САМ: план на то и план, чтобы смотреть его целиком,
    // а не перелистывать по такту. 1.7 с — время прочитать оба ряда и увидеть,
    // где угадал, а где подставился.
    wait ms=1200

    // Стадия 4 — ОСТЫВАНИЕ. Такт гасит СВОИ эффекты сам, а не сваливает
    // уборку на следующий: если ударом кончился весь план (или бой), гасить
    // было уже некому — скелет так и оставался белым до конца сцены. Позы
    // тоже возвращаются к базовым: иначе следующая засветка не читается как
    // новое событие. Аура ярости не трогается — это состояние боя, не такт.
    sfx id=duel_enemy flash=0 outline=0 shake=0 hologram=0 runes=0 dur=0.12
    sfx id=duel_hands flash=0 outline=0 shake=0 tint=0 rim=0 glow=0 lightning=0 dur=0.12
    // Виньетка возвращается к базовой, а не в ноль: это постоянная оптика боя.
    // Гасим всё, что зажёг такт, — КРОМЕ раны: она живёт дольше такта и
    // снимается уже в следующем, отсчитав свои три секунды.
    fx speedlines=0 shockwave=0 distort=0 chromatic=0 blink=0 frost=0 vignette=0 bloom=0 rays=0 invert=0 tint=0 dur=0.15
    foe_sprite("idle")
    hands("idle")
    wait ms=500
    урок_темпа()
    такт = такт + 1
  }
  slots_hide()
  foe_sprite("idle")
  hands("idle")
  if дуэль_исход != "" -> дт_итог

  // ── ярость: вторая строфа паттерна ──
  if враг_фаза == 1 && враг_хп * 2 <= враг_хп_макс -> дт_ярость
  -> дт_сводка
  :дт_ярость
  враг_фаза = 2
  враг_паттерн = враг_паттерн2
  враг_шаг = 0
  foe_sprite("attack")
  // Ярость меняет НАСТРОЙКУ кадра, а не мигает поверх него: виньетка
  // сжимается, свет уходит в холод, зерно грубеет — и остаётся так до конца
  // боя, потому что это новое состояние, а не событие на полсекунды.
  fx vignette=0.35 dur=0.5
  // Аура остаётся на нём до конца боя: смена состояния читается по САМОЙ
  // фигуре, а не только по тону кадра.
  sfx id=duel_enemy aura=0.9 aura_style=shadow aura_color=#7a2b4d aura_size=1.2 dur=0.6
  camera action=shake amplitude=0.03 duration=0.5
  Скелет ЗВЕРЕЕТ — песня меняется!
  foe_sprite("idle")
  -> дт_сводка

  :дт_сводка
  -> дт_обмен

  // ── затянувшийся бой ──
  :дт_ничья
  дуэль_исход = "затянулась"
  Силы кончились раньше жизней. Вы расходитесь.
  -> дт_итог

  // ── занавес ──
  :дт_итог
  тычок_текст = ""
  // Граница сцены: от боя не должно остаться ничего. Одна команда вместо
  // двух десятков «спрячь по имени» — забыть тут нечего.
  // ⚠ То же самое: «clear all=1» ничего не чистил — у clear нет полей.
  text dayline hide
  text foe_num hide
  text hero_num hide
  text tellline hide
  bars_hide()
  arsenal_hide()
  fx vignette=0 dur=0.5
  sfx id=duel_enemy off
  sfx id=duel_hands off
  buttons_hide()
  slots_hide()
  if дуэль_исход == "победа" -> ди_жив
  obj id=duel_enemy show=false
  -> ди_готово
  :ди_жив
  // кости остаются лежать до смены сцены — как в EC
  foe_sprite("hurt")
  -> ди_готово
  :ди_готово
  obj id=duel_hands show=false
}
