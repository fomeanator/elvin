  obj id=tri6 sprite_url="/content/packages/lvn-duel/ui/icon_will.png" x=0.115 y=63% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + аура_воля_откр * 0.74}"
