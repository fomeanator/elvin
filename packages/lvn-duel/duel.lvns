  text trt3 x=19 y=36.4 size=18 color=#8847ff «ТЕНЬ · мистическая · {вл_тень}% · за {ц_тень} · 3 удара сквозь тебя»

  obj id=tri4 sprite_url="/content/packages/lvn-duel/ui/icon_might.png" x=0.115 y=47% width=0.078 height=0.048 anchor="0.5,0.5" z=57 opacity="{0.26 + аура_сила_откр * 0.74}"
