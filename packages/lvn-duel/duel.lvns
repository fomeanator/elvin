  text trt6 x=19 y=60.4 size=18 color=#e33b2e «ВОЛЯ · тайная · {вл_воля}% · за {ц_воля} · чужая аура не берёт»

  text tr_c1 x=19 y=24.6 size=15 color=#8f96a8 «{усл_меч}»
  text tr_c2 x=19 y=32.6 size=15 color=#8f96a8 «{усл_кровь}»
  text tr_c3 x=19 y=40.6 size=15 color=#8f96a8 «{усл_тень}»
  text tr_c4 x=19 y=48.6 size=15 color=#8f96a8 «{усл_сила}»
  text tr_c5 x=19 y=56.6 size=15 color=#8f96a8 «{усл_жизнь}»
  text tr_c6 x=19 y=64.6 size=15 color=#8f96a8 «{усл_воля}»
