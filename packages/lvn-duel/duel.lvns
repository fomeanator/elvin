// HUD владения навыком — рисуется один раз, проценты и ступень реактивны
// ═══════════════════════════════════════════════════════════════════
//  3b. АРСЕНАЛ СТОРОН — иконки под полосами
// ═══════════════════════════════════════════════════════════════════
// Игрок должен видеть, ЧЕМ противник вообще умеет драться, иначе первый бой
// с новым врагом — угадывание вслепую (тычок подсказывает лишь один такт).
// Слева — арсенал скелета, справа — твой; открытый навык добавляется в ряд
// и несёт СВОЙ процент владения прямо на иконке.

func arsenal_show() {
  // враг: чем он оперирует
  obj id=foe_ars1 sprite_url="/content/packages/lvn-duel/ui/icon_strike.png" x=0.155 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  obj id=foe_ars2 sprite_url="/content/packages/lvn-duel/ui/icon_block.png" x=0.225 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  // герой: база всегда, навык — по открытию
  obj id=hero_ars1 sprite_url="/content/packages/lvn-duel/ui/icon_strike.png" x=0.595 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  obj id=hero_ars2 sprite_url="/content/packages/lvn-duel/ui/icon_block.png" x=0.665 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  if skill == "stun" -> arsenal_stun
  if skill == "break" -> arsenal_break
  obj id=hero_ars3 show=false
  text hero_ars3_pct hide
  -> arsenal_done
  :arsenal_stun
  obj id=hero_ars3 sprite_url="/content/packages/lvn-duel/ui/icon_stun.png" x=0.735 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  // процент владения — НА иконке, а не отдельной строкой сбоку
  text hero_ars3_pct x=73.5 y=94.8 size=15 color=#ffffff anchor="0.5,0" «{stun_lvl}%»
  -> arsenal_done
  :arsenal_break
  obj id=hero_ars3 sprite_url="/content/packages/lvn-duel/ui/icon_break.png" x=0.735 y=0.937 width=0.062 height=0.035 anchor="0.5,0.5" z=32
  text hero_ars3_pct x=73.5 y=94.8 size=15 color=#ffffff anchor="0.5,0" «{break_lvl}%»
  -> arsenal_done
  :arsenal_done
}

