// ═══════════════════════════════════════════════════════════════════
// «Рыцарь одного дня» — ДУЭЛЬ-ИНКРЕМЕНТОР (боевое ядро v2, прототип)
// ═══════════════════════════════════════════════════════════════════
// Подключается главой:  include "duel.lvns"   и вызывается:  duel()
//
// ИДЕЯ (решение владельца, 2026-07-31): оба бойца планируют очередь
// действий ВСЛЕПУЮ, потом очередь прокручивается такт за тактом. С каждым
// обменом очередь растёт: 1 такт → 2 → 3 → ... → кап 5. Враг ходит по
// детерминированному паттерну (модель Punch-Out, как в EC и combat.lvns —
// ни одного rand() в исходах). Обучение — прямо в бою: паттерн держишь
// в голове, тычок подсказывает только ПЕРВЫЙ такт обмена.
//
// ─── Матрица такта (мой ход × его ход) ─────────────────────────────
//   удар × удар   — размен: у кого темпа больше, тот бьёт ПЕРВЫМ на 2
//                   (темп сгорает в 0); ответ гасится, если первый удар
//                   смертелен. При равном темпе — честный размен 1:1.
//   удар × блок   — удар съеден, ЗАЩИТНИК копит +1 темп.
//   блок × удар   — то же в мою пользу: +1 темп мне.
//   блок × блок   — пустой такт, оба переводят дыхание.
//   Темп — экономика боя: блок его удара кладёт темп в банк, размен
//   темп тратит. Вечный блок не выигрывает (урона нет), вечный удар
//   кормит его банк — играть приходится ПО ПАТТЕРНУ.
//
// ─── Навыки (занимают такт очереди, владение в %) ──────────────────
//   💫 ОГЛУШЕНИЕ против его удара: если темпа хватает (ступень I: 2,
//      II+: 1) — удар отменён, враг пропускает следующий такт (III: два).
//      Темп тратится. Против блока / без темпа — в молоко (я открыт: −1).
//   🔨 ПРОБИВ против его блока: −2 сквозь щит (III: −3), +1 темп, крит.
//      Против его удара — я раскрыт: −2 мне (II+: −1).
//   Опыт владения по заслугам: в молоко +1, эффект/урон +3, крит +6.
//   Ступень = 1 + floor(владение / 25), потолок IV (75%+ — числа
//   ступени III, дизайн IV добавим после плейтеста).
//
// ─── Контракт вызова (выставляет глава) ────────────────────────────
//   дуэль_хп, дуэль_хп_макс     — герой (сгорают со смертью дня)
//   враг_хп, враг_хп_макс       — противник
//   враг_имя                    — подпись для HUD
//   враг_паттерн, враг_паттерн2 — его песня и песня ярости (list)
//   враг_окраска                — "" | "щит" | "лютый" | "пробой"
//   враг_даль                   — сколько метров до него по тропе
//   враг_рост                   — рост фигуры В МЕТРАХ (1.9 — человек)
//   день                        — номер дня (для HUD)
//   навык                       — "" | "оглушение" | "пробив"
//   влад_оглушение, влад_пробив — владение в %; ПЕРЕЖИВАЕТ смерть дня:
//                                 тело сгорает, руки помнят
// После дуэли глава читает:
//   дуэль_исход = "победа" | "пал" | "затянулась"
//
// Фон ставит глава — просто чтобы модуль не решал за неё, как выглядит место.

// ═══════════════════════════════════════════════════════════════════
//  1. ДАННЫЕ ВРАГА — паттерны как таблицы (новый враг = новые списки)
// ═══════════════════════════════════════════════════════════════════
// Паттерн живёт СКВОЗЬ обмены: шаг не сбрасывается между планированиями,
// игрок запоминает одну длинную песню, а не куплеты. Оглушённый такт
// паттерн НЕ сдвигает — после стана враг продолжает с того же места.
// Ярость (хп ≤ половины) меняет паттерн и сбрасывает шаг — об этом
// говорит явная реплика, это не подлость, а вторая строфа.

// иконки действий — строка такта показывает ОБА хода, читается с одного взгляда
// Названия действий для строки такта. Не эмодзи: у шрифта движка нет глифов
// ⚔🛡💫🔨 — вместо них рисуется пустой квадрат, и строка боя читается как
// «ты □ × он □». Слова читаются с одного взгляда и переживают любой шрифт.
икона = {}
икона = put(икона, "удар", "УДАР")
икона = put(икона, "блок", "БЛОК")
икона = put(икона, "оглушение", "ОГЛУШЕНИЕ")
икона = put(икона, "пробив", "ПРОБИВ")
икона = put(икона, "стан", "ОГЛУШЁН")
// Зарядки ауры — такие же ходы, и в разборе такта они должны называться, а
// не показываться знаком вопроса.
икона = put(икона, "з_меч", "КЛИНОК")
икона = put(икона, "з_кровь", "ЖАЖДА")
икона = put(икона, "з_призрак", "ТЕНЬ")
икона = put(икона, "з_сила", "СИЛА")
икона = put(икона, "з_жизнь", "ЖИЗНЬ")
икона = put(икона, "з_воля", "ВОЛЯ")
икона = put(икона, "з_отчаяние", "ОТЧАЯНИЕ")

// Ход → файл иконки. Таблицей, а не ветками: она нужна и при вскрытии, и
// при показе ЕГО плана вперёд.
ходфайл = {}
ходфайл = put(ходфайл, "удар", "icon_strike")
ходфайл = put(ходфайл, "блок", "icon_block")
ходфайл = put(ходфайл, "пробив", "icon_break")
ходфайл = put(ходфайл, "стан", "icon_stun")

// ── песни троих ──────────────────────────────────────────────────
// Костяк — азбука, и азбука не должна быть загадкой: он бьёт КАЖДЫЙ такт,
// без чередований. Смена ходов — приём высокого уровня, читать её на первом
// противнике нечем: игрок ещё не знает, что такое ход вообще. Здесь он
// учится одному — закрылся, получил темп, ударил.
паттерн_обычный = list("удар")
паттерн_ярость = list("удар")
// Щитоносец живёт за щитом. Бить в него бессмысленно вдвойне: урона нет, а
// темп капает ЕМУ — значит нужен пробив, иначе бой не кончается никогда.
паттерн_щит = list("блок", "блок", "удар", "блок", "блок", "удар")
паттерн_щит_ярость = list("блок", "удар", "блок", "блок", "удар")
// Лютый почти не защищается — но бьёт сериями, и переждать его блоком нельзя:
// на блоке он сам копит темп и следующим тактом бьёт вдвое. Нужно оглушение.
паттерн_лютый = list("удар", "удар", "удар", "блок", "удар", "удар")
паттерн_лютый_ярость = list("удар", "удар", "удар", "удар", "удар")
// Пробойник владеет тем же движением, что и ты: его пробив проходит СКВОЗЬ
// блок. Значит последняя безопасная кнопка перестаёт быть безопасной — и
// бой впервые требует читать песню, а не отсиживаться.
паттерн_пробой = list("пробив", "удар", "блок", "пробив", "удар", "пробив")
паттерн_пробой_ярость = list("пробив", "пробив", "удар", "пробив", "блок")

// ── АУРЫ ─────────────────────────────────────────────────────────
// Цена активации в тактах: три на старте, ноль на сотне владения — там
// аура горит с первого кадра боя. Между ними линейный спуск, чтобы
// прокачка чувствовалась не «числом», а числом ТАКТОВ, которые ты уже
// не обязан стоять открытым.
// Владение аурами — ТАБЛИЦА, а не три переменные: цена активации считается
// внутри выражения, а функция с ветками в выражении не живёт (её тело —
// команды, а не значение). Ключ — тот же, что и ход в плане.
func аура_цена(вид) { return max(3 - floor(get(влад_аур, вид, 0) / 34), 0) }
// Что происходит В МОМЕНТ вспышки: у разрядных заводится запас, у
// живучести разом растёт потолок здоровья (иначе её реген упирался бы в
// прежний максимум и первые такты уходили впустую).
func аура_вспышка() {
  // Активация — кульминация трёх тактов, прожитых открытым. Кадр обязан это
  // подтвердить: свет бьёт из центра, камера подаётся вперёд, воздух звенит.
  camera action=zoom factor=1.09 duration=0.12
  fx shockwave=0.75 shock_x=0.5 shock_y=0.72 bloom=0.85 rays=0.6 dur=0.45
  camera action=zoom factor=1 duration=0.4
  if аура_вид == "з_призрак" -> ав_пр
  if аура_вид == "з_кровь" -> ав_кр
  if аура_вид == "з_жизнь" -> ав_жз
  бит_суть = "АУРА ВСПЫХНУЛА!"
  -> ав_готово
  :ав_пр
  призрак_зарядов = 3
  бит_суть = "ТЕНЬ: три удара пройдут сквозь тебя."
  -> ав_готово
  :ав_кр
  кровь_тактов = 4
  бит_суть = "ЖАЖДА: четыре такта чужая кровь — твоя."
  -> ав_готово
  :ав_жз
  дуэль_хп_макс = дуэль_хп_макс + 3
  дуэль_хп = дуэль_хп + 3
  бит_суть = "ЖИВУЧЕСТЬ: +3 и затягивает каждый такт."
  -> ав_готово
  :ав_готово
}

func аура_рост(вид, сколько) { влад_аур = put(влад_аур, вид, min(get(влад_аур, вид, 0) + сколько, 100)) }

// индекс по кругу: % в языке нет, мод через floor
func pat_idx(s, n) { return s - floor(s / n) * n }
func foe_now() { return get(враг_паттерн, pat_idx(враг_шаг, len(враг_паттерн)), "удар") }

// ═══════════════════════════════════════════════════════════════════
//  2. ОТРИСОВКА — спрайты позиций фиксированы (дистанции в дуэли нет)
// ═══════════════════════════════════════════════════════════════════

func foe_sprite(pose) {
  // Поза — часть ПУТИ, и путь собирается выражением: три почти одинаковые
  // ветки (idle/attack/hurt) схлопываются в одну строку. Глубина задаётся
  // числом: скелет стоит в своей точке, а размер считает перспектива.
  враг_поза = pose
  враг_файл = pose
  // `world` ставит его В СЦЕНУ, а не поверх неё: движок проецирует точку
  // набора в кадр и берёт глубину из дистанции до камеры — значит и место, и
  // перспективный размер считаются сами. Когда камера дышит, скелет едет
  // вместе с деревьями, а не плывёт по экрану поверх них. Экранные x/y/depth
  // остаются запасным вариантом: без 3D-набора проекции нет, и работают они.
  // Фигура стоит В СЦЕНЕ, а не поверх неё: плоский объект внутри набора,
  // развёрнутый к камере. Рост задан В МЕТРАХ — поэтому скелет вровень с
  // соснами, уменьшается с расстоянием сам и уходит за деревья по глубине.
  // Наша прежняя арифметика (доля экрана × перспективный коэффициент) давала
  // великана в двух шагах и не понимала, что творится в наборе.
  obj id=duel_enemy sprite_url="/content/packages/lvn-duel/enemies/skeleton_{враг_файл}.png" x=50% y=46% width=0.72 height=1.05 anchor="0.5,0.5" z=10 in3d=1 world_height={враг_рост} world="0,0,{враг_даль}"
  враг_окрас()
}


// Подкраска врага — ВЕТКАМИ, а не выражением. Оператор `sfx` не вычисляет
// {…} в числовых полях: строка уходит прямо в разбор числа и роняет плеер
// (ловили живьём — игра вставала на первом же кадре боя). Пока движок этого
// не умеет, значения тут литеральные.
func враг_окрас() {
  враг_свет()
  if враг_окраска == "щит" -> ок_щит
  if враг_окраска == "лютый" -> ок_лютый
  if враг_окраска == "пробой" -> ок_пробой
  sfx id=duel_enemy tint=0 dur=0.2
  -> ок_готово
  :ок_щит
  sfx id=duel_enemy tint=0.55 tint_color=#7fa8d8 dur=0.2
  -> ок_готово
  :ок_лютый
  sfx id=duel_enemy tint=0.6 tint_color=#d86b5a dur=0.2
  -> ок_готово
  :ок_пробой
  sfx id=duel_enemy tint=0.5 tint_color=#c8a44e dur=0.2
  -> ок_готово
  :ок_готово
}

// Аура противника видна ТАК ЖЕ, как своя: тем же светом, теми же цветами.
// Это не украшение — игрок должен узнать в чужих руках то, что скоро будет
// в своих, иначе «победил и получил» читается как случайная награда.
func враг_свет() {
  if враг_аура_вид == "сила" -> вс_сила
  if враг_аура_вид == "жизнь" -> вс_жизнь
  if враг_аура_вид == "клинок" -> вс_клинок
  if враг_аура_вид == "жажда" -> вс_жажда
  if враг_аура_вид == "тень" -> вс_тень
  if враг_аура_вид == "воля" -> вс_воля
  if враг_аура_вид == "отчаяние" -> вс_отчаяние
  -> вс_готово
  :вс_сила
  sfx id=duel_enemy aura=0.85 aura_style=fire aura_color=#b0c3d9 aura_color2=#dfe9f5 aura_size=1.15 dur=0.5
  -> вс_готово
  :вс_жизнь
  sfx id=duel_enemy aura=0.8 aura_style=guard aura_color=#5e98d9 aura_size=1.1 dur=0.5
  -> вс_готово
  :вс_клинок
  sfx id=duel_enemy aura=0.9 aura_style=holy aura_color=#b28a33 aura_size=1.2 dur=0.5
  -> вс_готово
  :вс_жажда
  sfx id=duel_enemy aura=0.9 aura_style=shadow aura_color=#4b69ff aura_size=1.15 dur=0.5
  -> вс_готово
  :вс_тень
  sfx id=duel_enemy aura=0.85 aura_style=spirit aura_color=#8847ff aura_size=1.2 dur=0.5
  -> вс_готово
  :вс_воля
  sfx id=duel_enemy dark=1 outline=0.8 outline_color=#e33b2e rim=0.5 rim_color=#ff9a8f aura=0.3 aura_style=shadow aura_color=#07070c dur=0.5
  -> вс_готово
  :вс_отчаяние
  sfx id=duel_enemy aura=0.9 aura_style=distortion aura_color=#d32ce6 aura_size=1.2 dur=0.5
  -> вс_готово
  :вс_готово
}

func hands(pose) {
  if pose == "attack" -> рк_атака
  if pose == "block" -> рк_блок
  -> рк_покой
  :рк_атака
  obj id=duel_hands sprite_url="/content/packages/lvn-duel/fp/hands_sword_attack.png" x=50% y=87% width=0.95 anchor="0.5,1" z=20
  -> рк_готово
  :рк_блок
  obj id=duel_hands sprite_url="/content/packages/lvn-duel/fp/hands_sword_block.png" x=50% y=87% width=0.95 anchor="0.5,1" z=20
  -> рк_готово
  :рк_покой
  obj id=duel_hands sprite_url="/content/packages/lvn-duel/fp/hands_sword_idle.png" x=50% y=87% width=0.95 anchor="0.5,1" z=20
  -> рк_готово
  :рк_готово
  аура_свет()
}



// Свет активной ауры на руках — не индикатор, а сама аура: она горит, пока
// горит. Ставится после смены позы, потому что новый спрайт уносит шейдер.
func аура_свет() {
  if аура_вид == "з_меч" -> ас_меч
  if аура_вид == "з_кровь" -> ас_кровь
  if аура_вид == "з_призрак" -> ас_призрак
  if аура_вид == "з_сила" -> ас_сила
  if аура_вид == "з_жизнь" -> ас_жизнь
  if аура_вид == "з_воля" -> ас_воля
  if аура_вид == "з_отчаяние" -> ас_отчаяние
  sfx id=duel_hands aura=0 dark=0 outline=0 rim=0 dur=0.3
  -> ас_готово
  :ас_меч
  sfx id=duel_hands aura=1 aura_style=holy aura_color=#b28a33 aura_size=1.3 dur=0.4
  -> ас_готово
  :ас_кровь
  sfx id=duel_hands aura=0.95 aura_style=shadow aura_color=#4b69ff aura_size=1.2 dur=0.4
  -> ас_готово
  :ас_призрак
  sfx id=duel_hands aura=0.9 aura_style=spirit aura_color=#8847ff aura_size=1.25 dur=0.4
  -> ас_готово
  :ас_сила
  sfx id=duel_hands aura=0.9 aura_style=fire aura_color=#b0c3d9 aura_color2=#dfe9f5 aura_size=1.2 dur=0.4
  -> ас_готово
  :ас_жизнь
  sfx id=duel_hands aura=0.85 aura_style=guard aura_color=#5e98d9 aura_size=1.15 dur=0.4
  -> ас_готово
  :ас_отчаяние
  sfx id=duel_hands aura=0.95 aura_style=distortion aura_color=#d32ce6 aura_size=1.25 rim=0.5 rim_color=#f09aef dur=0.4
  -> ас_готово
  :ас_воля
  // Воля — не свечение, а ЧЕРНЕНИЕ самой руки: сталь и кожа уходят в чёрный,
  // как покрытие в референсе. Работает `dark`, который кладёт цвет спрайта в
  // почти абсолютный чёрный — аурой такого не добиться, она рисует ВОКРУГ.
  // Серебристая кромка обязательна: без неё чёрная рука на тёмной сцене
  // читается как дыра в кадре, а не как броня.
  sfx id=duel_hands dark=1 outline=0.8 outline_color=#e33b2e rim=0.55 rim_color=#ff9a8f aura=0.3 aura_style=shadow aura_color=#07070c aura_size=0.95 dur=0.45
  -> ас_готово
  :ас_готово
}

// ═══════════════════════════════════════════════════════════════════
//  3. ЭКРАН ПЛАНИРОВАНИЯ — кнопки-хотспоты (obj + on_click, как в
//     howto/point-and-click) и очередь-ячейки сверху
// ═══════════════════════════════════════════════════════════════════
// Числовые поля obj не принимают выражения (грабля из ec-battle), поэтому
// пять ячеек — пять процедур с литеральными координатами.

func buttons_show() {
  obj id=btn_strike sprite_url="/content/packages/lvn-duel/ui/icon_strike.png" x=0.13 y=57% width=0.092 height=0.055 anchor="0.5,0.5" z=40 on_click="дп_удар"
  obj id=btn_block sprite_url="/content/packages/lvn-duel/ui/icon_block.png" x=0.245 y=57% width=0.092 height=0.055 anchor="0.5,0.5" z=40 on_click="дп_блок"
  if навык == "оглушение" -> кп_огл
  if навык == "пробив" -> кп_проб
  -> кп_сброс
  :кп_огл
  obj id=btn_skill sprite_url="/content/packages/lvn-duel/ui/icon_stun.png" x=0.36 y=57% width=0.092 height=0.055 anchor="0.5,0.5" z=40 on_click="дп_оглушение"
  -> кп_сброс
  :кп_проб
  obj id=btn_skill sprite_url="/content/packages/lvn-duel/ui/icon_break.png" x=0.36 y=57% width=0.092 height=0.055 anchor="0.5,0.5" z=40 on_click="дп_пробив"
  -> кп_сброс
  :кп_сброс
  // Тестовая кнопка: убивает противника на месте. Живёт под флагом главы,
  // потому что в готовой игре её быть не должно — но проходить бой руками
  // ради проверки следующей сцены невыносимо.
  obj id=btn_tree sprite_url="/content/packages/lvn-duel/ui/icon_tree.png" x=0.795 y=65% width=0.07 height=0.043 anchor="0.5,0.5" z=40 on_click="дп_дерево"
  // Рестарт — НЕ дело пакета: он не знает, что такое «день» этой новеллы,
  // поэтому просто прыгает на условленную метку главы (см. контракт).
  obj id=btn_again sprite_url="/content/packages/lvn-duel/ui/icon_again.png" x=0.875 y=65% width=0.07 height=0.043 anchor="0.5,0.5" z=40 on_click="дуэль_рестарт"
  if тест_режим == 1 {
    obj id=btn_win sprite_url="/content/packages/lvn-duel/ui/icon_win.png" x=0.955 y=65% width=0.07 height=0.043 anchor="0.5,0.5" z=40 on_click="дп_автопобеда"
  } else {
  }
  obj id=btn_reset sprite_url="/content/packages/lvn-duel/ui/icon_reset.png" x=0.87 y=57% width=0.075 height=0.045 anchor="0.5,0.5" z=40 on_click="дп_сброс"
  // Ауры — ВТОРЫМ рядом: они не заменяют базу, а стоят рядом с ней. База
  // (удар и щит) не отменяется никогда, аура лишь занимает такты очереди —
  // те самые, в которых ты иначе бил бы или закрывался.
  аура_кнопки()
}

// Шесть кнопок в ряд — узкие, потому что их шесть; открытые показываются,
// закрытые не занимают места (сдвига нет: позиция у каждой своя, иначе
