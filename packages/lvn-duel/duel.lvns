func slots_draw() {
  slot_kind(0)
  slot1(сл_вид)
  slot_kind(1)
  slot2(сл_вид)
  slot_kind(2)
  slot3(сл_вид)
  slot_kind(3)
  slot4(сл_вид)
  slot_kind(4)
  slot5(сл_вид)
}

