// вид ячейки i: "выкл" (за пределом обмена) / "пусто" / имя действия








// ═══════════════════════════════════════════════════════════════════
//  3c. ДВА РЯДА ХОДОВ — твой план и его план
// ═══════════════════════════════════════════════════════════════════
// Верхний ряд — ХОДЫ СКЕЛЕТА, закрытые рубашкой: что он задумал, ты узнаёшь
// только когда такт отыгран. Нижний — твой набранный план. Отыгранный такт
// заливается цветом: зелёный — твой, красный — его, жёлтый — размен или
// пустой обмен. Без этого бой читается только текстом, а картинка молчит.
//
// Файлы иконок и подложек подставляются ВЫРАЖЕНИЕМ, координаты считаются от
// номера ячейки — поэтому здесь нет лестницы веток на каждое действие.

икон_файл = {}
икон_файл = put(икон_файл, "удар", "icon_strike")
икон_файл = put(икон_файл, "блок", "icon_block")
икон_файл = put(икон_файл, "оглушение", "icon_stun")
икон_файл = put(икон_файл, "пробив", "icon_break")
икон_файл = put(икон_файл, "стан", "icon_stun")

// Имя файла иконки для ячейки i. Тернарного оператора в языке НЕТ — поэтому
// «ещё не выбрано» и «ещё не вскрыто» выражены значением ПО УМОЛЧАНИЮ у get:
// список короче индекса → отдаётся заглушка, и никакой ветки не нужно.
func мойфайл(i) { return get(планфайлы, i, "icon_none") }
// В `вскрыто` кладутся сразу ИМЕНА ФАЙЛОВ: пока такт не отыгран, элемента нет
// и get отдаёт рубашку.
func егофайл(i) { return get(вскрыто, i, "cell_hidden") }
// подложка исхода: none — ещё не сыгран
func итогфайл(i) { return get(итоги, i, "cell_none") }
// центр ячейки i: ряд из шести, шаг 12% ширины экрана
func ячX(i) { return 0.26 + i * 0.12 }

// Вскрытие хода противника. Ветки вместо get по таблице: вложенный get внутри
// выражения молча отдавал значение по умолчанию, и ячейка оставалась пустой.

// Его очередь на предстоящий обмен — ОТКРЫТО, до планирования.
//
// Раньше ряд врага был закрыт рубашкой, и прочитать песню можно было только
// памятью: игрок держал в голове шесть тактов чужого паттерна. Это не
// сложность, а зубрёжка — и она съедала ту самую задачу, ради которой всё
// затевалось: СОБРАТЬ ответ на известную угрозу. Открытый ряд превращает
// обмен из проверки памяти в головоломку, где всё на столе.
func врагплан() {
  вскрыто = []
  впшаг = 0
  while впшаг < тактов {
    вп_поз = pat_idx(враг_шаг + впшаг, len(враг_паттерн))
    вп_ключ = враг_имя + "#" + вп_поз
    вп_ход = get(враг_паттерн, вп_поз, "удар")
    вп_файл = "cell_hidden"
    if get(знание, вп_ключ, 0) == 1 {
      вп_файл = get(ходфайл, вп_ход, "icon_none")
    } else {
    }
    вскрыто = push(вскрыто, вп_файл)
    впшаг = впшаг + 1
  }
}

func slots_draw() {
  // Подписи рядов: без них два одинаковых ряда читаются как один блок.
  text rowfoe x=4 y=8.6 size=13 color=#f0765e anchor="0,0" «ОН»
  text rowme x=4 y=16.6 size=13 color=#73b8ee anchor="0,0" «ТЫ»
  // Разбор такта — реактивным лейблом, а не репликой: реплика ждала бы тапа и
  // снова разбила бы обмен на перелистывание. Текст держится ровно паузу такта.
  text beatline x=50 y=23.5 size=26 color=#e8e1d3 anchor="0.5,0" «{бит_текст}»
  obj id=fs1 sprite_url="/content/packages/lvn-duel/ui/{итогфайл(0)}.png" x="{ячX(0)}" y=9% width=0.085 height=0.05 anchor="0.5,0.5" z=39
  obj id=fi1 sprite_url="/content/packages/lvn-duel/ui/{егофайл(0)}.png" x="{ячX(0)}" y=9% width=0.07 height=0.04 anchor="0.5,0.5" z=41
