  obj id=hero_bar_fill sprite_url="/content/packages/lvn-uikit/ui/bar_fill_resource.png" x=0.545 y=0.875 width=0.380 height=0.025 anchor="0,0.5" z=31 fill_from=left
  anim id=hero_bar_fill prop=fill to="{max(дуэль_хп, 0) / max(дуэль_хп_макс, 1)}" dur=0.25 ease=outCubic
