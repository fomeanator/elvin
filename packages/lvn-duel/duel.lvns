  obj id=slot1 sprite_url="/content/packages/lvn-duel/ui/icon_stun.png" x=0.30 y=0.42 width=0.07 height=0.04 anchor="0.5,0.5" z=40
  -> с1г
  :с1п
  obj id=slot1 sprite_url="/content/packages/lvn-duel/ui/icon_break.png" x=0.30 y=0.42 width=0.07 height=0.04 anchor="0.5,0.5" z=40
  -> с1г
  :с1в
  obj id=slot1 show=false
  -> с1г
  :с1г
}

