scene duel-online

include "duel.lvns"

// ═══════════════════════════════════════════════════════════════════
// ДУЭЛЬ ПО СЕТИ — двое живых, одна комната
// ═══════════════════════════════════════════════════════════════════
// Против человека «песня врага» не нужна: его ходы приходят с той стороны.
// Всё, что для этого требуется, — комната и ящик с правилом раскрытия
// (ext net_*). Правила боя те же самые: пакет дуэли не знает, кто перед
// ним — таблица или партнёр, и это главное свойство затеи.
//
// ПОЧЕМУ НАБОР ДЕЙСТВИЙ УРЕЗАН ДО ТРЁХ. В одиночном бою герой владеет
// оглушением и аурами, а враг — нет: правила разбирают «его оглушение»
// не отдельной веткой, а общим случаем. Против человека это дало бы
// РАСХОЖДЕНИЕ: у него на экране оглушение сработало бы, у тебя — нет, и
// два клиента насчитали бы разный исход. Поэтому здесь ровно то, что
// разобрано для обеих сторон: удар, блок, пробив. Ограничение честное и
// снимается не здесь, а в правилах пакета — когда у оглушения появится
// зеркальная ветка.
//
// СИНХРОННОСТЬ держится на трёх вещах:
//   1. Ноль случайности в правилах (так задумана механика).
//   2. Одинаковые стартовые числа у обоих — они ниже, в одном месте.
//   3. Один и тот же номер обмена: сеть_обмен растёт у обоих одинаково,
//      потому что обмен идёт строго по очереди и пропустить его нельзя.

тест_режим = 0
день = 1
навык = "пробив"
влад_оглушение = 0
влад_пробив = 60          // ступень III: пробив работает предсказуемо у обоих
пустая_таблица = {}
влад_аур = пустая_таблица
знание = пустая_таблица
аура_меч_откр = 0
аура_кровь_откр = 0
аура_призрак_откр = 0
аура_сила_откр = 0
аура_жизнь_откр = 0
аура_воля_откр = 0
аура_отчаяние_откр = 0

дуэль_сеть = 0
сеть_обмен = 0
победы = 0
поражения = 0

bg sprite_url="/content/packages/lvn-duel/assets/bg/path.png"
-> меню

:меню
дуэль_сеть = 0
Двое, одна тропа и по три кнопки на каждого.
- Создать комнату -> создать
- Войти по коду -> войти
- Как это работает -> правила

:правила
Каждый набирает очередь действий: первый обмен — одно, второй — два, и так до пяти.
Пока оба не нажали «готово», ничей выбор не виден — ни тебе, ни ему.
Потом очередь проигрывается такт за тактом. Удар против удара — размен, бьёт первым тот, у кого больше темпа. Удар против блока — темп копится защитнику. Пробив проходит сквозь блок.
Блоком не выиграть, вечным ударом кормишь чужой темп. Выигрывает тот, кто угадал.
-> меню

// ── хозяин комнаты ──────────────────────────────────────────────────
:создать
ext net_open
if net_error != "" -> сеть_беда
Комната открыта.
Код: {net_code}
Продиктуй его партнёру. Как только он войдёт, начнём.
ext net_wait need=2
if net_error != "" -> сеть_беда
Он сел напротив.
-> бой


// ── гость ───────────────────────────────────────────────────────────
:войти
input var=введённый_код prompt="Код комнаты" max=6
ext net_join code_var=введённый_код
if net_error != "" -> сеть_беда
Ты сел напротив. Комната {net_code}.
-> бой

:сеть_беда
Не вышло: {net_error}.
- Ещё раз -> меню
- Ладно -> конец

// ── сам бой ─────────────────────────────────────────────────────────
:бой
дуэль_сеть = 1
сеть_обмен = 0
// Одинаковые числа у обоих — иначе два клиента разойдутся на первом же
// подсчёте. Шесть сердец на каждого: столько же, сколько в одиночной
// тропе, и хватает на четыре-пять обменов.
дуэль_хп = 6
дуэль_хп_макс = 6
враг_хп = 6
враг_хп_макс = 6
враг_имя = "СОПЕРНИК"
// Песня не используется в сетевом бою, но длину списка читают в других
// местах — пустой он дал бы деление на ноль.
враг_паттерн = list("удар")
враг_паттерн2 = list("удар")
враг_окраска = ""
враг_аура_вид = ""
враг_даль = 0
враг_рост = 2.2

duel()

ext net_leave
if дуэль_исход == "победа" -> ты_взял
if дуэль_исход == "пал" -> ты_пал
-> вничью

:ты_взял
победы = победы + 1
Он опустил руки первым.
-> ещё

:ты_пал
поражения = поражения + 1
Ты не дочитал его до конца.
-> ещё

:вничью
Ни один не дожал. Тропа развела вас живыми.
-> ещё

:ещё
Счёт: {победы} — {поражения}.
- Ещё бой -> меню
- Хватит -> конец

-> __end

// Контракт пакета: кнопка «заново» внутри боя прыгает СЮДА. Пакет не
// знает, что для этой новеллы значит «заново», и знать не должен.
// (сюда попадают только прыжком — проваливаться нечему)
:дуэль_рестарт
ext net_leave
-> меню

:конец
До следующего раза.
-> __end
