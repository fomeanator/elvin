// Стилизованное освещение — то, на чём держится вид корейских и японских
// 3D-новелл. Их картинка не «реалистичная», а ЧИСТАЯ: свет ложится крупными
// зонами, тень имеет цвет, край подсвечен. Реализм в этом жанре обычно делает
// хуже — модель начинает выглядеть пластиковой, а не нарисованной.
//
// Что здесь есть и зачем:
//  · Ступенчатый свет (рампа) — вместо плавного затухания две-три зоны. Это
//    главный признак рисованности.
//  · ЦВЕТНАЯ тень — тень не «то же самое, но темнее», а холоднее и синее.
//    Серая тень мгновенно выдаёт компьютерный рендер.
//  · Контровой ободок (rim) — свет по контуру, отделяющий фигуру от задника.
//    В новелле это ещё и читаемость: персонаж не тонет в фоне.
Shader "Lvn/Toon"
{
    Properties
    {
        _Color ("Цвет", Color) = (1,1,1,1)
        _MainTex ("Текстура", 2D) = "white" {}
        _BumpMap ("Карта нормалей", 2D) = "bump" {}
        _BumpScale ("Сила рельефа", Range(0, 3)) = 1
        _ShadowTint ("Цвет тени", Color) = (0.35, 0.42, 0.6, 1)
        _Steps ("Ступеней света", Range(1, 4)) = 2
        _Softness ("Мягкость границы", Range(0.001, 0.3)) = 0.04
        _RimColor ("Цвет ободка", Color) = (0.7, 0.85, 1, 1)
        _RimPower ("Узость ободка", Range(0.5, 8)) = 3
        // До восьми: ободок — это КОНТРОВОЙ СВЕТ, и на фоне ночи он должен
        // быть ярче белого, иначе не даёт ни ореола, ни ощущения источника.
        // Умолчание не тронуто — старые сцены не меняются.
        _RimStrength ("Сила ободка", Range(0, 8)) = 0.6
        _WarmEdge ("Тёплая кайма у тени", Range(0, 1)) = 0.18
        _WarmColor ("Цвет каймы", Color) = (1, 0.72, 0.45, 1)
        _Outline ("Толщина обводки, м", Range(0, 0.1)) = 0
        _OutlineColor ("Цвет обводки", Color) = (0.06, 0.07, 0.11, 1)
        // ВЫРЕЗАНИЕ ПО ПРОЗРАЧНОСТИ. Листва, решётки, цепи, волосы — всё это в
        // чужих наборах сделано плоскостями с прозрачной текстурой, а не
        // геометрией: так дешевле в сотни раз. Непрозрачный шейдер рисует такую
        // плоскость ЦЕЛИКОМ — и вместо ветки в кадре висит белый квадрат.
        //
        // Ноль по умолчанию: обычная модель ничего не платит (её альфа равна
        // единице, порог не срабатывает), а конвертер поднимает порог там, где
        // у оригинала прозрачность была.
        _Cutoff ("Порог вырезания", Range(0, 1)) = 0
        // 2 — отсекать изнанку (обычная модель), 0 — рисовать обе стороны
        // (плоскости листвы). Ставится конвертером вместе с порогом.
        [Enum(UnityEngine.Rendering.CullMode)] _Cull ("Отсечение граней", Float) = 2
        // Читать ли затенение из вершин. Ноль по умолчанию: включает тот,
        // кто знает, что оно там есть, — иначе чужая альфа съест ambient.
        _VertexAO ("Затенение из вершин", Range(0, 1)) = 0
        // СОБСТВЕННОЕ СВЕЧЕНИЕ поверхности: окно, лампа, руна, раскалённый
        // металл. Отличается от ободка тем, что не зависит ни от взгляда, ни
        // от источников, — это свет самой вещи. Чёрный по умолчанию: обычная
        // поверхность не светится и ничего не платит.
        [HDR] _EmissionColor ("Свечение", Color) = (0,0,0,1)
    }
    SubShader
    {
        Tags { "RenderType" = "Opaque" "Queue" = "Geometry" }
        LOD 200

        // Двусторонняя, потому что лист плоский: у плоскости, повёрнутой к нам
        // изнанкой, лицевых граней нет, и половина кроны просто исчезала бы.
        Cull [_Cull]

        CGPROGRAM
        // addshadow — своя тень с УЧЁТОМ вырезания: иначе крона отбрасывает
        // тень сплошным прямоугольником, что заметнее самой ошибки.
        //
        // noambient — рассеянный свет считаем САМИ. Unity добавил бы его сам,
        // но добавил бы ко всему сразу и одинаково, а нам нужно ровно обратное:
        // затенение в углах должно гасить ТОЛЬКО рассеянный свет и не трогать
        // ни прямой, ни ободок, ни свечение. Умножить AO на всё вместе — это
        // не контакт, а грязь: предмет просто становится тусклым.
        #pragma surface surf Toon fullforwardshadows addshadow noambient
        #pragma target 3.0

        sampler2D _MainTex;
        sampler2D _BumpMap;
        fixed4 _Color, _ShadowTint, _RimColor, _WarmColor;
        half _Steps, _Softness, _RimPower, _RimStrength, _BumpScale, _WarmEdge, _Cutoff;
        half _VertexAO;
        half4 _EmissionColor;

        struct Input
        {
            float2 uv_MainTex;
            float2 uv_BumpMap;
            float3 viewDir;
            float3 worldNormal;
            float4 color : COLOR;   // затенение, запечённое в вершины
            INTERNAL_DATA           // нужен, раз мы сами пишем o.Normal
        };

        // ПОЛУСФЕРИЧЕСКИЙ РАССЕЯННЫЙ СВЕТ. Небо не светит одинаково со всех
        // сторон: сверху приходит его собственный цвет, снизу — отражённый от
        // земли, сбоку — то, что у горизонта. Плоский серый ambient, который
        // ставят по умолчанию, убивает половину объёма: теневая сторона любого
        // предмета становится просто тёмной, вместо того чтобы быть синей
        // сверху и тёплой снизу.
        //
        // Стоит это одной интерполяции по нормали. Значения берём те, что уже
        // выставила сцена (`light kind=sky`) — Unity держит их в этих трёх
        // переменных, и таким образом небо, туман и тень описывают одну погоду.
        half3 HemiAmbient(half3 n)
        {
            half u = n.y;
            return u > 0
                ? lerp(unity_AmbientEquator.rgb, unity_AmbientSky.rgb, u)
                : lerp(unity_AmbientEquator.rgb, unity_AmbientGround.rgb, -u);
        }

        // Собственная модель освещения: свет разбит на ступени, тень окрашена.
        half4 LightingToon(SurfaceOutput s, half3 lightDir, half atten)
        {
            half ndl = dot(s.Normal, lightDir) * 0.5 + 0.5;   // 0..1, мягче классического
            half lit = 0;
            half steps = max(1, floor(_Steps));
            for (int i = 1; i <= 4; i++)
            {
                if (i > steps) break;
                half edge = (half)i / (steps + 1);
                lit += smoothstep(edge - _Softness, edge + _Softness, ndl);
            }
            lit /= steps;
            lit *= atten;

            // ДОПОЛНИТЕЛЬНЫЙ ПРОХОД ДОБАВЛЯЕТ, А НЕ ЗАМЕНЯЕТ.
            //
            // Каждый источник сверх первого рисуется отдельным проходом, и его
            // результат ПРИБАВЛЯЕТСЯ к уже нарисованному. Значит вернуть отсюда
            // «цвет поверхности в тени» нельзя: лампа, светящая в другом конце
            // сцены, подмешала бы тень ещё раз — и ещё раз с каждой следующей.
            // Замерили: три лампы в стороне поднимали дальний фон на 30 из 255.
            //
            // В дополнительном проходе отдаём ТОЛЬКО вклад своего источника; он
            // сам уходит в ноль там, куда свет не достаёт.
            #ifdef UNITY_PASS_FORWARDADD
                half4 add;
                add.rgb = s.Albedo * _LightColor0.rgb * lit;
                add.a = s.Alpha;
                return add;
            #endif

            // Тень не серая, а цветная: свет и тень — два РАЗНЫХ цвета, между
            // которыми идёт переход. Так пишут фон в аниме, и так же читается
            // объём без грязи в полутонах.
            half3 shaded = s.Albedo * _ShadowTint.rgb;
            half3 col = lerp(shaded, s.Albedo * _LightColor0.rgb, lit);

            // ТЁПЛАЯ КАЙМА НА ГРАНИЦЕ СВЕТА И ТЕНИ — приём из японских и
            // китайских 3D-игр (в Genshin он самый заметный): узкая полоска
            // тёплого света там, где освещённая сторона переходит в теневую.
            // Физически это подделка подповерхностного рассеяния, но именно она
            // отличает «нарисованную» поверхность от пластиковой, и стоит она
            // одного умножения.
            // Полоса УЗКАЯ и умноженная на собственный цвет: широкая кайма
            // читается как пересвет, а не как рассеяние, и первым же ярким
            // солнцем выжигает всю поверхность в белое.
            half band = saturate(1.0 - abs(lit - 0.5) * 2.4);
            band = band * band * band;
            col += _WarmColor.rgb * s.Albedo * band * _WarmEdge;

            half4 c;
            c.rgb = col;
            c.a = s.Alpha;
            return c;
        }

        void surf(Input IN, inout SurfaceOutput o)
        {
            fixed4 c = tex2D(_MainTex, IN.uv_MainTex) * _Color;
            // Прозрачное — выбрасываем совсем. Порог, а не смешивание: у листвы
            // край должен быть резким, а полупрозрачные квадраты пришлось бы
            // ещё и сортировать по глубине, чего в кроне из сотни плоскостей
            // не сделать ни за какие деньги.
            clip(c.a - _Cutoff);
            o.Albedo = c.rgb;
            o.Alpha = c.a;

            // РЕЛЬЕФ. Без него камень, кора и ткань — одинаково гладкий пластик:
            // ступенчатый свет тем и хорош, что подхватывает мелкую неровность
            // крупным пятном, а не размазывает её в шум.
            fixed3 n = UnpackNormal(tex2D(_BumpMap, IN.uv_BumpMap));
            o.Normal = normalize(lerp(fixed3(0, 0, 1), n, _BumpScale));

            // Ободок по контуру. Считается от угла между нормалью и взглядом,
            // поэтому светится ровно край силуэта — независимо от того, где
            // стоит солнце.
                        // ТОЛЬКО В ОСНОВНОМ ПРОХОДЕ. Поверхностный шейдер вызывается по
            // разу на КАЖДЫЙ источник света, и всё, что попадает в Emission,
            // складывается столько раз, сколько в сцене ламп. Замерили: три
            // лампы в стороне поднимали яркость дальнего фона на 30 из 255 —
            // фон светлел от источников, которые светят в другую сторону.
            //
            // Рассеянный свет и контровой ободок к источникам отношения не
            // имеют: они существуют один раз на пиксель.
            #ifndef UNITY_PASS_FORWARDADD
    half rim = 1.0 - saturate(dot(normalize(IN.viewDir), o.Normal));
                o.Emission = _RimColor.rgb * pow(rim, _RimPower) * _RimStrength;

                // ЗАТЕНЕНИЕ В УГЛАХ — то, из-за чего предмет перестаёт выглядеть
                // наклеенным на землю. Берём его из вершин: там, где художник (или
                // наш запекатель) отметил щели и стыки, рассеянного света приходит
                // меньше — он туда просто не достаёт.
                //
                // Читаем ТОЛЬКО альфу и только по явному разрешению: у мешей без
                // запечённого затенения альфа равна единице (ничего не меняется),
                // а вот цветные вершины low-poly наборов — это ЦВЕТ, и умножать на
                // него означало бы красить предмет дважды.
                half ao = lerp(1.0, IN.color.a, _VertexAO);

                // Рассеянный свет добавляем ЗДЕСЬ, а не в модели освещения: та
                // вызывается по разу на каждый источник, и ambient сложился бы
                // столько раз, сколько в сцене ламп.
                half3 wn = WorldNormalVector(IN, o.Normal);
                o.Emission += HemiAmbient(wn) * o.Albedo * ao;
                o.Emission += _EmissionColor.rgb;   // свет самой вещи, без потолка
            #endif

        }
        ENDCG

        // ОБВОДКА — вывернутой оболочкой: копия модели, раздутая по нормалям,
        // с отсечением ЛИЦЕВЫХ граней. Видны только края, и получается ровная
        // линия, которая правильно тончает с расстоянием — в отличие от
        // экранной обводки по глубине, которая мерцает на тонких предметах.
        //
        // Пасс стоит второго вызова отрисовки на объект, поэтому по умолчанию
        // ВЫКЛЮЧЕН (толщина 0): включать его на роще из ста деревьев — верный
        // способ удвоить цену сцены ради линий, которых на заднем плане никто
        // не разглядит. Включайте на том, что близко: персонаж, предмет в руке,
        // ключевая декорация.
        Pass
        {
            Name "OUTLINE"
            Cull Front
            ZWrite On

            CGPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "UnityCG.cginc"

            half _Outline;
            fixed4 _OutlineColor;

            struct v2f { float4 pos : SV_POSITION; };

            v2f vert(appdata_base v)
            {
                v2f o;
                // Раздуваем в ПРОСТРАНСТВЕ ВИДА, а не в объектном: иначе
                // толщина линии зависит от масштаба объекта, и один и тот же
                // шейдер даёт волосок на большом теле и жирную кайму на мелком.
                // Раздуваем в МИРОВОМ пространстве. Объектное ломается
                // масштабом (у клинка 0.09×1.5×0.02 линия расползлась бы по
                // толщине), а пространство вида подтягивает оболочку к камере —
                // на шаре она вылезала ВПЕРЁД и закрывала его целиком чёрным.
                // Мировое даёт ровную толщину в метрах и всегда снаружи.
                float3 world = mul(unity_ObjectToWorld, v.vertex).xyz;
                float3 n = UnityObjectToWorldNormal(v.normal);
                world += normalize(n) * _Outline;
                o.pos = UnityWorldToClipPos(float4(world, 1.0));
                return o;
            }

            fixed4 frag(v2f i) : SV_Target { return _OutlineColor; }
            ENDCG
        }
    }
    FallBack "Diffuse"
}
