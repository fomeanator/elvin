// Глубина резкости — то, что сильнее всего отличает кадр от «картинки из игры».
//
// Кино почти никогда не показывает всё резким: объектив держит в фокусе одну
// плоскость, остальное мягко расплывается. Глаз читает это как «камера, а не
// рендер», и заодно получает подсказку, куда смотреть — а для новеллы, где
// кадр рассматривают долго, это половина режиссуры.
//
// Считаем по глубине: для каждого пикселя берём расстояние до камеры, сравниваем
// с плоскостью фокуса и получаем «кружок нерезкости» (CoC). Дальше размываем
// тем сильнее, чем он больше.
//
// Упрощения, принятые сознательно:
//  · размытие круговое по 12 точкам вместо честного гауссова — на глаз в
//    стилизованном кадре разницы нет, а цена втрое меньше;
//  · нет разделения переднего и заднего плана (в кино передний «съедает» край
//    объекта). Для задника новеллы это невидимо, а стоит второго прохода.
Shader "Lvn/Dof"
{
    Properties
    {
        _MainTex ("Кадр", 2D) = "white" {}
        _Focus ("Плоскость фокуса, м", Float) = 6
        _Range ("Глубина резкости, м", Float) = 4
        _Strength ("Сила размытия", Range(0, 4)) = 1
    }
    SubShader
    {
        Cull Off ZWrite Off ZTest Always

        Pass
        {
            CGPROGRAM
            #pragma vertex vert_img
            #pragma fragment frag
            #include "UnityCG.cginc"

            sampler2D _MainTex;
            float4 _MainTex_TexelSize;
            sampler2D _CameraDepthTexture;
            float _Focus, _Range, _Strength;

            half4 frag(v2f_img i) : SV_Target
            {
                // Глубина в МЕТРАХ: с ней автор задаёт фокус так же, как ставит
                // тела и камеру — «резко в шести метрах», а не в долях буфера.
                float raw = SAMPLE_DEPTH_TEXTURE(_CameraDepthTexture, i.uv);
                float dist = LinearEyeDepth(raw);

                // Кружок нерезкости. Ноль в пределах глубины резкости, дальше
                // растёт, но не бесконечно — иначе горизонт превращается в кашу.
                float coc = saturate((abs(dist - _Focus) - _Range) / max(_Range, 0.01));
                coc = coc * coc * _Strength;
                if (coc < 0.002) return tex2D(_MainTex, i.uv);

                float2 px = _MainTex_TexelSize.xy * coc * 6.0;
                half4 sum = tex2D(_MainTex, i.uv);
                // Двенадцать точек по двум кольцам: одно кольцо даёт видимые
                // «лепестки» на ярких пятнах, два уже читаются как боке.
                const float2 k[12] = {
                    float2( 1.0,  0.0), float2( 0.5,  0.87), float2(-0.5,  0.87),
                    float2(-1.0,  0.0), float2(-0.5, -0.87), float2( 0.5, -0.87),
                    float2( 1.7,  0.6), float2( 0.6,  1.7), float2(-1.4,  1.1),
                    float2(-1.7, -0.6), float2(-0.6, -1.7), float2( 1.4, -1.1)
                };
                for (int s = 0; s < 12; s++)
                    sum += tex2D(_MainTex, i.uv + k[s] * px);
                return sum / 13.0;
            }
            ENDCG
        }
    }
    FallBack Off
}
