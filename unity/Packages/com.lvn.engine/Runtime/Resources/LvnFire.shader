// Огонь, дым, туманное марево — то, чем нельзя быть светящимся шаром.
//
// Костёр в кадре новеллы почти всегда есть: привал, кузница, свеча, факел,
// горящий дом. Отдельная система частиц ради него — лишний ассет, лишняя
// настройка и лишняя цена; здесь тот же результат делает материал на любом
// теле (шар, конус, плоскость).
//
// Как устроено: два слоя движущегося вверх псевдошума, порог по ним даёт
// рваный язык пламени, а цвет берётся ГРАДИЕНТОМ ПО ВЫСОТЕ — снизу белое ядро,
// выше оранжевое тело, сверху красные всполохи, уходящие в дым. Именно этот
// градиент читается как огонь; форма вторична.
Shader "Lvn/Fire"
{
    Properties
    {
        _Core ("Ядро", Color) = (1, 0.86, 0.55, 1)
        _Body ("Пламя", Color) = (1, 0.55, 0.12, 1)
        _Tip ("Всполохи", Color) = (0.75, 0.13, 0.05, 1)
        _Speed ("Скорость", Range(0, 6)) = 1.6
        _Scale ("Крупность языков", Range(1, 20)) = 6
        _Cut ("Рваность", Range(0, 1)) = 0.45
        // Пламя — источник, а не светлое пятно: в единицах света это 2–8.
        _Power ("Яркость", Range(0, 8)) = 1
        _Smoke ("Дым вместо огня", Range(0, 1)) = 0
    }
    SubShader
    {
        Tags { "Queue" = "Transparent" "RenderType" = "Transparent" "IgnoreProjector" = "True" }
        Blend SrcAlpha One      // огонь ПРИБАВЛЯЕТ свет
        ZWrite Off
        Cull Off
        LOD 100

        Pass
        {
            CGPROGRAM
            #pragma vertex vert
            #pragma fragment frag
            #include "UnityCG.cginc"

            half4 _Core, _Body, _Tip;
            half _Speed, _Scale, _Cut, _Smoke, _Power;

            struct v2f
            {
                float4 pos : SV_POSITION;
                float3 obj : TEXCOORD0;
                float2 uv : TEXCOORD1;
            };

            v2f vert(appdata_base v)
            {
                v2f o;
                o.pos = UnityObjectToClipPos(v.vertex);
                o.obj = v.vertex.xyz;
                o.uv = v.texcoord.xy;
                return o;
            }

            // Дешёвый шум: сумма синусов разной частоты, сносимая вверх по
            // времени. Настоящий Perlin здесь не нужен — пламя всё равно
            // смотрят вполглаза, а текстуру пришлось бы класть в каждый набор.
            half noise(float3 p)
            {
                half n = sin(p.x * 3.1 + p.z * 2.3) * 0.5
                       + sin(p.x * 7.7 - p.z * 5.1) * 0.25
                       + sin(p.z * 11.3 + p.x * 9.7) * 0.125;
                return n * 0.5 + 0.5;
            }

            half4 frag(v2f i) : SV_Target
            {
                // Высота внутри тела: 0 — низ, 1 — верх. У наших примитивов
                // основание ровно в нуле, а верх в единице — поэтому это и есть
                // доля высоты. Смещение на полкорпуса (как у центрированных
                // мешей) сдвигало бы всё пламя за верхний край и гасило его.
                half h = saturate(i.obj.y);

                float t = _Time.y * _Speed;
                half n1 = noise(float3(i.obj.x * _Scale, 0, i.obj.z * _Scale) + float3(0, 0, t));
                half n2 = noise(float3(i.obj.x * _Scale * 1.7 + 3.1, 0, i.obj.z * _Scale * 1.7) - float3(0, 0, t * 1.4));
                half flame = (n1 * 0.6 + n2 * 0.4);

                // Чем выше, тем легче пламя рвётся: язык сужается кверху.
                // Порог растёт с высотой: язык сужается кверху и рвётся.
                half cut = _Cut * 0.5 + h * 0.45;
                half a = saturate((flame - cut) * 4.0) * (1.0 - h * 0.6);

                // МЯГКИЙ КРАЙ ПО РАДИУСУ. Без него видно саму геометрию — у
                // цилиндра выходит стеклянная колонна, у конуса чёткий конус.
                // Огонь и дым не имеют края вообще: они гаснут к периферии.
                half r = saturate(length(float2(i.obj.x, i.obj.z)) * 2.0);
                a *= 1.0 - r * r;
                // Гасим и у ТОРЦОВ. Иначе крышки цилиндра (или основание
                // конуса) видны ровным диском — дым получается шайбой, а не
                // клубами: геометрия проступает там, где её быть не должно.
                a *= smoothstep(0.0, 0.12, h) * smoothstep(1.0, 0.82, h);
                // Сила теперь живёт в ЯРКОСТИ, а не в прозрачности: раньше
                // «ярче» означало «плотнее», отчего пламя не светилось, а
                // густело. Здесь оставляем форму как есть.

                // Цвет по высоте — это и есть «огонь». Порядок обязателен:
                // белое ядро внизу, оранжевое тело, красные всполохи вверху.
                half3 col = lerp(_Core.rgb, _Body.rgb, saturate(h * 2.2));
                col = lerp(col, _Tip.rgb, saturate((h - 0.45) * 2.2));

                // Дым — тот же шум, но серый, тяжёлый и расползающийся: он
                // ГУЩЕ У ОСНОВАНИЯ и тает кверху, тогда как пламя наоборот.
                if (_Smoke > 0.001)
                {
                    half3 smoke = half3(0.26, 0.26, 0.29);
                    col = lerp(col, smoke, _Smoke);
                    half fade = (1.0 - h) * (1.0 - h);
                    a = lerp(a, saturate((flame - 0.35) * 2.0) * fade * (1.0 - r), _Smoke) * 0.55;
                }

                // Цвет пламени умножаем на силу и НЕ обрезаем: ядро огня
                // ярче белого, и именно этим оно отличается от оранжевого
                // пятна. Прозрачность по-прежнему в 0…1 — по ней смешивают.
                return half4(col * _Power, saturate(a));
            }
            ENDCG
        }
    }
    FallBack Off
}
