// ТОНАЛЬНАЯ КОМПРЕССИЯ — последний шаг кадра набора: из света в картинку.
//
// Свет в сцене не имеет потолка. Огонь ярче стены во много раз, солнце ярче
// огня, и это правда о мире, а не ошибка. Экран же умеет ровно одну яркость —
// «белое». Пока перевод из первого во второе делается обрезанием, всё, что
// ярче единицы, становится одинаково белым: пламя, освещённый им камень и
// блик на клинке сливаются в одно пятно, а вокруг остаётся резкая граница.
// Именно это читается как «дёшево выглядит», сколько ни добавляй моделей.
//
// Тональная кривая переводит мягко: тёмное и среднее оставляет почти как есть,
// а яркое ПЛАВНО подводит к белому, никогда его не достигая. Появляется то,
// что в фотографии зовут плечом, — света сохраняют форму.
//
// ЦВЕТ ПРИ ЭТОМ НЕ ТРОГАЕМ. Обычная кривая, применённая к каналам по
// отдельности, сжимает их по-разному: у красного пламени первым упирается
// красный канал, и пламя на глазах желтеет, а потом белеет. Здесь сжимается
// ОДНА величина — самый яркий канал, — а весь цвет умножается на общий
// коэффициент. Отношения каналов сохраняются, значит остаётся и оттенок: наша
// цветная тень, контровой ободок и огонь держат свой цвет до самого белого.
// Для стиля, где цвет и есть стиль, это важнее физической точности.
Shader "Lvn/Tone"
{
    Properties
    {
        _MainTex ("Кадр", 2D) = "white" {}
        _ExposureEV ("Экспозиция, EV", Range(-6, 6)) = 0
        _Mode ("0 — без кривой, 1 — своя, 2 — Khronos", Float) = 0
        _Knee ("Начало плеча", Range(0.1, 1)) = 0.65
        _White ("Точка белого", Range(1, 8)) = 1.6
        _Saturation ("Насыщенность", Range(0, 2)) = 1
        _Contrast ("Контраст", Range(0, 2)) = 1
        _Dither ("Дизеринг", Range(0, 2)) = 1
        _Bloom ("Сила свечения", Range(0, 3)) = 0
        _BloomThreshold ("Порог свечения", Range(0.5, 8)) = 1.2
        _BloomKnee ("Мягкость порога", Range(0, 2)) = 0.5
        _BloomTex ("Свечение", 2D) = "black" {}
    }
    SubShader
    {
        Cull Off ZWrite Off ZTest Always

        Pass
        {
            CGPROGRAM
            #pragma vertex vert_img
            #pragma fragment frag
            #include "UnityCG.cginc"

            sampler2D _MainTex;
            float4 _MainTex_TexelSize;
            // half, а не fixed: fixed на мобильных GPU — это число в диапазоне
            // примерно [-2, 2] с грубым шагом, и всё, ради чего затевалась
            // тональная компрессия, в нём просто не помещается.
            half _ExposureEV, _Mode, _Knee, _White, _Saturation, _Contrast, _Dither;

            // Мягкое плечо: до колена — тождество, дальше — гипербола,
            // асимптотически стремящаяся к точке белого. Непрерывна в колене
            // и по значению, и по наклону, поэтому перехода не видно.
            half Shoulder(half x)
            {
                if (x <= _Knee) return x;
                half b = max(_White - _Knee, 1e-4);
                half a = x - _Knee;
                return _Knee + b * a / (b + a);
            }

            // Khronos PBR Neutral — отраслевая кривая, сохраняющая цвет.
            // Держим её рядом со своей как образец для сравнения: спорить о
            // том, какая лучше, имеет смысл только на одном и том же кадре.
            half3 KhronosNeutral(half3 c)
            {
                const half startCompression = 0.8 - 0.04;
                const half desaturation = 0.15;

                half x = min(c.r, min(c.g, c.b));
                half offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
                c -= offset;

                half peak = max(c.r, max(c.g, c.b));
                if (peak < startCompression) return c;

                const half d = 1.0 - startCompression;
                half newPeak = 1.0 - d * d / (peak + d - startCompression);
                c *= newPeak / peak;

                half g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
                return lerp(c, half3(newPeak, newPeak, newPeak), g);
            }

            sampler2D _BloomTex;
            half _Bloom;

            half4 frag(v2f_img i) : SV_Target
            {
                half4 src = tex2D(_MainTex, i.uv);
                half3 c = src.rgb;

                // Экспозиция — до кривой: она решает, ЧТО попадёт в плечо.
                // В ступенях, потому что так о свете думают: −1 EV это «вдвое
                // темнее», и это понятнее, чем множитель 0.5.
                c *= exp2(_ExposureEV);

                // СВЕЧЕНИЕ — до кривой и в тех же единицах, что и сам свет.
                // Ореол вокруг пламени — это рассеяние в глазу и в объективе, то
                // есть добавка К ЭНЕРГИИ. Прибавлять его после сжатия значит
                // накладывать светлое пятно на уже готовую картинку: оно ляжет
                // молочной плёнкой и сожжёт то, что кривая только что спасла.
                if (_Bloom > 0.001)
                    c += tex2D(_BloomTex, i.uv).rgb * _Bloom;

                if (_Mode > 1.5)
                {
                    c = KhronosNeutral(c);
                }
                else if (_Mode > 0.5)
                {
                    half peak = max(c.r, max(c.g, c.b));
                    if (peak > 1e-5)
                    {
                        half mapped = Shoulder(peak);
                        c *= mapped / peak;   // общий множитель — оттенок цел
                    }
                }

                // Творческая правка — ПОСЛЕ кривой, по уже отображаемому
                // цвету: насыщенность, поднятая до компрессии, ушла бы в
                // плечо и там же и осталась.
                if (abs(_Saturation - 1.0) > 0.001)
                {
                    half lum = Luminance(c);
                    c = lerp(half3(lum, lum, lum), c, _Saturation);
                }
                if (abs(_Contrast - 1.0) > 0.001)
                    c = (c - 0.5) * _Contrast + 0.5;

                // ДИЗЕРИНГ — последним, уже перед записью в восьмибитный кадр.
                // На плавном ночном небе соседние уровни различаются меньше,
                // чем шаг квантования, и переход распадается на видимые полосы.
                // Шум в половину младшего разряда разбивает границу: глаз
                // усредняет его в промежуточный оттенок, которого в восьми
                // битах нет. Шум ПРИВЯЗАН К ПИКСЕЛЮ, а не ко времени — иначе
                // спокойное небо начинает кипеть.
                if (_Dither > 0.001)
                {
                    // Шум считаем ЧЕРЕЗ МАЛЫЕ КОНСТАНТЫ и во float.
                    //
                    // Обычный приём `frac(sin(dot(p, (12.99, 78.23))) * 43758.5)`
                    // на мобильном GPU разваливается: половинная точность даёт
                    // десять бит мантиссы, аргумент синуса на краю кадра
                    // доходит до сотен тысяч и представим с шагом около сотни —
                    // синус вырождается в ступени, и вместо шума по кадру идут
                    // светлые вертикальные полосы шириной с десяток пикселей.
                    // Мы это и поймали: лечение бандинга само рисовало бандинг.
                    //
                    // Чередующийся градиентный шум (Jimenez) обходится
                    // множителями меньше единицы — точности хватает на любом
                    // разрешении, а распределение для дизеринга даже лучше.
                    float2 p = i.uv * _ScreenParams.xy;
                    float n = frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715))));
                    c += (n - 0.5) * (_Dither / 255.0);
                }

                return half4(c, src.a);
            }
            ENDCG
        }

        // ── Пасс 1: отбор яркого ────────────────────────────────────────────
        // Свечение должно исходить от того, что ЯРЧЕ БЕЛОГО, — от пламени, от
        // раскалённого металла, от магии. Порог ниже единицы ловит просто
        // светлые вещи: белую рубаху, облако, освещённый камень, — и кадр
        // затягивает молоком. Именно поэтому порог задаётся в единицах света и
        // по умолчанию стоит выше единицы; это возможно только потому, что
        // кадр к этому моменту ещё не сжат.
        Pass
        {
            CGPROGRAM
            #pragma vertex vert_img
            #pragma fragment frag
            #include "UnityCG.cginc"

            sampler2D _MainTex;
            half _BloomThreshold, _BloomKnee, _ExposureEV;

            half4 frag(v2f_img i) : SV_Target
            {
                half3 c = tex2D(_MainTex, i.uv).rgb * exp2(_ExposureEV);
                half br = max(c.r, max(c.g, c.b));
                // Мягкое колено: у резкого порога граница ореола обводит
                // предмет ступенькой, и видно саму пороговую линию.
                half knee = max(_BloomKnee, 1e-4);
                half soft = clamp(br - _BloomThreshold + knee, 0, 2 * knee);
                soft = soft * soft / (4 * knee);
                half w = max(soft, br - _BloomThreshold) / max(br, 1e-4);
                return half4(c * w, 1);
            }
            ENDCG
        }

        // ── Пасс 2: размытие в одну ось ─────────────────────────────────────
        // Два прохода вместо одного двумерного: девять выборок вместо
        // восьмидесяти одной при том же результате.
        Pass
        {
            CGPROGRAM
            #pragma vertex vert_img
            #pragma fragment frag
            #include "UnityCG.cginc"

            sampler2D _MainTex;
            float4 _MainTex_TexelSize;
            float4 _BlurDir;      // (1,0) или (0,1)

            half4 frag(v2f_img i) : SV_Target
            {
                float2 step = _BlurDir.xy * _MainTex_TexelSize.xy;
                // Веса Гаусса: центр и четыре пары соседей.
                half3 c = tex2D(_MainTex, i.uv).rgb * 0.227027;
                c += tex2D(_MainTex, i.uv + step * 1.384615).rgb * 0.316216;
                c += tex2D(_MainTex, i.uv - step * 1.384615).rgb * 0.316216;
                c += tex2D(_MainTex, i.uv + step * 3.230769).rgb * 0.070270;
                c += tex2D(_MainTex, i.uv - step * 3.230769).rgb * 0.070270;
                return half4(c, 1);
            }
            ENDCG
        }
    }
    FallBack Off
}
