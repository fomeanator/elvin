// Ветер — ВЕРШИННЫМ шейдером, а не поворотом объектов.
//
// Почему так, а не «крутить трансформы»: смещение считает GPU, по вершине, и
// для процессора это бесплатно — качаться могут сотни деревьев и тысячи
// травинок. Поворот объекта целиком, кроме цены на CPU, выглядит иначе: дерево
// наклоняется доской, тогда как настоящее гнётся тем сильнее, чем выше от
// корня. Здесь именно так: у основания смещение нулевое и растёт квадратично к
// верхушке.
//
// Фаза берётся из МИРОВОЙ позиции — тогда по роще идёт волна, а не строевое
// покачивание в такт. Это самое заметное отличие живого леса от анимации.
//
// addshadow: тень качается вместе с кроной. Без него дерево гнётся, а его тень
// стоит — глаз ловит это мгновенно, даже не понимая, что именно не так.
Shader "Lvn/Wind"
{
    Properties
    {
        _Color ("Цвет", Color) = (1,1,1,1)
        _MainTex ("Текстура", 2D) = "white" {}
        _Wind ("Сила ветра (м)", Range(0, 1)) = 0.12
        _Speed ("Скорость", Range(0, 6)) = 1.2
        _Turbulence ("Порывистость", Range(0, 1)) = 0.35
        // Ноль по умолчанию: сплошной примитив (конус-ёлка) ничего не режет,
        // а порог поднимает конвертер там, где у оригинала была прозрачность.
        _Cutoff ("Отсечение прозрачного", Range(0, 1)) = 0
        // Ноль — рисуем ОБЕ стороны, и для растительности это не выбор, а
        // единственный правильный режим. Лист плоский: у каждого второго в
        // кроне мы видим изнанку, а односторонний рендер вместо неё оставляет
        // чёрную дыру. Именно так рассыпался жёлтый цветок в поле — не сборка
        // модели была кривой, а половина её граней просто не рисовалась.
        [Enum(UnityEngine.Rendering.CullMode)] _Cull ("Отсечение граней", Float) = 0
        _VertexAO ("Затенение из вершин", Range(0, 1)) = 0
        _RootShade ("Затенение у комля", Range(0, 1)) = 0.35
        _Detail ("Трепет краёв", Range(0, 0.5)) = 0.04
        // Рост растения в метрах: по нему считается доля высоты вершины.
        _PlantHeight ("Рост, м", Float) = 1
        _Through ("Просвет на солнце", Range(0, 2)) = 0.5
        _ThroughColor ("Цвет просвета", Color) = (0.55, 0.85, 0.35, 1)
    }
    SubShader
    {
        Tags { "RenderType" = "Opaque" "Queue" = "Geometry" }
        LOD 200

        // Лист плоский — видна и его изнанка.
        Cull [_Cull]
        // Край выреза по прозрачности — ступенькой. Пока кадр снимается с
        // многосэмпловым сглаживанием, эту ступеньку можно сгладить даром:
        // доля прозрачности превращается в долю закрытых сэмплов.
        AlphaToMask On

        CGPROGRAM
        // noambient: рассеянный свет — свой, с учётом затенения кроны.
        #pragma surface surf Foliage vertex:vert addshadow noambient
        #pragma target 3.0

        sampler2D _MainTex;
        fixed4 _Color, _ThroughColor;
        half _Wind, _Speed, _Turbulence, _Through, _Cutoff, _VertexAO, _RootShade, _Detail;
        half _PlantHeight;

        half3 HemiAmbient(half3 n)
        {
            half u = n.y;
            return u > 0
                ? lerp(unity_AmbientEquator.rgb, unity_AmbientSky.rgb, u)
                : lerp(unity_AmbientEquator.rgb, unity_AmbientGround.rgb, -u);
        }


        // ── АЛГОРИТМ CRYSIS (GPU Gems 3, глава 16) ──────────────────────────
        //
        // Движение растительности там разложено на ДВА независимых слоя, и это
        // главное, что отличает живое качание от колыхания занавески:
        //
        //   · главный изгиб — весь куст клонится по ветру целиком, тем сильнее,
        //     чем выше вершина;
        //   · детальный — края листьев трепещут сами по себе, каждый в своей
        //     фазе, независимо от того, гнётся ли куст в эту секунду.
        //
        // Второй слой и создаёт впечатление, что ветер настоящий: без него
        // растение движется как единый кусок резины.

        // Треугольная волна вместо синуса: она дешевле и, что важнее, у неё
        // РОВНЫЕ участки между пиками — движение получается с паузами, как у
        // настоящего порыва, а не бесконечно плавным.
        float4 TriangleWave(float4 x)
        {
            return abs(frac(x + 0.5) * 2.0 - 1.0);
        }

        // Сглаживание углов треугольной волны: излом на пике читается рывком.
        float4 SmoothCurve(float4 x)
        {
            return x * x * (3.0 - 2.0 * x);
        }

        float4 SmoothTriangleWave(float4 x)
        {
            return SmoothCurve(TriangleWave(x));
        }

        // ЧЕТЫРЕ волны разной частоты — числа взяты из статьи Crytek. Они
        // подобраны несоизмеримыми: сумма таких волн не повторяется на слух и
        // на глаз, и роща не «дышит» в такт.
        static const float4 DetailFreq = float4(1.975, 0.793, 0.375, 0.193);

        // ПРОСВЕТ. Лист на солнце светится НАСКВОЗЬ — свет проходит сквозь него
        // и подсвечивает с обратной стороны. Без этого крона читается пластиком,
        // сколько её ни качай. Честное подповерхностное рассеяние здесь не
        // нужно: достаточно добавить свет там, где источник ЗА поверхностью.
        half4 LightingFoliage(SurfaceOutput s, half3 lightDir, half3 viewDir, half atten)
        {
            half ndl = saturate(dot(s.Normal, lightDir));
            half back = saturate(dot(viewDir, -lightDir));   // солнце за листвой

            // ТОЛЩИНА. Настоящий лист светится насквозь неравномерно: у черенка
            // он плотный, к краю сходит на нет — и просвечивает край сильнее.
            // Ровный просвет по всей карточке выдаёт подделку мгновенно: трава
            // начинает светиться целиком, как неоновая.
            //
            // Толщину передаём через s.Gloss: модель освещения не видит Input,
            // а заводить ради одного числа собственную структуру дороже, чем
            // занять поле, которым стилизованный свет всё равно не пользуется.
            half thin = s.Gloss;                 // 0 у основания, 1 у кончика
            half through = pow(back, 3) * _Through * lerp(0.25, 1.0, thin);

            // Просвет сильнее, когда лист повёрнут к нам РЕБРОМ: тогда путь
            // света сквозь него короче. Это же убирает свечение у листьев,
            // прямо обращённых к солнцу, — там просвечивать нечему.
            through *= lerp(1.0, 0.35, ndl);

            half4 c;
            c.rgb = s.Albedo * _LightColor0.rgb * (ndl * atten)
                  + _ThroughColor.rgb * s.Albedo * through * atten;
            c.a = s.Alpha;
            return c;
        }

        struct Input
        {
            float2 uv_MainTex;
            float3 worldNormal;
            float4 color : COLOR;
            half height;        // доля высоты: 0 у комля, 1 у кончика
        };

        void vert(inout appdata_full v, out Input o)
        {
            UNITY_INITIALIZE_OUTPUT(Input, o);

            // ДОЛЯ высоты, а не метры. Раньше здесь стояло saturate(y), то
            // есть высота бралась как есть: у нашего примитива она и правда
            // равна доле (он единичный), но у настоящего растения — нет.
            // Трава в сорок пять сантиметров давала h = 0.45, изгиб при этом
            // квадратичный — значит качалась она вчетверо слабее дерева, и на
            // глаз выглядело так, будто часть поля шевелится, а часть стоит
            // мёртво. Делим на собственный рост: теперь и травинка, и дуб
            // гнутся одинаково относительно себя.
            half h = saturate(v.vertex.y / max(_PlantHeight, 0.01));
            o.height = h;

            float3 world = mul(unity_ObjectToWorld, v.vertex).xyz;
            half t = _Time.y * _Speed;

            // Фаза ОБЪЕКТА — из его положения в мире: соседние кусты качаются
            // вразнобой, и по роще идёт волна вместо строевого покачивания.
            half objPhase = dot(unity_ObjectToWorld._m03_m13_m23, 1.0);
            // Фаза ВЕРШИНЫ. У Crytek она красится художником в зелёный канал
            // вершинного цвета; у наших моделей его нет, поэтому берём фазу из
            // самой геометрии — соседние листья всё равно окажутся в разных
            // фазах, а это единственное, что от неё требуется.
            half vtxPhase = dot(v.vertex.xyz, 1.0);
            // Красный канал — жёсткость КРАЁВ, синий — жёсткость листвы целиком.
            // При белом цвете (модель без раскраски) выходит «мягкие края,
            // обычная листва» — разумное умолчание.
            half edgeStiff = v.color.r;
            half leafStiff = v.color.b;

            // ── ДЕТАЛЬНЫЙ ИЗГИБ ────────────────────────────────────────────
            float2 wavesIn = t + float2(vtxPhase, objPhase);
            float4 waves = SmoothTriangleWave(wavesIn.xxyy * DetailFreq);
            half edgeFlutter = waves.x + waves.z;      // дрожание края листа
            half leafBend    = waves.y + waves.w;      // покачивание всего листа

            float3 wn = normalize(mul((float3x3)unity_ObjectToWorld, v.normal));
            // Края треплет ПОПЕРЁК плоскости листа — вдоль его нормали. Именно
            // это движение читается «шелестом», а не смещением всей ветки.
            // Трепет краёв НЕ зависит от высоты. Ветер шевелит край листа
            // одинаково — и у макушки дерева, и у розетки, лежащей на земле.
            // Пока он был умножен на долю высоты, низкие растения (газания,
            // подорожник, всё стелющееся) стояли мёртво рядом с качающейся
            // травой: в кадре это читалось как «часть шевелится, часть нет».
            v.vertex.xyz += wn * edgeFlutter * edgeStiff * _Detail;
            // А вот покачивание листа целиком высоту учитывает — но мягко.
            v.vertex.y += leafBend * leafStiff * _Detail * 0.4 * (0.3 + 0.7 * h);

            // ── ГЛАВНЫЙ ИЗГИБ ──────────────────────────────────────────────
            half phase = world.x * 0.35 + world.z * 0.27;
            half swayX = sin(t + phase) + _Turbulence * sin(t * 2.7 + phase * 1.9);
            half swayZ = cos(t * 0.8 + phase * 1.3) + _Turbulence * cos(t * 2.1 + phase * 2.3);
            // Изгиб растёт к макушке, но НЕ обнуляется у земли: комель
            // настоящего стебля тоже ходит, просто меньше. Чистый квадрат
            // делал нижнюю треть неподвижной, и низкие растения оказывались
            // целиком в этой мёртвой зоне.
            half bend = h * (0.3 + 0.7 * h);

            float3 bent = v.vertex.xyz;
            bent.x += swayX * _Wind * bend;
            bent.z += swayZ * _Wind * bend * 0.7;

            // СОХРАНЕНИЕ ДЛИНЫ — приём, ради которого всё и переписано.
            // Простое смещение вершины по ветру РАСТЯГИВАЕТ ветку: чем сильнее
            // ветер, тем длиннее становится дерево, и на порыве оно заметно
            // раздувается. Возвращая вершину на исходное расстояние от центра,
            // мы превращаем растяжение в поворот — ветка не удлиняется, а
            // клонится, как настоящая.
            float len = length(v.vertex.xyz);
            if (len > 1e-4)
                v.vertex.xyz = normalize(bent) * len;
            else
                v.vertex.xyz = bent;
        }

        void surf(Input IN, inout SurfaceOutput o)
        {
            fixed4 c = tex2D(_MainTex, IN.uv_MainTex) * _Color;
            // Порог был объявлен, но не применялся — и крона из плоскостей с
            // прозрачной текстурой рисовалась сплошными квадратами. Ноль по
            // умолчанию: наши примитивы (конус-ёлка) непрозрачны и не платят.
            clip(c.a - _Cutoff);
            o.Albedo = c.rgb;
            o.Alpha = c.a;

            // Внутри кроны света меньше, чем снаружи, — без этого крона
            // читается плоским пятном, сколько её ни качай.
                        // ТОЛЬКО В ОСНОВНОМ ПРОХОДЕ. Поверхностный шейдер вызывается по
            // разу на КАЖДЫЙ источник света, и всё, что попадает в Emission,
            // складывается столько раз, сколько в сцене ламп. Замерили: три
            // лампы в стороне поднимали яркость дальнего фона на 30 из 255 —
            // фон светлел от источников, которые светят в другую сторону.
            //
            // Рассеянный свет и контровой ободок к источникам отношения не
            // имеют: они существуют один раз на пиксель.
            #ifndef UNITY_PASS_FORWARDADD
    half ao = lerp(1.0, IN.color.a, _VertexAO);
                o.Emission = HemiAmbient(IN.worldNormal) * o.Albedo * ao;
            #endif

        }
        ENDCG
    }
    FallBack "Diffuse"
}
