{
  "id": "choice-timeout",
  "title": "A timed choice surfaces its countdown and expiring takes timeout_goto",
  "why": "The timeout seconds must reach the presentation layer (otherwise no countdown can be drawn) and expiry must route to timeout_goto rather than to the first option.",
  "runtimes": ["csharp"],
  "picks": [{ "timeout": true }],
  "doc": {
    "scene": "conformance",
    "script": [
      { "op": "say", "text": "Быстро!" },
      { "op": "choice", "timeout": 3, "timeout_goto": "late", "options": [
        { "text": "Успеть", "goto": "fast" }
      ] },
      { "op": "label", "id": "fast" },
      { "op": "say", "text": "Успел." },
      { "op": "goto", "label": "__end" },
      { "op": "label", "id": "late" },
      { "op": "say", "text": "Не успел." }
    ]
  },
  "expect": {
    "stops": [
      { "say": "Быстро!" },
      { "choice": { "options": ["Успеть"], "timeout": 3 } },
      { "say": "Не успел." },
      { "end": true }
    ]
  }
}
