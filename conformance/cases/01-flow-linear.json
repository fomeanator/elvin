{
  "id": "flow-linear",
  "title": "A linear script shows every line in order and then ends",
  "why": "The floor of the contract: the cursor walks forward, one pause per say, and the end is signalled exactly once.",
  "runtimes": [
    "csharp",
    "js"
  ],
  "doc": {
    "scene": "conformance",
    "script": [
      {
        "op": "say",
        "text": "Первая строка."
      },
      {
        "op": "say",
        "who": "Аня",
        "text": "Вторая строка."
      }
    ]
  },
  "expect": {
    "stops": [
      {
        "say": "Первая строка."
      },
      {
        "say": {
          "who": "Аня",
          "text": "Вторая строка."
        }
      },
      {
        "end": true
      }
    ]
  }
}
