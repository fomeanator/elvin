// ════════ WHAT A BUNDLE IMPORT ACTUALLY EMITS — one beat, annotated ════════
//
// This file is NOT hand-written. Every line below is produced by the articy
// bundle importer's post-pass (tools/lvnconv/importer/bundle_wire.go) from an
// articy chapter that contained a hand-built "choose your dress" picker. It is
// committed so an author can RECOGNISE the shapes before meeting them in a
// 3000-line chapter, and it is regenerated by a test — if the importer ever
// emits something else, the test fails and this file is refreshed.
//
// The articy source for this beat, roughly:
//
//     bg Двор  ·  set Music.Calm=true
//     Главный герой: Пора одеваться.
//     Felix: Ты опоздаешь.
//     set Open.Wardrobe = true            ← the marker that opens the block
//       Главный герой: Что надеть?
//       - Платье  -> set Wardrobe.mainCh_Clothes = 1
//       - Костюм  -> set Wardrobe.mainCh_Clothes = 2
//     set Open.Wardrobe = false           ← and the marker that closes it
//     set Sound.Door=true
//     Главный герой: Готова.
//
// Line by line, what the importer did (howto/import-articy/README.md § "Read
// the output" explains each one, and howto/wardrobe/ explains the wardrobe):
//
//   set default=true key="player"  the player-name fallback, seeded at the top of
//                                  chapter 1; the name-input screen overrides it
//   bg … sprite_url=…              the real HD background, matched by location name
//   audio … after a Music./Sound.  audio cues are variable sets in articy
//   actor … outfit="{Wardrobe.…}"  outfits follow their story variable everywhere
//   actor … mirror="true"          the protagonist faces into the scene
//   {player}: …                    the protagonist speaks under the player's name
//   actor … + wardrobe_show        the hand-built picker, replaced by the real
//                                  wardrobe sheet; the Open.Wardrobe markers stay

scene ch01

set default=true key="player" value="Мира"
bg id="Двор" sprite_url="/content/bg/Demo_yard.png"
set key="Music.Calm" value=true
audio action="play" channel="music" url="/content/audio/music/Calm.ogg"
actor id="Главный_герой" mirror="true" outfit="{Wardrobe.mainCh_Clothes}" position="left" show=true
{player}: Пора одеваться.
actor emotion="idle" id="Felix" outfit="{Wardrobe.Felix}" position="right" show=true
Felix: Ты опоздаешь.
set key="Open.Wardrobe" value=true
actor id="Главный_герой" mirror="true" outfit="{Wardrobe.mainCh_Clothes}" position="center" show=true
wardrobe_show char="Главный_герой"
set key="Open.Wardrobe" value=false
set key="Sound.Door" value=true
audio action="play" channel="sfx" url="/content/audio/sfx/Door.ogg"
{player}: Готова.
